// Configuración del cliente y conexión a Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS (Reglas de negocio y estados cerrados)
// ==========================================

enum Rol {
  COORDINADOR
  OPERADOR
}

enum EstadoOperativo {
  DISPONIBLE
  EN_TERRENO
  AUSENTE
}

enum OrigenIngesta {
  CORREO
  LLAMADA
  JEFATURA
  COORDINADOR
}

enum EstadoTicket {
  NUEVO
  EN_PROGRESO
  EN_PAUSA
  EN_ESPERA_TERCEROS
  RESUELTO // El operador terminó; el coordinador confirma con CERRADO
  CERRADO
}

enum AreaDesignada {
  GENERAL
  REDES_FTTH
  TRAFICO_INALAMBRICO
  WAN
  GRANDES_CLIENTES
  SEGURIDAD
  TELEFONIA
}

// ==========================================
// MODELOS (Tablas en la Base de Datos)
// ==========================================

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  clave            String
  nombre           String
  rol              Rol             @default(OPERADOR)
  area_designada   AreaDesignada   @default(GENERAL)
  estado_operativo EstadoOperativo @default(DISPONIBLE)
  tickets_resueltos Int            @default(0)
  
  tickets_creados   Ticket[] @relation("CreadorTicket")
  tickets_asignados Ticket[] @relation("AsignadoTicket")
  auditorias        AuditLog[]
  horario           HorarioOperador?
  guardias          GuardiaSemanal[]
  traspasos_creados Traspaso[]     @relation("TraspasosCreados")
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


model Ticket {
  id                 String        @id @default(uuid())
  codigo_incidencia  String        @unique 
  asunto             String
  descripcion        String?       @db.Text
  remitente          String?       @db.VarChar(180)
  estado_actual      EstadoTicket  @default(NUEVO)
  puntos_complejidad Int           @default(0) // Se asigna al cerrar el ticket
  origen_ingesta     OrigenIngesta @default(CORREO)
  area_designada     AreaDesignada @default(GENERAL)
  
  // Relación: Quién reportó o creó el ticket (Opcional, si viene de correo automático puede ser nulo)
  creado_por_id      String?
  creado_por         User?         @relation("CreadorTicket", fields: [creado_por_id], references: [id])
  
  // Relación: Operador encargado (Nulo si está en la cola general)
  asignado_a_id      String?
  asignado_a         User?         @relation("AsignadoTicket", fields: [asignado_a_id], references: [id])
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  resueltoEn        DateTime? // Se sella automáticamente cuando el estado pasa a "REALIZADO"
  fecha_asignacion   DateTime? 
  fecha_cierre       DateTime?

  // Borrado lógico: el ticket se conserva (auditoría y consecutivo INC-xxx) pero
  // queda fuera de listas y métricas mientras eliminado_en no sea nulo.
  eliminado_en       DateTime?
  motivo_eliminacion String?       @db.VarChar(300)

  adjuntos           Adjunto[]
  auditorias         AuditLog[]
  traspasos          TraspasoTicket[]
}

model Adjunto {
  id              String   @id @default(uuid())
  nombre_original String
  nombre_archivo  String
  ruta            String
  mimetype        String?
  peso            Int?
  ticketId        String
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

// Registro de acciones (editar, eliminar, restaurar, cerrar, traspasar...)
model AuditLog {
  id        String   @id @default(uuid())
  accion    String
  detalles  String?  @db.Text
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// Horario de turno normal de cada operador (spec §3). Sin registro = lunes a viernes 8:00-17:00.
model HorarioOperador {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dias        Int[]    // 0 = domingo ... 6 = sábado
  hora_inicio String   @default("08:00") @db.VarChar(5)
  hora_fin    String   @default("17:00") @db.VarChar(5)
  updatedAt   DateTime @updatedAt
}

// Rotación semanal de guardia: qué operadores están de guardia en cada semana (lunes a domingo, Caracas).
// semana_inicio es el instante del lunes 00:00 de Caracas.
model GuardiaSemanal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semana_inicio DateTime
  createdAt     DateTime @default(now())

  @@unique([userId, semana_inicio])
  @@index([semana_inicio])
}

// Traspaso a guardia: lote de pendientes con nota para quien está de guardia.
// No cambia el operador de los tickets; la guardia los ve en una lista aparte.
model Traspaso {
  id            String    @id @default(uuid())
  nota          String    @db.Text
  semana_inicio DateTime  // semana de guardia (lunes 00:00 Caracas) que lo recibe
  creado_por_id String?
  creado_por    User?     @relation("TraspasosCreados", fields: [creado_por_id], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  cerrado_en    DateTime? // el coordinador lo marcó como atendido
  tickets       TraspasoTicket[]

  @@index([createdAt])
}

model TraspasoTicket {
  traspasoId        String
  traspaso          Traspaso     @relation(fields: [traspasoId], references: [id], onDelete: Cascade)
  ticketId          String
  ticket            Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  estado_al_pasar   EstadoTicket // foto del momento del traspaso
  operador_al_pasar String?      @db.VarChar(120)

  @@id([traspasoId, ticketId])
  @@index([ticketId])
}
