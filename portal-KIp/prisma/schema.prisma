// Configuración del cliente y conexión a Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS (Reglas de negocio y estados cerrados)
// ==========================================

enum Rol {
  COORDINADOR
  OPERADOR
  JEFE    // jefe de área: ve y gestiona solo su área
  GERENTE // ve todas las áreas y administra usuarios, roles y áreas
}

enum EstadoOperativo {
  DISPONIBLE
  EN_TERRENO
  AUSENTE
}

enum OrigenIngesta {
  CORREO
  LLAMADA
  JEFATURA
  COORDINADOR
}

enum EstadoTicket {
  NUEVO
  EN_PROGRESO
  EN_PAUSA
  EN_ESPERA_TERCEROS
  RESUELTO // El operador terminó; el coordinador confirma con CERRADO
  CERRADO
}

// Conversación del ticket: correo del cliente, respuesta del operador o nota interna
enum TipoMensaje {
  ENTRANTE // Correo recibido del cliente
  SALIENTE // Respuesta enviada al cliente
  NOTA // Nota interna: solo la ve el equipo
}

// Las áreas viven en la tabla Area (antes eran el enum AreaDesignada)

// ==========================================
// MODELOS (Tablas en la Base de Datos)
// ==========================================

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  clave            String
  nombre           String
  rol              Rol             @default(OPERADOR)
  area_designada   String          @default("GENERAL") @db.VarChar(40)
  area             Area            @relation(fields: [area_designada], references: [codigo])
  subgrupo_id      String?         // subgrupo dentro de su área (p. ej. FTTx: Soporte o Cabecera)
  subgrupo         Subgrupo?       @relation(fields: [subgrupo_id], references: [id], onDelete: SetNull)
  activo           Boolean         @default(true) // desactivado: no entra ni recibe tickets; se conserva su historial
  estado_operativo EstadoOperativo @default(DISPONIBLE)
  atiende_tickets  Boolean         @default(false) // coordinador o jefe que también toma y trabaja tickets (Mi panel)
  telefono         String?         @db.VarChar(40) // teléfono o extensión para Contactos
  tickets_resueltos Int            @default(0)
  
  tickets_creados   Ticket[] @relation("CreadorTicket")
  tickets_asignados Ticket[] @relation("AsignadoTicket")
  auditorias        AuditLog[]
  horario           HorarioOperador?
  guardias          GuardiaSemanal[]
  guardias_dia      GuardiaDia[]
  traspasos_creados Traspaso[]     @relation("TraspasosCreados")
  mensajes          Mensaje[]      @relation("MensajesAutor")
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


model Ticket {
  id                 String        @id @default(uuid())
  codigo_incidencia  String        @unique 
  asunto             String
  descripcion        String?       @db.Text
  remitente          String?       @db.VarChar(180)
  estado_actual      EstadoTicket  @default(NUEVO)
  puntos_complejidad Int           @default(0) // Se asigna al cerrar el ticket
  origen_ingesta     OrigenIngesta @default(CORREO)
  area_designada     String        @default("GENERAL") @db.VarChar(40)
  estado_ve          String?       @db.VarChar(3) // Estado de Venezuela (VEA, VEV...); ver estadosVeService
  area               Area          @relation(fields: [area_designada], references: [codigo])
  subgrupo_id        String?
  subgrupo           Subgrupo?     @relation(fields: [subgrupo_id], references: [id], onDelete: SetNull)
  
  // Relación: Quién reportó o creó el ticket (Opcional, si viene de correo automático puede ser nulo)
  creado_por_id      String?
  creado_por         User?         @relation("CreadorTicket", fields: [creado_por_id], references: [id])
  
  // Relación: Operador encargado (Nulo si está en la cola general)
  asignado_a_id      String?
  asignado_a         User?         @relation("AsignadoTicket", fields: [asignado_a_id], references: [id])
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  resueltoEn        DateTime? // Se sella automáticamente cuando el estado pasa a "REALIZADO"
  fecha_asignacion   DateTime? 
  fecha_cierre       DateTime?

  // Borrado lógico: el ticket se conserva (auditoría y consecutivo INC-xxx) pero
  // queda fuera de listas y métricas mientras eliminado_en no sea nulo.
  eliminado_en       DateTime?
  motivo_eliminacion String?       @db.VarChar(300)

  adjuntos           Adjunto[]
  auditorias         AuditLog[]
  traspasos          TraspasoTicket[]
  mensajes           Mensaje[]
}

model Adjunto {
  id              String   @id @default(uuid())
  nombre_original String
  nombre_archivo  String
  ruta            String
  mimetype        String?
  peso            Int?
  ticketId        String
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Nulo: adjunto del correo que abrió el ticket. Con valor: adjunto de un mensaje de la conversación
  mensajeId       String?
  mensaje         Mensaje? @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

// Mensajes de la conversación del ticket. El primer correo (el que abrió el ticket)
// no se copia aquí: sale de Ticket.descripcion y Ticket.remitente.
model Mensaje {
  id         String      @id @default(uuid())
  ticketId   String
  ticket     Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tipo       TipoMensaje
  texto      String      @db.Text
  autor_id   String? // Operador que escribió (nulo en correos recibidos)
  autor      User?       @relation("MensajesAutor", fields: [autor_id], references: [id], onDelete: SetNull)
  de         String?     @db.VarChar(180) // Remitente del correo recibido
  para       String?     @db.VarChar(180) // Destinatario de la respuesta
  enviado    Boolean     @default(false) // SALIENTE: true si el correo salió por Graph
  adjuntos   Adjunto[]
  createdAt  DateTime    @default(now())

  @@index([ticketId, createdAt])
}

// Registro de acciones (editar, eliminar, restaurar, cerrar, traspasar...)
model AuditLog {
  id        String   @id @default(uuid())
  accion    String
  detalles  String?  @db.Text
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// Horario de turno normal de cada operador (spec §3). Sin registro = lunes a viernes 8:00-17:00.
model HorarioOperador {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dias        Int[]    // 0 = domingo ... 6 = sábado
  hora_inicio String   @default("08:00") @db.VarChar(5)
  hora_fin    String   @default("17:00") @db.VarChar(5)
  updatedAt   DateTime @updatedAt
}

// Rotación semanal de guardia: qué operadores están de guardia en cada semana (lunes a domingo, Caracas).
// semana_inicio es el instante del lunes 00:00 de Caracas.
// Guardia por día: quién está de guardia cada fecha (Caracas). Entre semana
// 17:00–24:00 en la oficina; sábado y domingo 08:00–24:00 desde casa.
model GuardiaDia {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fecha     DateTime // 00:00 de Caracas de ese día
  createdAt DateTime @default(now())

  @@unique([userId, fecha])
  @@index([fecha])
}

// Histórico: la guardia por semana completa ya no se usa (se copió a GuardiaDia)
model GuardiaSemanal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semana_inicio DateTime
  createdAt     DateTime @default(now())

  @@unique([userId, semana_inicio])
  @@index([semana_inicio])
}

// Traspaso a guardia: lote de pendientes con nota para quien está de guardia.
// No cambia el operador de los tickets; la guardia los ve en una lista aparte.
model Traspaso {
  id            String    @id @default(uuid())
  nota          String    @db.Text
  semana_inicio DateTime  // semana de guardia (lunes 00:00 Caracas) que lo recibe
  creado_por_id String?
  creado_por    User?     @relation("TraspasosCreados", fields: [creado_por_id], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  cerrado_en    DateTime? // el coordinador lo marcó como atendido
  tickets       TraspasoTicket[]

  @@index([createdAt])
}

model TraspasoTicket {
  traspasoId        String
  traspaso          Traspaso     @relation(fields: [traspasoId], references: [id], onDelete: Cascade)
  ticketId          String
  ticket            Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  estado_al_pasar   EstadoTicket // foto del momento del traspaso
  operador_al_pasar String?      @db.VarChar(120)

  @@id([traspasoId, ticketId])
  @@index([ticketId])
}

// Configuración de Administración (reglas, avisos y plantillas). Una fila por
// clave con su valor en JSON; los valores por defecto viven en el código.
model Configuracion {
  clave     String   @id @db.VarChar(40) // 'reglas' | 'avisos' | 'plantillas'
  valor     Json
  updatedAt DateTime @updatedAt
}

// Áreas del departamento (Administración las crea, renombra y desactiva; no se borran)
model Area {
  codigo    String   @id @db.VarChar(40) // 'WAN', 'REDES_FTTH'… no cambia una vez creada
  nombre    String   @db.VarChar(60)
  activa    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  usuarios  User[]
  tickets   Ticket[]
  subgrupos Subgrupo[]
}

// Subgrupo de un área (FTTx: Soporte y Cabecera). Se desactiva, no se borra.
model Subgrupo {
  id          String   @id @default(uuid())
  area_codigo String   @db.VarChar(40)
  area        Area     @relation(fields: [area_codigo], references: [codigo])
  nombre      String   @db.VarChar(60)
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  usuarios    User[]
  tickets     Ticket[]

  @@unique([area_codigo, nombre])
}
