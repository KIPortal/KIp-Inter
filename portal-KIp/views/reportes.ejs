<%
	// Reportes (prototipo docs/rediseno/prototipo/Reportes.dc.html).
	// Solo dibuja lo que entrega reportViewService.buildReportView (mismo reporte que el Excel).
	const v = vista;
	const k = v.kpis;
	const coma = n => String(n).replace('.', ',');
	const h = n => (n === null || n === undefined ? '—' : coma(n) + ' h');
	const p = n => (n === null || n === undefined ? '—' : n + '%');
	const qs = cambios => {
		const o = Object.assign({ periodo: v.periodo, fecha: v.fecha, area: v.area }, cambios);
		const s = Object.keys(o).filter(x => o[x]).map(x => x + '=' + encodeURIComponent(o[x])).join('&');
		return s ? '?' + s : '';
	};
	const PERIODOS = [['jornada', 'Jornada'], ['semana', 'Semana'], ['mes', 'Mes']];
	const indice = o => (o.indiceCarga === null ? '—' : coma(Math.round(o.indiceCarga * 10) / 10));
	const datos = { operadores: v.operadores };
%>
<!DOCTYPE html>
<html lang="es">
<head>
	<%- include('partials/head', { titulo: 'Reportes' }) %>
</head>
<body data-vivo>
<div class="app">
	<%- include('partials/sidebar', { currentUser, activo: 'reportes', conteos: { tickets: activos } }) %>

	<main class="app-main">
		<header class="toolbar">
			<div style="display:flex;flex-direction:column;margin-right:6px">
				<h1>Reportes</h1>
				<span class="sub"><%= v.rango %><%= v.areaNombre ? ' · ' + v.areaNombre : '' %></span>
			</div>
			<span class="grow"></span>
			<div role="tablist" aria-label="Periodo" id="periodoSelect">
				<% PERIODOS.forEach(([valor, etiqueta]) => { %>
					<a role="tab" href="/reportes<%= qs({ periodo: valor, fecha: null }) %>" data-value="<%= valor %>" aria-selected="<%= v.periodo === valor && !v.fecha %>"><%= etiqueta %></a>
				<% }) %>
			</div>
			<form class="pill datepick" method="get" action="/reportes" title="Fecha específica">
				<label class="sr-only" for="fecha">Fecha específica</label>
				<input type="hidden" name="periodo" value="<%= v.periodo %>">
				<% if (v.area) { %><input type="hidden" name="area" value="<%= v.area %>"><% } %>
				<input id="fecha" class="field sm" type="date" name="fecha" value="<%= v.fecha || '' %>" data-fecha aria-label="Fecha específica">
			</form>
			<div class="pill weeknav">
				<a class="pillbtn" href="/reportes<%= qs({ fecha: v.nav.anterior }) %>" aria-label="Periodo anterior" title="Periodo anterior"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></a>
				<span><%= v.etiqueta %></span>
				<% if (v.nav.siguiente) { %>
					<a class="pillbtn" href="/reportes<%= qs({ fecha: v.nav.siguiente }) %>" aria-label="Periodo siguiente" title="Periodo siguiente"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
				<% } else { %>
					<span class="pillbtn off" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></span>
				<% } %>
			</div>
			<%- include('partials/popup', { etiqueta: 'Área', porDefecto: !v.area, opciones: [{ etiqueta: 'Todas', href: '/reportes' + qs({ area: null }), sel: !v.area }].concat(areasCatalogo.map(a => ({ etiqueta: a.nombre, href: '/reportes' + qs({ area: a.codigo }), sel: v.area === a.codigo }))) }) %>
			<a class="export-btn" id="btnDescargarExcel" href="/reportes/excel<%= qs({}) %>" download>Descargar Excel
				<span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg></span>
			</a>
		</header>

		<% const f = v.fuente; %>
		<div class="registro-bar" data-registro data-dia="<%= f.dia || '' %>" data-guardado="<%= f.guardado %>" data-faltan="<%= f.faltan.join(',') %>" style="display:flex;align-items:center;flex-wrap:wrap;gap:8px">
			<span class="badge <%= f.tipo === 'registro' ? 'green' : 'accent' %>" data-fuente="<%= f.tipo %>"><span class="dot" aria-hidden="true"></span><%= f.texto %></span>
			<% if (f.excel) { %><a class="chip" href="<%= f.excel %>" download>Excel guardado</a><% } %>
			<% if (f.dia) { %><button type="button" class="chip" data-cerrar-jornada><%= f.guardado ? 'Volver a guardar jornada' : 'Guardar jornada' %></button><% } %>
			<% if (!f.dia && f.faltan.length) { %><button type="button" class="chip" data-registrar-faltan>Registrar días faltantes</button><% } %>
			<span class="hint" data-registro-msg role="status"></span>
		</div>

		<div role="tablist" aria-label="Secciones del reporte" style="align-self:flex-start">
			<button type="button" role="tab" data-tab="resumen" aria-selected="true">Resumen</button>
			<button type="button" role="tab" data-tab="area" aria-selected="false">Por área</button>
			<button type="button" role="tab" data-tab="op" aria-selected="false">Por operador</button>
			<button type="button" role="tab" data-tab="casos" aria-selected="false">Casos comunes</button>
		</div>

		<!-- Resumen -->
		<div data-section="resumen" style="display:flex;flex-direction:column;gap:16px">
			<section class="kpis" aria-label="Totales del periodo">
				<div class="bento">
					<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7l9-4 9 4-9 4zM3 12l9 4 9-4M3 17l9 4 9-4"/></svg>
					<div><span class="kv count" style="--n: <%= k.casos %>" aria-label="<%= k.casos %>"></span><p class="bt">Casos recibidos en el <span class="t-accent">periodo</span></p></div>
				</div>
				<div class="bento">
					<svg class="green" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
					<div><span class="kv count" style="--n: <%= k.resueltos %>" aria-label="<%= k.resueltos %>"></span><p class="bt">Resueltos<% if (k.pctResueltos !== null) { %> · <span class="<%= k.pctBajoMeta ? 't-orange' : 't-green' %>"><%= k.pctResueltos %>%</span><% } %></p></div>
				</div>
				<div class="bento">
					<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
					<div><span class="kv<%= k.promSobreMeta ? ' t-orange' : '' %>"><%= h(k.promedioHoras) %></span><p class="bt">Resolución promedio<% if (k.promedioHorarioHoras !== null) { %> · <span class="t-accent"><%= h(k.promedioHorarioHoras) %> en horario</span><% } %></p></div>
				</div>
				<div class="bento">
					<svg class="red" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V14M10 20V9M16 20V4M22 20H2"/></svg>
					<div><span class="kv count" style="--n: <%= k.puntos %>" aria-label="<%= k.puntos %>"></span><p class="bt">Puntos resueltos · <span class="<%= k.areasSobrecarga ? 't-orange' : 't2' %>"><%= k.areasSobrecarga %> <%= k.areasSobrecarga === 1 ? 'área' : 'áreas' %> con sobrecarga</span></p></div>
				</div>
			</section>

			<section class="glass card" aria-labelledby="h-areas" style="gap:8px">
				<div class="card-head"><h2 id="h-areas" style="flex:1">Casos por área</h2><span class="hint">Pulsa un área para ver a sus operadores</span></div>
				<div class="scroll-x">
					<table class="rank-table rep-table" style="min-width:760px">
						<thead><tr><th style="width:170px">Área</th><th>Casos</th><th class="r" style="width:80px">Resueltos</th><th class="r" style="width:64px" title="Resueltos ÷ recibidos en el periodo (máx. 100 %) · meta <%= v.metas.resueltoPct %> %">%</th><th class="r" style="width:76px" title="Meta <%= coma(v.metas.promedioHoras) %> h">Prom.</th><th style="width:200px;padding-left:16px" title="Tickets activos ahora; el color sigue la regla de sobrecarga">Carga ahora</th><th class="r" style="width:90px">Operadores</th></tr></thead>
						<tbody>
							<% v.areas.forEach((a, i) => { %>
								<tr class="rowbtn" data-area-open="<%= a.codigo %>" tabindex="0">
									<td style="font-weight:600"><%= a.nombre %></td>
									<td><div style="display:flex;align-items:center;gap:10px"><span style="width:34px;font-weight:600"><%= a.casos %></span><div class="track" style="flex:1"><span class="bar-fill bg-blue" style="width:<%= a.ancho %>%;animation-delay:<%= i * 60 %>ms"></span></div></div></td>
									<td class="r"><%= a.resueltos %></td>
									<td class="r <%= a.pct === null ? '' : a.pctBajoMeta ? 't-orange' : 't-green' %>" style="font-weight:600"><%= p(a.pct) %></td>
									<td class="r<%= a.promSobreMeta ? ' t-orange' : '' %>"><%= h(a.promedioHoras) %></td>
									<td style="padding-left:16px" title="<%= a.estadoCarga %>"><div style="display:flex;align-items:center;gap:10px"><div class="track" style="flex:1"><span class="bar-fill bg-<%= a.cargaTono %>" style="width:<%= a.cargaAncho %>%;animation-delay:<%= i * 60 %>ms"></span></div><b class="<%= a.cargaTono === 'red' ? 't-red' : a.cargaTono === 'gray' ? 't3' : '' %>" style="width:84px;font-variant-numeric:tabular-nums"><%= a.activos %> <span class="t2" style="font-weight:500"><%= a.activos === 1 ? 'activo' : 'activos' %></span></b></div></td>
									<td class="r t2"><%= a.operadores %></td>
								</tr>
							<% }) %>
						</tbody>
						<tfoot><tr style="font-weight:700"><td>Total</td><td><%= k.casos %></td><td class="r"><%= k.resueltos %></td><td class="r<%= k.pctBajoMeta ? ' t-orange' : '' %>"><%= p(k.pctResueltos) %></td><td class="r<%= k.promSobreMeta ? ' t-orange' : '' %>"><%= h(k.promedioHoras) %></td><td style="padding-left:16px"><%= k.activos %> activos<% if (k.areasSobrecarga) { %> · <span class="t-red"><%= k.areasSobrecarga %> con sobrecarga</span><% } %></td><td class="r"><%= v.operadores.length %></td></tr></tfoot>
					</table>
				</div>
			</section>

			<div class="duo">
				<section class="glass card" aria-labelledby="h-top" style="gap:8px">
					<h2 id="h-top" class="card-title">Más casos resueltos</h2>
					<% if (!v.topResueltos.length) { %><p class="empty">Nadie resolvió tickets en este periodo.</p><% } %>
					<% const maxR = Math.max(1, ...v.topResueltos.map(o => o.resueltos)); v.topResueltos.forEach((o, i) => { %>
						<div class="toprow"><span class="pos"><%= i + 1 %></span><div class="nm"><b><%= o.nombre %></b><span><%= o.areaNombre %></span></div><div class="track"><span class="bar-fill bg-green" style="width:<%= Math.round(o.resueltos / maxR * 100) %>%;animation-delay:<%= i * 60 %>ms"></span></div><strong><%= o.resueltos %></strong></div>
					<% }) %>
				</section>
				<section class="glass card" aria-labelledby="h-carga" style="gap:8px">
					<h2 id="h-carga" class="card-title">Mayor carga ahora</h2>
					<% if (!v.topCarga.length) { %><p class="empty">No hay operadores con carga comparable ahora.</p><% } %>
					<% const maxI = Math.max(2, ...v.topCarga.map(o => o.indiceCarga)); v.topCarga.forEach((o, i) => { %>
						<div class="toprow"><span class="pos"><%= i + 1 %></span><div class="nm"><b><%= o.nombre %></b><span><%= o.areaNombre %> · <%= o.activos %> activos</span></div><div class="track"><span class="bar-fill <%= o.sobrecarga ? 'bg-red' : 'bg-blue' %>" style="width:<%= Math.round(o.indiceCarga / maxI * 100) %>%;animation-delay:<%= i * 60 %>ms"></span></div><strong class="<%= o.sobrecarga ? 't-red' : '' %>"><%= indice(o) %></strong></div>
					<% }) %>
				</section>
			</div>

			<section class="glass card" aria-labelledby="h-lect" style="gap:8px">
				<h2 id="h-lect" class="card-title">Lecturas clave</h2>
				<ul class="lecturas"><% v.lecturas.forEach(l => { %><li><%= l %></li><% }) %></ul>
			</section>
		</div>

		<!-- Por área -->
		<section data-section="area" hidden class="areacards" aria-label="Áreas">
			<% v.areas.forEach(a => { %>
				<button type="button" class="glass acard" data-area-open="<%= a.codigo %>" aria-label="Ver operadores de <%= a.nombre %>">
					<span class="ac-head"><b><%= a.nombre %></b><span class="t2"><%= a.operadores %> <%= a.operadores === 1 ? 'operador' : 'operadores' %></span></span>
					<span class="ac-stats">
						<span><span class="kv"><%= a.casos %></span><small>casos</small></span>
						<span><span class="kv t-green"><%= p(a.pct) %></span><small>resueltos</small></span>
						<span><span class="kv"><%= h(a.promedioHoras) %></span><small>promedio</small></span>
					</span>
					<span class="ac-foot"><span>Carga ahora</span><span class="act"><i style="background:<%= a.estadoCarga === 'Sobrecarga' ? 'var(--c-red)' : a.estadoCarga === 'Normal' ? 'var(--c-green)' : 'var(--t3)' %>"></i><%= a.estadoCarga %> · <%= a.activos %> activos</span></span>
				</button>
			<% }) %>
		</section>

		<!-- Por operador -->
		<section data-section="op" hidden class="glass" aria-labelledby="h-ops" style="display:flex;flex-direction:column;min-width:0;overflow:hidden">
			<div class="card-head" style="padding:20px 24px 12px">
				<div style="display:flex;flex-direction:column;flex:1;min-width:220px"><h2 id="h-ops">Rendimiento por operador</h2><span class="hint" data-op-summary></span></div>
				<button type="button" class="chip" data-op-clear hidden><span data-op-area></span><span aria-hidden="true">✕</span></button>
				<div role="tablist" class="sm" aria-label="Ordenar">
					<button type="button" role="tab" data-sort="puntos" aria-selected="true">Más puntos</button>
					<button type="button" role="tab" data-sort="resueltos" aria-selected="false">Más resueltos</button>
					<button type="button" role="tab" data-sort="casos" aria-selected="false">Más casos</button>
					<button type="button" role="tab" data-sort="carga" aria-selected="false">Más carga</button>
				</div>
			</div>
			<div class="scroll-x">
				<table class="rank-table rep-table" style="min-width:900px">
					<thead><tr><th style="padding-left:24px;width:32px">#</th><th>Operador</th><th class="r" style="width:70px">Casos</th><th class="r" style="width:80px">Resueltos</th><th class="r" style="width:60px">%</th><th class="r" style="width:70px">Prom.</th><th class="r" style="width:130px" title="Resueltos por nivel de dificultad (N1=2, N2=4, N3=8, N4=10 pts)">N1 / N2 / N3 / N4</th><th class="r" style="width:90px" title="Puntos activos ÷ promedio de su área, ahora">Índice de carga</th><th class="r" style="width:70px;padding-right:24px">Puntos</th></tr></thead>
					<tbody data-op-rows>
						<% v.operadores.forEach(o => { %>
							<tr data-op data-area="<%= o.area %>" data-puntos="<%= o.puntos %>" data-resueltos="<%= o.resueltos %>" data-casos="<%= o.casos %>" data-carga="<%= o.indiceCarga === null ? -1 : o.indiceCarga %>">
								<td class="t2" style="padding-left:24px;font-weight:700" data-pos></td>
								<td><span style="display:flex;align-items:center;gap:10px"><span class="avatar"><%= o.iniciales %></span><span style="display:flex;flex-direction:column"><b><%= o.nombre %></b><span class="t2"><%= o.areaNombre %></span></span></span></td>
								<td class="r" style="font-weight:600"><%= o.casos %></td>
								<td class="r"><%= o.resueltos %></td>
								<td class="r <%= o.pct === null ? 't2' : o.pctBajoMeta ? 't-orange' : 't-green' %>"><%= p(o.pct) %></td>
								<td class="r<%= o.promSobreMeta ? ' t-orange' : '' %>"><%= h(o.promedioHoras) %></td>
								<td class="r t2"><%= o.niveles ? o.niveles.join(' / ') : '—' %></td>
								<td class="r"><span class="ix<%= o.sobrecarga ? ' over' : '' %>"><%= indice(o) %></span></td>
								<td class="r" style="padding-right:24px;font-weight:700"><%= o.puntos %></td>
							</tr>
						<% }) %>
					</tbody>
				</table>
				<% if (!v.operadores.length) { %><p class="empty" style="padding:16px 24px">No hay operadores registrados.</p><% } %>
			</div>
			<div class="t2" style="padding:12px 24px 16px;font-size:12px">Casos = asignados en el periodo · Puntos por nivel de dificultad del caso: N1 = 2, N2 = 4, N3 = 8, N4 = 10 · P1 / P2 / P3 = prioridad (urgencia) · Índice de carga: puntos activos ahora ÷ promedio de puntos de su área</div>
		</section>

		<!-- Casos comunes: ocurrencia por tipo de caso y tiempo real frente al estimado -->
		<% const cc = v.casos; %>
		<section data-section="casos" hidden class="glass" aria-labelledby="h-casos" style="display:flex;flex-direction:column;min-width:0;overflow:hidden">
			<div class="card-head" style="padding:20px 24px 12px">
				<div style="display:flex;flex-direction:column;flex:1;min-width:220px"><h2 id="h-casos">Casos comunes</h2>
					<span class="hint"><%= cc.clasificados %> de <%= cc.recibidos %> casos recibidos con tipo<%= cc.sinClasificar ? ' · ' + cc.sinClasificar + ' sin clasificar' : '' %><%= cc.dias > 1 ? ' · ' + cc.dias + ' días' : '' %></span></div>
			</div>
			<div class="scroll-x">
				<table class="rank-table rep-table" style="min-width:900px">
					<thead><tr><th style="padding-left:24px">Tipo de caso</th><th style="width:70px">Nivel</th><th style="width:200px">Veces</th><th class="r" style="width:70px" title="Promedio de veces por día en el periodo">Por día</th><th style="width:80px" title="Frecuencia declarada en el catálogo">Frecuencia</th><th class="r" style="width:80px">Resueltos</th><th class="r" style="width:90px" title="Tiempo estimado del catálogo">Estimado</th><th class="r" style="width:90px" title="Promedio real desde la llegada del ticket hasta su resolución">Real</th><th class="r" style="width:70px;padding-right:24px">Puntos</th></tr></thead>
					<tbody>
						<% cc.filas.forEach((c, i) => { %>
							<tr>
								<td style="padding-left:24px"><span style="display:flex;flex-direction:column"><b><%= c.nombre %></b><span class="t2"><%= c.area %></span></span></td>
								<td class="t2" style="font-weight:600" title="<%= c.puntosNivel %> pts por caso">N<%= c.nivel %></td>
								<td><div style="display:flex;align-items:center;gap:10px"><span style="width:30px;font-weight:600"><%= c.ocurrencias %></span><div class="track" style="flex:1"><span class="bar-fill bg-blue" style="width:<%= c.ancho %>%;animation-delay:<%= i * 40 %>ms"></span></div><span class="t2" style="width:44px;text-align:right;font-variant-numeric:tabular-nums"><%= coma(c.pct) %>%</span></div></td>
								<td class="r"><%= coma(c.porDia) %></td>
								<td class="t2"><%= c.frecuencia || '—' %></td>
								<td class="r"><%= c.resueltos %></td>
								<td class="r t2"><%= c.minutosEstimados ? c.estimado : '—' %></td>
								<td class="r<%= c.sobreEstimado ? ' t-orange' : '' %>" style="font-weight:600"<% if (c.sobreEstimado) { %> title="Tarda más de lo estimado"<% } %>><%= c.tiempoPromedioMin === null ? '—' : c.tiempoPromedio %></td>
								<td class="r" style="padding-right:24px;font-weight:700"><%= c.puntos %></td>
							</tr>
						<% }) %>
					</tbody>
				</table>
				<% if (!cc.filas.length) { %><p class="empty" style="padding:16px 24px">Aún no hay casos con tipo en este periodo. El tipo se elige al tomar el ticket (Administración → Tipos de caso).</p><% } %>
			</div>
			<div class="t2" style="padding:12px 24px 16px;font-size:12px">Veces = casos recibidos en el periodo con ese tipo (y % del total con tipo) · Real = promedio desde la llegada hasta la resolución; en naranja si supera el estimado · Puntos = puntos de esos casos (N1 = 2, N2 = 4, N3 = 8, N4 = 10)</div>
		</section>
	</main>
</div>

<script id="report-data-json" type="application/json"><%- JSON.stringify(datos).replace(/</g, '\\u003c') %></script>
<script src="/js/menus.js?v=<%= locals.v || 1 %>" defer></script>
<script src="/js/reportes.js?v=<%= locals.v || 1 %>" defer></script>
</body>
</html>
