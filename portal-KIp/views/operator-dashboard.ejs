                    <!-- Card 1: Disponibles -->
                    <a href="#available" class="bg-white border border-[#E5E5EA] rounded-[12px] p-3.5 sm:p-4 flex flex-col justify-between shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-[0_2px_6px_rgba(0,0,0,0.06)] hover:border-[#D1D1D6] transition cursor-pointer group">
