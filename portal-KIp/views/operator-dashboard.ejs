                                                        </button>
                                                        <button type="button" data-ticket-action="status" data-ticket-status="CERRADO" data-ticket-code="<%= ticket.codigo_incidencia %>" class="figma-button !w-auto !h-[26px] !px-2.5 bg-[#34C759] hover:bg-[#28A745] text-white rounded-[6px] shadow-xs transition disabled:opacity-50 cursor-pointer">
                                                            <span class="figma-button__label text-white !text-[11px] font-medium">Resolver</span>
                                                        </button>
                                                    <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                        <tr data-filter-empty class="hidden">
                                            <td colspan="5" class="py-8 text-center text-[#8E8E93] text-[12px]">
                                                No hay tickets que coincidan con los filtros aplicados
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Cards/Casillas Grid View: Dynamically reorganizing across screen sizes -->
                            <div class="queue-grid-container grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 p-3.5 md:hidden">
                                <% queue.tickets.forEach(function(ticket) { 
                                    const prioInfo = getPriorityInfo(ticket.puntos_complejidad);
                                    const safeSubject = ticket.asunto || 'Sin asunto';
                                    const safeDesc = ticket.descripcion || '';
                                    const safeSender = ticket.remitente || (ticket.creado_por ? ticket.creado_por.nombre + ' <' + ticket.creado_por.email + '>' : '');
                                    const ticketDate = queue.id === 'resolved' 
                                        ? (ticket.fecha_cierre || ticket.resueltoEn || ticket.createdAt) 
