<%
	// Panel del operador (Fase 9, prototipo Operador.dc.html). El servidor dibuja
	// el encabezado, las tarjetas y el traspaso; public/js/operador.js dibuja la
	// bandeja (colas, búsqueda, filtro, paginación), los menús y las hojas.
	const p = panel;
	const t = p.turno;
	const TONO = { green: ['var(--green-bg)', 'var(--green-t)', '#22C55E'], purple: ['var(--purple-bg)', 'var(--purple-t)', '#8B5CF6'], gray: ['var(--fill)', 'var(--t2)', '#94A3B8'] }[t.tono];
	const CIRC = 2 * Math.PI * 30;
	const toLen = m => (Math.min(720, Math.max(0, m)) / 720) * CIRC;
	const ahoraMin = Math.floor(((Date.now() / 1000 - 4 * 3600) % 86400 + 86400) % 86400 / 60);
	const clk = {
		rot: ((t.inicio / 60) % 12) * 30 - 90,
		shift: toLen(t.fin - t.inicio).toFixed(1) + ' ' + CIRC.toFixed(1),
		done: toLen(Math.min(t.fin - t.inicio, ahoraMin - t.inicio)).toFixed(1) + ' ' + CIRC.toFixed(1)
	};
	const activos = p.mezcla.total;
	const datos = { panel: p, usuario: { id: currentUser.id } };
	const PR = { P1: 'var(--red-t)', P2: 'var(--orange-t)', P3: 'var(--t2)', SP: 'var(--t3)' };
%>
<!DOCTYPE html>
<html lang="es">
<head>
	<%- include('partials/head', { titulo: 'Mi panel' }) %>
	<link href="/css/operador.css" rel="stylesheet">
	<link href="/css/ticket-detalle.css" rel="stylesheet">
	<script src="/js/ticket-conversacion.js" defer></script>
	<script src="/js/operador.js" defer></script>
</head>
<body>
<div class="app op" id="op">
	<%- include('partials/sidebar', { currentUser, activo: 'panel', conteos: { misTickets: activos, area: p.usuario.areaNombre } }) %>

	<main class="app-main">
		<header class="op-head">
			<span class="popwrap">
				<button type="button" class="op-avatar" data-menu-me aria-haspopup="menu" aria-expanded="false" aria-label="Menú de <%= p.usuario.nombre %>"><%= p.usuario.iniciales %></button>
			</span>
			<div class="who">
				<h1><%= p.saludo %></h1>
				<span class="sub"><%= p.usuario.areaNombre %> · <%= t.corto %></span>
			</div>
			<span class="ptsbadge" title="Puntos sumados hoy por tickets resueltos">
				<span class="pi"><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/></svg></span>
				<strong><%= p.puntosHoy %></strong>puntos hoy
			</span>
			<span class="popwrap" id="opBell"></span>
			<span class="popwrap" id="opAvail"></span>
		</header>

		<section aria-label="Mi turno y mi carga" class="kgrid">
			<div class="glass kcard kc-turno">
				<div>
					<div class="khd"><span class="klab">Mi turno</span><span class="tag" style="background: <%= TONO[0] %>; color: <%= TONO[1] %>"><%= t.estado %></span></div>
					<span class="kbig sm"><%= t.horas %></span>
					<span class="ksub" id="opShiftLeft"><%= t.resto %></span>
				</div>
				<svg class="clk" id="opClock" width="80" height="80" viewBox="0 0 78 78" role="img" aria-label="Turno de <%= t.horas %>" data-inicio="<%= t.inicio %>" data-fin="<%= t.fin %>">
					<circle cx="39" cy="39" r="35.5" fill="var(--clk-face)" stroke="var(--clk-rim)" stroke-width="0.75"/>
					<circle cx="39" cy="39" r="30" fill="none" stroke="var(--clk-track)" stroke-width="5"/>
					<circle class="clk-arc" cx="39" cy="39" r="30" fill="none" stroke="<%= TONO[2] %>" stroke-opacity="0.30" stroke-width="5" stroke-linecap="round" stroke-dasharray="<%= clk.shift %>" transform="rotate(<%= clk.rot %> 39 39)"/>
					<circle class="clk-arc clk-done" data-clk-done cx="39" cy="39" r="30" fill="none" stroke="<%= TONO[2] %>" stroke-width="5" stroke-linecap="round" stroke-dasharray="<%= clk.done %>" transform="rotate(<%= clk.rot %> 39 39)"/>
					<path d="M39.0 15.0L39.0 18.5M51.0 18.2L50.0 19.9M59.8 27.0L58.1 28.0M63.0 39.0L59.5 39.0M59.8 51.0L58.1 50.0M51.0 59.8L50.0 58.1M39.0 63.0L39.0 59.5M27.0 59.8L28.0 58.1M18.2 51.0L19.9 50.0M15.0 39.0L18.5 39.0M18.2 27.0L19.9 28.0M27.0 18.2L28.0 19.9" stroke="var(--t3)" stroke-width="1.3" stroke-linecap="round"/>
					<g class="hand" data-hand="h"><line x1="39" y1="42" x2="39" y2="26" stroke="var(--t1)" stroke-width="2.8" stroke-linecap="round"/></g>
					<g class="hand" data-hand="m"><line x1="39" y1="42" x2="39" y2="18" stroke="var(--t1)" stroke-width="1.8" stroke-linecap="round"/></g>
					<g class="hand hand-s" data-hand="s"><line x1="39" y1="45" x2="39" y2="16" stroke="#FF9F0A" stroke-width="1" stroke-linecap="round"/></g>
					<circle cx="39" cy="39" r="2.6" fill="<%= TONO[2] %>" stroke="var(--clk-face-solid)" stroke-width="1"/>
				</svg>
			</div>
			<div class="glass kcard kc-carga">
				<div class="khd"><span class="kico" style="background: #0A84FF"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></span><span class="klab">Pendientes</span></div>
				<div class="kline"><span class="kbig"><%= activos %></span><span class="ksub"><%= activos === 1 ? 'ticket por atender' : 'tickets por atender' %></span></div>
				<div class="mixbar" role="img" aria-label="<%= p.mezcla.segs.length ? p.mezcla.segs.map(g => g.n + ' ' + g.label.toLowerCase()).join(', ') : 'Sin tickets pendientes' %>">
					<% if (p.mezcla.segs.length) { p.mezcla.segs.forEach(g => { %><span class="bar-fill" style="flex: <%= g.n %> 1 0; background: <%= g.color %>"></span><% }) } else { %><span class="empty"></span><% } %>
				</div>
				<div class="legend">
					<% p.mezcla.segs.forEach(g => { %><span><i style="background: <%= g.color %>"></i><%= g.label %><strong><%= g.n %></strong></span><% }) %>
					<% if (!p.mezcla.segs.length) { %><span>Nada pendiente por ahora</span><% } %>
				</div>
			</div>
			<div class="glass kcard kc-res">
				<div class="khd"><span class="kico" style="background: #30D158"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L19 7"/></svg></span><span class="klab">Resueltos hoy</span></div>
				<div class="kline"><span class="kbig" style="color: var(--green-t)"><%= p.resueltos.n %></span><span class="ksub"><%= p.resueltos.n === 1 ? 'ticket' : 'tickets' %></span></div>
				<div class="reslist">
					<span><i style="background: #FF9F0A"></i>Pendientes de cierre<strong><%= p.resueltos.abiertos %></strong></span>
					<span><i style="background: #30D158"></i>Cerrados<strong><%= p.resueltos.cerrados %></strong></span>
				</div>
			</div>
		</section>

		<% if (p.traspaso && p.traspaso.filas.length) { %>
		<section class="glass handoff" aria-labelledby="h-hand">
			<div class="handoff-hd">
				<span class="kico" style="width: 28px; height: 28px; border-radius: 8px; background: #8B5CF6"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h13l-3-3M20 16H7l3 3"/></svg></span>
				<h2 id="h-hand">Pendientes del traspaso</h2>
				<span><%= p.traspaso.hora %></span>
			</div>
			<div class="handoff-note">“<%= p.traspaso.nota %>”<small>Nota de <%= p.traspaso.autor %></small></div>
			<% p.traspaso.filas.forEach(f => { %>
			<div class="trow">
				<div class="tmain" style="flex: 1 1 160px">
					<span><span class="tcode"><%= f.code %></span><span style="font-size: 12px; font-weight: 600; color: <%= PR[f.p] %>"><%= f.p === 'SP' ? 'Sin prioridad' : f.p %></span><span class="tmeta" style="color: var(--<%= f.opTono === 'green' ? 'green-t' : f.opTono === 'orange' ? 'orange-t' : 't2' %>)"><%= f.op %></span></span>
					<button type="button" class="tlink" data-open="<%= f.code %>" style="font-size: 13px"><%= f.subject %></button>
				</div>
				<% if (f.puedeTomar) { %><div class="tacts" style="width: auto"><button type="button" class="btn-p" data-act="claim" data-code="<%= f.code %>">Tomar</button></div><% } %>
			</div>
			<% }) %>
		</section>
		<% } %>

		<section class="glass bandeja" aria-labelledby="h-cola" id="opBandeja">
			<nav class="qnav" aria-label="Colas de tickets" id="opQnav"><span class="qnav-h">Mis colas</span></nav>
			<div class="qmain">
				<div class="qbar">
					<div class="qtitle"><h2 id="h-cola">Cargando…</h2><span id="opQdesc"></span></div>
					<label class="qsearch"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" style="flex: none"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><input type="search" id="opSearch" placeholder="Buscar código o asunto" aria-label="Buscar en esta cola" autocomplete="off"></label>
					<div class="pfilter" role="tablist" aria-label="Filtrar por prioridad" id="opPf"></div>
				</div>
				<div class="qlist" id="opList"></div>
			</div>
		</section>
	</main>
</div>

    <!-- BEGIN: Ticket Details Modal (rediseño: pestañas Detalle y Conversación) -->
    <div id="ticketDetailsOverlay" class="tdlg-overlay hidden" onclick="handleTicketDetailsBackdrop(event)">
        <section id="ticketDetailsCard" class="tdlg" role="dialog" aria-modal="true" aria-labelledby="modalDetailSubject">
            <header class="tdlg-hd">
                <div class="tdlg-row">
                    <span id="modalDetailCode" class="tdlg-code"></span>
                    <span id="modalDetailPriorityBadge" class="tdlg-tag"></span>
                    <span id="modalDetailStatusBadge" class="tdlg-tag"></span>
                    <span class="tdlg-sp"></span>
                    <button type="button" class="tdlg-x" onclick="closeTicketDetailsModal()" aria-label="Cerrar detalle">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                    </button>
                </div>
                <h2 id="modalDetailSubject" class="tdlg-title"></h2>
                <div role="tablist" aria-label="Secciones del ticket" class="dtabs">
                    <button type="button" role="tab" id="tdTabInfo" aria-controls="tdPanelInfo" aria-selected="true">Detalle</button>
                    <button type="button" role="tab" id="tdTabThread" aria-controls="tdPanelThread" aria-selected="false" tabindex="-1">Conversación<span class="dn" id="tdMsgCount" aria-label="mensajes">…</span></button>
                </div>
            </header>

            <!-- Pestaña Detalle -->
            <div id="tdPanelInfo" role="tabpanel" aria-labelledby="tdTabInfo" class="tdlg-body">
                <div class="dgrid">
                    <div class="dfield"><span>Área</span><span id="modalDetailArea"></span></div>
                    <div class="dfield"><span>Asignado a</span><span id="modalDetailAssigned"></span></div>
                    <div class="dfield"><span>Remitente</span><span id="modalDetailSender"></span></div>
                    <div class="dfield"><span>Origen</span><span id="modalDetailOrigin"></span></div>
                    <div class="dfield"><span>Recibido</span><span id="modalDetailCreated"></span></div>
                    <div class="dfield"><span>Puntos</span><span id="modalDetailPts"></span></div>
                </div>
                <div class="dsec">
                    <span class="dlabel">Descripción</span>
                    <div id="modalDetailDescription" class="ddesc"></div>
                </div>
                <div class="dsec">
                    <span class="dlabel">Adjuntos</span>
                    <div id="modalDetailFiles" class="dfiles"><span class="dmuted">Cargando…</span></div>
                </div>
            </div>

            <!-- Pestaña Conversación -->
            <div id="tdPanelThread" role="tabpanel" aria-labelledby="tdTabThread" class="tdlg-thread" hidden>
                <div id="tdWait" class="mwait" hidden>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2"></path></svg>
                    <span id="tdWaitText" style="flex:1"></span>
                </div>
                <div id="tdMsgs" class="mlist" role="log" aria-label="Conversación del ticket" aria-live="polite"></div>
                <div id="tdComposer" class="composer" data-mode="out" hidden>
                    <div class="composer-top">
                        <div role="radiogroup" aria-label="Tipo de mensaje" class="dtabs">
                            <button type="button" role="radio" data-cmode="out" aria-checked="true" aria-selected="true">Responder al cliente</button>
                            <button type="button" role="radio" data-cmode="note" aria-checked="false" aria-selected="false">Nota interna</button>
                        </div>
                        <span id="tdTo" class="composer-to"></span>
                    </div>
                    <label style="display:contents">
                        <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Mensaje</span>
                        <textarea id="tdText" rows="3" maxlength="5000" placeholder="Escribe la respuesta al cliente…"></textarea>
                    </label>
                    <div id="tdFiles" class="dfiles" hidden></div>
                    <div class="composer-tools">
                        <span id="tdTpls" style="display:contents"></span>
                        <span class="tdlg-sp"></span>
                        <input id="tdFileInput" type="file" multiple hidden>
                        <button type="button" id="tdAttach" class="tpl icon" aria-label="Adjuntar archivo" title="Adjuntar archivo">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11l-8.5 8.5a5 5 0 0 1-7-7L14 4a3.5 3.5 0 0 1 5 5l-8.5 8.5a2 2 0 0 1-3-3L15 7"></path></svg>
                        </button>
                    </div>
                </div>
                <div id="tdNoWrite" class="nowrite" hidden></div>
            </div>

            <div id="modalDetailFeedback" role="alert" class="tdlg-msg hidden" data-tone="error"></div>

            <footer class="tdlg-ft">
                <button type="button" class="td-btn s" onclick="closeTicketDetailsModal()">Cerrar</button>
                <span class="tdlg-sp"></span>
                <div id="tdSendGroup" class="tdlg-acts" hidden>
                    <button type="button" id="tdSendWait" class="td-btn s" title="Envía el correo y pasa el ticket a Espera de terceros" disabled>Enviar y esperar respuesta</button>
                    <button type="button" id="tdSend" class="td-btn p" disabled>Enviar</button>
                </div>
                <div id="modalDetailActionContainer" class="tdlg-acts"></div>
            </footer>
        </section>
    </div>
    <!-- END: Ticket Details Modal -->

<script type="application/json" id="opDatos"><%- JSON.stringify(datos).replace(/</g, '\\u003c') %></script>
</body>
</html>
