                            <%= operatorInitials || 'OP' %>
                        </div>
                        <div class="hidden sm:flex flex-col text-left">
                            <span class="text-[11px] font-medium text-[#1C1C1E] leading-tight"><%= operatorName %></span>
                            <span class="text-[9px] font-mono font-bold text-[#34C759] tracking-wider leading-tight">● <%= operatorArea %></span>
                        </div>
                    </summary>
                    <div class="absolute right-0 top-[100%] mt-1 w-[160px] bg-white rounded-[8px] border border-[#D1D1D6] shadow-[0_4px_14px_rgba(0,0,0,0.1)] p-1 z-50 text-[12px]">
