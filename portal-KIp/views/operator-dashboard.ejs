                                        data-ticket-origin="<%= originLabels[ticket.origen_ingesta] || ticket.origen_ingesta || 'Correo' %>"
                                        data-ticket-sender="<%= safeSender %>"
                                        data-ticket-priority-code="<%= prioInfo.code %>"
                                        data-ticket-priority-label="<%= prioInfo.label %>"
                                        data-ticket-priority-dot="<%= prioInfo.dot %>"
                                        data-ticket-priority-bg="<%= prioInfo.bg %>"
                                        data-ticket-priority-text="<%= prioInfo.text %>"
                                        data-ticket-priority-border="<%= prioInfo.border %>"
                                        data-ticket-pts="<%= ticket.puntos_complejidad || 0 %>"
                                        data-ticket-created="<%= formatDate(ticket.createdAt) %>"
                                        data-ticket-status="<%= ticket.estado_actual || 'NUEVO' %>"
                                        data-ticket-queue="<%= queue.id %>"
                                        class="bg-white border border-[#E5E5EA] rounded-[10px] p-3.5 flex flex-col justify-between shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-[0_4px_12px_rgba(0,0,0,0.05)] hover:border-[#D1D1D6] transition">
                                        <div>
                                            <div class="flex items-center justify-between gap-2 mb-2">
                                                <button type="button" onclick="openTicketDetails('<%= ticket.codigo_incidencia %>')" class="ticket-code-btn font-mono text-[12px] font-semibold text-[#007AFF] hover:underline cursor-pointer flex items-center gap-1 text-left" title="Ver detalles">
                                                    <span><%= ticket.codigo_incidencia %></span>
                                                    <svg class="w-3 h-3 text-[#007AFF]/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                                </button>
                                                <div class="flex items-center gap-1.5">
                                                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-[4px] text-[10px] font-mono font-medium border" style="background-color: <%= prioInfo.bg %>; color: <%= prioInfo.text %>; border-color: <%= prioInfo.border %>;">
                                                        <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= prioInfo.dot %>;"></span>
                                                        <%= prioInfo.shortLabel %>
                                                    </span>
                                                    <span class="pts-indicator inline-flex items-center font-mono text-[10px] px-1.5 py-0.5 rounded bg-[#F2F2F7] text-[#8E8E93] border border-[#E5E5EA]">
                                                        <%= ticket.puntos_complejidad || 0 %> pts
                                                    </span>
                                                </div>
                                            </div>
                                            <h3 class="text-[12px] font-medium text-[#1C1C1E] line-clamp-2 leading-snug break-words break-all hover:text-[#007AFF] cursor-pointer" onclick="openTicketDetails('<%= ticket.codigo_incidencia %>')"><%= ticket.asunto || 'Sin asunto' %></h3>
                                            <% if (ticket.descripcion) { %>
                                                <p class="text-[11px] text-[#8E8E93] line-clamp-2 mt-1 break-words"><%= ticket.descripcion %></p>
                                            <% } %>
                                            <div data-ticket-feedback role="alert" class="mt-1.5 hidden text-[10px] font-medium text-[#D70015] bg-[#FFE5E5] px-2 py-1 rounded-[5px] border border-[#FFD0D0]"></div>
