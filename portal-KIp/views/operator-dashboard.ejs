                    <svg class="figma-toolbars-search__symbol w-3.5 h-3.5 text-[#8E8E93] flex-shrink-0 pointer-events-none" fill="none"
                        stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
                    </svg>
                    <input
                        id="globalSearchInput"
                        oninput="onSearchInput(this.value)"
                        class="figma-toolbars-search__search-label !w-[110px] sm:!w-[150px] bg-transparent text-[11px] text-[#1C1C1E] placeholder-[#8E8E93] focus:outline-none border-none p-0"
                        placeholder="Buscar..." type="text">
                    <span class="flex-shrink-0 px-1 py-0.5 text-[9px] font-mono text-[#8E8E93] bg-white border border-[#D1D1D6] rounded pointer-events-none font-medium relative z-10">⌘K</span>
                </div>
                <div class="h-5 w-[1px] bg-[#D1D1D6] mx-0.5 hidden sm:block"></div>
                <details class="relative group select-none z-50">
