                            <div class="flex items-center gap-2.5">
                                <h2 id="heading-<%= queue.id %>" class="text-[13px] font-semibold text-[#1C1C1E]"><%= queue.title %></h2>
                                <span class="rounded-full bg-black/5 px-2 py-0.5 text-[10px] font-mono font-semibold text-[#636366]"><%= queue.tickets.length %></span>
                            </div>
                            <span class="text-[11px] text-[#8E8E93] hidden sm:inline"><%= queue.description %></span>
