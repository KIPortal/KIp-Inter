                                                    </button>
                                                    <div class="mt-1 flex items-center gap-1.5">
                                                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-[4px] text-[10px] font-mono font-medium border" style="background-color: <%= prioInfo.bg %>; color: <%= prioInfo.text %>; border-color: <%= prioInfo.border %>;">
                                                            <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= prioInfo.dot %>;"></span>
                                                            <%= prioInfo.shortLabel %>
                                                        </span>
                                                        <span class="pts-indicator font-mono text-[9.5px] font-normal text-[#8E8E93]"><%= ticket.puntos_complejidad || 0 %> pts</span>
                                                    </div>
                                                </td>
                                                <td class="finder-th py-3 px-4">
                                                    <div class="font-medium text-[#1C1C1E] line-clamp-2 leading-snug break-words"><%= ticket.asunto || 'Sin asunto' %></div>
                                                    <% if (ticket.descripcion) { %>
                                                        <p class="text-[11px] text-[#8E8E93] line-clamp-1 mt-0.5 break-words"><%= ticket.descripcion %></p>
                                                    <% } %>
                                                    <div data-ticket-feedback role="alert" class="mt-1 hidden text-[10px] font-medium text-[#D70015] bg-[#FFE5E5] px-1.5 py-0.5 rounded border border-[#FFD0D0]"></div>
                                                </td>
