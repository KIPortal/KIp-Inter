                            </button>
                            <button type="button" onclick="filterByPriorityLocal('P1')" id="filterBtnP1" class="px-2 py-1 rounded-[6px] bg-[#F5F5F7] hover:bg-[#EBEBF0] text-[#1C1C1E] border border-black/5 text-[11px] font-medium transition cursor-pointer flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#FF3B30]"></span>
                                <span>P1</span>
                            </button>
                            <button type="button" onclick="filterByPriorityLocal('P2')" id="filterBtnP2" class="px-2 py-1 rounded-[6px] bg-[#F5F5F7] hover:bg-[#EBEBF0] text-[#1C1C1E] border border-black/5 text-[11px] font-medium transition cursor-pointer flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#FFBD2E]"></span>
                                <span>P2</span>
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-[11px] text-[#8E8E93] hidden sm:inline">Vista:</span>
                        <!-- Segmented Control macOS style -->
                        <div class="bg-[#EBEBF0] p-0.5 rounded-[7px] inline-flex font-medium text-[11px]">
                            <button id="viewModeTableBtn" type="button" onclick="setViewMode('table')" class="px-2.5 py-1 rounded-[5px] bg-white shadow-sm text-[#1C1C1E] font-medium transition cursor-pointer flex items-center gap-1.5" title="Vista en tabla">
                                <svg class="w-3.5 h-3.5 text-[#1C1C1E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                                <span>Filas</span>
                            </button>
                            <button id="viewModeGridBtn" type="button" onclick="setViewMode('grid')" class="px-2.5 py-1 rounded-[5px] text-[#8E8E93] hover:text-[#1C1C1E] transition cursor-pointer flex items-center gap-1.5" title="Vista en tarjetas">
                                <svg class="w-3.5 h-3.5 text-[#8E8E93]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                                <span>Tarjetas</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Main Queues Container -->
                <div id="queues-container" class="queue-view-table flex flex-col gap-4 pb-6">
                <% queues.forEach(function(queue) { 
                    const isDefaultVisible = queue.id === 'available' || queue.id === 'assigned';
                %>
                    <section id="<%= queue.id %>" aria-labelledby="heading-<%= queue.id %>" class="queue-section <%= isDefaultVisible ? 'flex' : 'hidden' %> flex-col overflow-hidden rounded-[12px] border border-[#E5E5EA] bg-white shadow-[0_1px_3px_rgba(0,0,0,0.03)]">
