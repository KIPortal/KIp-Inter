<%
    const operator = typeof currentUser !== 'undefined' && currentUser ? currentUser : {};
    const availableTickets = typeof ticketsAvailable !== 'undefined' && Array.isArray(ticketsAvailable) ? ticketsAvailable : [];
    const assignedTickets = typeof ticketsAssigned !== 'undefined' && Array.isArray(ticketsAssigned) ? ticketsAssigned : [];
    const pausedTickets = typeof ticketsPaused !== 'undefined' && Array.isArray(ticketsPaused) ? ticketsPaused : [];
    const waitingTickets = typeof ticketsWaiting !== 'undefined' && Array.isArray(ticketsWaiting) ? ticketsWaiting : [];
    const resolvedTickets = typeof ticketsResolved !== 'undefined' && Array.isArray(ticketsResolved) ? ticketsResolved : [];
    
    const areaLabels = {
        GENERAL: 'Operaciones IP',
        REDES_FTTH: 'Redes FTTH / OLT',
        TRAFICO_INALAMBRICO: 'Tráfico inalámbrico',
        WAN: 'WAN',
        GRANDES_CLIENTES: 'Grandes clientes',
        SEGURIDAD: 'Seguridad',
        TELEFONIA: 'Telefonía'
    };

    const originLabels = {
        CORREO: 'Correo electrónico',
        LLAMADA: 'Llamada telefónica',
        JEFATURA: 'Instrucción de jefatura',
        COORDINADOR: 'Asignación de coordinador'
    };

    const operatorName = operator.nombre || 'Operador';
    const operatorInitials = operatorName.trim().split(/\s+/).slice(0, 2).map(part => part[0]).join('').toUpperCase();
    const operatorArea = areaLabels[operator.area_designada] || operator.area_designada || 'Área no asignada';

    const formatDate = value => {
        if (!value) return 'Fecha no disponible';
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? 'Fecha no disponible' : new Intl.DateTimeFormat('es', { dateStyle: 'medium', timeStyle: 'short' }).format(date);
    };

    const getPriorityInfo = points => {
        const pts = points || 0;
        if (pts >= 8) {
            return { code: 'P1', label: 'P1 (Crítica)', shortLabel: 'P1', dot: '#FF3B30', bg: '#FFE5E5', text: '#D70015', border: '#FFD0D0', pts };
        } else if (pts >= 5) {
            return { code: 'P2', label: 'P2 (Media)', shortLabel: 'P2', dot: '#FFBD2E', bg: '#FFF4D6', text: '#B25E02', border: '#FFE6A6', pts };
        } else if (pts >= 1) {
            return { code: 'P3', label: 'P3 (Baja)', shortLabel: 'P3', dot: '#8E8E93', bg: '#F2F2F7', text: '#1C1C1E', border: '#D1D1D6', pts };
        } else {
            return { code: 'NONE', label: 'S/P (Sin Prioridad)', shortLabel: 'S/P', dot: '#C7C7CC', bg: '#F2F2F7', text: '#8E8E93', border: '#E5E5EA', pts: 0 };
        }
    };

    // Calculate unique areas present in availableTickets for area filter tabs/chips
    const availableAreaCounts = {};
    availableTickets.forEach(t => {
        const a = t.area_designada || 'GENERAL';
        availableAreaCounts[a] = (availableAreaCounts[a] || 0) + 1;
    });
    const uniqueAvailableAreas = Object.keys(availableAreaCounts);

    const queues = [
        { id: 'available', title: 'Disponibles', description: 'Incidencias listas para tomar', tickets: availableTickets, tone: 'emerald', dateField: 'createdAt' },
        { id: 'assigned', title: 'En progreso', description: 'Trabajo activo asignado a ti', tickets: assignedTickets, tone: 'blue', dateField: 'fecha_asignacion' },
        { id: 'paused', title: 'Pausados', description: 'Incidencias en pausa', tickets: pausedTickets, tone: 'amber', dateField: 'fecha_asignacion' },
        { id: 'waiting', title: 'Espera de terceros', description: 'Pendientes de respuesta externa', tickets: waitingTickets, tone: 'orange', dateField: 'fecha_asignacion' },
        { id: 'resolved', title: 'Resueltos', description: 'Incidencias cerradas', tickets: resolvedTickets, tone: 'slate', dateField: 'fecha_cierre' }
    ];
%>
<!DOCTYPE html>
<html class="h-full bg-[#E8E8ED]" lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#E8E8ED">
    <title><%= typeof titulo !== 'undefined' ? titulo : 'Operaciones · Portal NOC' %></title>
    <!-- Tailwind CSS v3 with Plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="/css/figma-assets.css" rel="stylesheet">
    <link href="/css/ticket-detalle.css" rel="stylesheet">
    <%# Tema del detalle del ticket: el mismo del resto del portal (kip.theme) o el del sistema %>
    <script>
        (function () {
            var tema = null;
            try { tema = localStorage.getItem('kip.theme'); } catch (e) {}
            if (tema !== 'light' && tema !== 'dark') {
                tema = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', tema);
        })();
    </script>
    <script src="/js/ticket-conversacion.js" defer></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', 'Inter', 'SF Pro Text', 'SF Pro Display', 'Helvetica Neue', 'sans-serif'],
                        mono: ['SF Mono', 'JetBrains Mono', 'Menlo', 'Monaco', 'Courier New', 'monospace']
                    },
                    colors: {
                        mac: {
                            bg: '#F5F5F7', window: '#FFFFFF', sidebar: '#EBEBF0', accent: '#007AFF', accentHover: '#0062CC',
                            subtle: '#8E8E93', border: '#E5E5EA', borderLight: '#F2F2F7', headerBorder: '#D1D1D6',
                            selected: '#DCEBFE', selectedText: '#0062CC', dangerLight: '#FFE5E5', dangerText: '#D70015',
                            successLight: '#E3F9E5', successText: '#1B873F', warningLight: '#FFF4D6', warningText: '#B25E02'
                        }
                    }
                }
            }
        };
    </script>
    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            user-select: none;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.15);
            border-radius: 9999px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 0, 0, 0.28);
        }

        .num-tabular {
            font-variant-numeric: tabular-nums;
        }

        .finder-th+.finder-th {
            border-left: 1px solid #E5E5EA;
        }

        .priority-badge {
            background-color: var(--prio-bg, #F2F2F7);
            color: var(--prio-txt, #8E8E93);
            border-color: var(--prio-border, #E5E5EA);
        }

        .macos-focus-ring {
            box-shadow: 0 0 0 3px rgba(0, 136, 255, 0.35);
            border-color: #389BFF !important;
        }

        /* Responsive view toggling */
        @media (min-width: 768px) {
            .queue-view-table .queue-table-container { display: block !important; }
            .queue-view-table .queue-grid-container { display: none !important; }

            .queue-view-grid .queue-table-container { display: none !important; }
            .queue-view-grid .queue-grid-container { display: grid !important; }
        }

        @media (max-width: 767px) {
            /* On small screens, cards view is active by default to prevent horizontal overflow */
            .queue-table-container { display: none !important; }
            .queue-grid-container {
                display: grid !important;
                grid-template-columns: repeat(1, minmax(0, 1fr));
            }
        }
    </style>
</head>

<body class="h-dvh w-full min-w-0 bg-[#F5F5F7] overflow-hidden flex flex-col font-sans text-[13px] text-[#1C1C1E] m-0 p-0 antialiased">

    <!-- macOS Full Application Viewport -->
