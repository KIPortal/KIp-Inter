                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-[#007AFF]"></span>
                                <span>En progreso</span>
                            </div>
                            <span class="tab-badge font-mono text-[9px] bg-black/5 text-[#8E8E93] px-1.5 py-0.5 rounded font-bold">
                                <%= assignedTickets.length %>
                            </span>
                        </a>
                        <a href="#paused" class="tab-link flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#3A3A3C] hover:bg-black/5 text-[12px] font-medium transition cursor-pointer whitespace-nowrap">
