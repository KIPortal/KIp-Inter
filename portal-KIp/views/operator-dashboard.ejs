            <!-- BEGIN: Content Main Area -->
            <main class="flex-1 flex flex-col min-w-0 overflow-y-auto p-2.5 sm:p-4 gap-3 bg-[#F5F5F7]">

                <!-- BEGIN: KPI Cards / macOS Widget Panels -->
