                        </div>
                        <div class="mt-2 text-[28px] sm:text-[32px] font-semibold font-mono text-[#1C1C1E] tracking-tight num-tabular leading-none">
                            <%= availableTickets.length %>
                        </div>
                    </a>

                    <!-- Card 2: En progreso -->
                    <a href="#assigned" class="bg-white border border-[#E5E5EA] rounded-[12px] p-3.5 sm:p-4 flex flex-col justify-between shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-[0_2px_6px_rgba(0,0,0,0.06)] hover:border-[#D1D1D6] transition cursor-pointer group">
                        <div class="flex items-start justify-between">
                            <span class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider leading-tight group-hover:text-[#1C1C1E] transition">EN PROGRESO</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[#007AFF] mt-0.5"></span>
                        </div>
                        <div class="mt-2 text-[28px] sm:text-[32px] font-semibold font-mono text-[#1C1C1E] tracking-tight num-tabular leading-none">
                            <%= assignedTickets.length %>
                        </div>
                    </a>

                    <!-- Card 3: Pausados / Espera -->
                    <a href="#paused-waiting" class="bg-white border border-[#E5E5EA] rounded-[12px] p-3.5 sm:p-4 flex flex-col justify-between shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-[0_2px_6px_rgba(0,0,0,0.06)] hover:border-[#D1D1D6] transition cursor-pointer group">
                        <div class="flex items-start justify-between">
                            <span class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider leading-tight group-hover:text-[#1C1C1E] transition">PAUSADOS / ESPERA</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[#FF9500] mt-0.5"></span>
                        </div>
                        <div class="mt-2 text-[28px] sm:text-[32px] font-semibold font-mono text-[#1C1C1E] tracking-tight num-tabular leading-none">
                            <%= pausedTickets.length + waitingTickets.length %>
                        </div>
                    </a>

                    <!-- Card 4: Resueltos -->
                    <a href="#resolved" class="bg-white border border-[#E5E5EA] rounded-[12px] p-3.5 sm:p-4 flex flex-col justify-between shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-[0_2px_6px_rgba(0,0,0,0.06)] hover:border-[#D1D1D6] transition cursor-pointer group">
                        <div class="flex items-start justify-between">
                            <span class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider leading-tight group-hover:text-[#1C1C1E] transition">RESUELTOS</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[#8E8E93] mt-0.5"></span>
                        </div>
                        <div class="mt-2 text-[28px] sm:text-[32px] font-semibold font-mono text-[#1C1C1E] tracking-tight num-tabular leading-none">
                            <%= resolvedTickets.length %>
                        </div>
                    </a>
                </section>
                <!-- END: KPI Cards -->

                <!-- Global Toolbar macOS 27 Style -->
                <div class="figma-toolbar flex flex-wrap items-center justify-between gap-2 rounded-[10px] border border-[#E5E5EA] bg-white px-3.5 py-2 shadow-[0_1px_3px_rgba(0,0,0,0.03)] flex-shrink-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-[12px] font-semibold text-[#1C1C1E]">Filtros Rápidos</span>
                        <div class="h-4 w-[1px] bg-[#D1D1D6] mx-1"></div>
                        <div class="flex flex-wrap items-center gap-1.5">
                            <button type="button" onclick="filterByPriorityLocal('ALL')" id="filterBtnAll" class="px-2.5 py-1 rounded-[6px] bg-[#007AFF] text-white text-[11px] font-medium shadow-sm transition cursor-pointer">
                                Todas
                            </button>
                            <button type="button" onclick="filterByPriorityLocal('HIGH')" id="filterBtnHigh" class="px-2.5 py-1 rounded-[6px] bg-[#F5F5F7] hover:bg-[#EBEBF0] text-[#1C1C1E] border border-black/5 text-[11px] font-medium transition cursor-pointer">
