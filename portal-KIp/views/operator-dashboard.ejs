                                </svg>
                                <span>Inicio</span>
                            </div>
                            <span class="tab-badge font-mono text-[9px] bg-[#007AFF]/15 text-[#0062CC] px-1.5 py-0.5 rounded font-bold">
                                <%= availableTickets.length + assignedTickets.length %>
                            </span>
                        </a>
                        <a href="#available" class="tab-link flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#3A3A3C] hover:bg-black/5 text-[12px] font-medium transition cursor-pointer whitespace-nowrap">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-[#34C759]"></span>
                                <span>Disponibles</span>
                            </div>
                            <span class="tab-badge font-mono text-[9px] bg-black/5 text-[#8E8E93] px-1.5 py-0.5 rounded font-bold">
                                <%= availableTickets.length %>
                            </span>
                        </a>
