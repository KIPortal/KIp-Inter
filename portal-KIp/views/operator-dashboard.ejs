        </header>

        <!-- Main Body Workspace -->
        <div class="flex-1 flex flex-col md:flex-row overflow-hidden min-h-0 bg-[#F5F5F7]">

            <!-- BEGIN: Finder-style macOS Sidebar -->
            <aside class="w-full md:w-[220px] lg:w-[240px] flex-shrink-0 bg-[#EBEBF0]/95 border-b md:border-b-0 md:border-r border-[#D8D8DC] flex flex-col justify-between select-none py-2 md:py-3 px-2 sm:px-3 overflow-x-auto md:overflow-y-auto">
                <div class="space-y-3">
                    <div class="hidden md:block px-2.5 pb-1 text-[10px] font-bold text-[#8E8E93] uppercase tracking-wider">
