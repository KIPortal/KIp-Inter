                                        <% } else if (queue.id === 'assigned') { %>
                                            <% if (ticket.estado_actual === 'NUEVO') { %>
                                                <button type="button" data-ticket-action="claim" data-ticket-code="<%= ticket.codigo_incidencia %>" class="figma-button !w-auto !h-[26px] !px-3 bg-[#007AFF] hover:bg-[#0062CC] text-white rounded-[6px] shadow-xs transition disabled:opacity-50 cursor-pointer">
                                                    <span class="figma-button__label text-white !text-[11px] font-medium">Tomar</span>
                                                </button>
                                            <% } else { %>
                                                <div class="flex flex-wrap items-center gap-1">
                                                    <button type="button" data-ticket-action="status" data-ticket-status="EN_PAUSA" data-ticket-code="<%= ticket.codigo_incidencia %>" class="figma-button !w-auto !h-[26px] !px-2 bg-white border border-[#D1D1D6] hover:bg-[#F2F2F7] text-[#1C1C1E] rounded-[6px] shadow-sm transition disabled:opacity-50 cursor-pointer">
                                                        <span class="figma-button__label text-[#1C1C1E] !text-[11px] font-medium">Pausar</span>
                                                    </button>
                                                    <button type="button" data-ticket-action="status" data-ticket-status="CERRADO" data-ticket-code="<%= ticket.codigo_incidencia %>" class="figma-button !w-auto !h-[26px] !px-2.5 bg-[#34C759] hover:bg-[#28A745] text-white rounded-[6px] shadow-xs transition disabled:opacity-50 cursor-pointer">
                                                        <span class="figma-button__label text-white !text-[11px] font-medium">Resolver</span>
                                                    </button>
                                                </div>
                                            <% } %>
                                        <% } else if (queue.id === 'paused' || queue.id === 'waiting') { %>
                                            <div class="flex flex-wrap items-center gap-1">
                                                <button type="button" data-ticket-action="status" data-ticket-status="EN_PROGRESO" data-ticket-code="<%= ticket.codigo_incidencia %>" class="figma-button !w-auto !h-[26px] !px-2 bg-[#007AFF] hover:bg-[#0062CC] text-white rounded-[6px] shadow-xs transition disabled:opacity-50 cursor-pointer">
                                                    <span class="figma-button__label text-white !text-[11px] font-medium">Reanudar</span>
                                                </button>
                                                <button type="button" data-ticket-action="status" data-ticket-status="CERRADO" data-ticket-code="<%= ticket.codigo_incidencia %>" class="figma-button !w-auto !h-[26px] !px-2.5 bg-[#34C759] hover:bg-[#28A745] text-white rounded-[6px] shadow-xs transition disabled:opacity-50 cursor-pointer">
                                                    <span class="figma-button__label text-white !text-[11px] font-medium">Resolver</span>
                                                </button>
                                            </div>
                                        <% } %>
                                        </div>
                                    </article>
                                <% }); %>
                                <div data-filter-empty-grid class="hidden col-span-full py-8 text-center text-[#8E8E93] text-[12px]">
                                    No hay tickets que coincidan con los filtros aplicados
                                </div>
                            </div>
                        <% } else { %>
                            <div class="px-5 py-12 text-center">
                                <div class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#F2F2F7] text-[#8E8E93] mb-2">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                                </div>
                                <p class="text-[12px] font-medium text-[#1C1C1E]">No hay tickets en esta cola</p>
                                <p class="text-[11px] text-[#8E8E93] mt-0.5"><%= queue.description %></p>
                            </div>
                        <% } %>
                    </section>
                <% }); %>
                </div>
            </main>
        </div>
    </div>

    <!-- BEGIN: Ticket Details Modal (rediseño: pestañas Detalle y Conversación) -->
    <div id="ticketDetailsOverlay" class="tdlg-overlay hidden" onclick="handleTicketDetailsBackdrop(event)">
        <section id="ticketDetailsCard" class="tdlg" role="dialog" aria-modal="true" aria-labelledby="modalDetailSubject">
            <header class="tdlg-hd">
                <div class="tdlg-row">
                    <span id="modalDetailCode" class="tdlg-code"></span>
                    <span id="modalDetailPriorityBadge" class="tdlg-tag"></span>
                    <span id="modalDetailStatusBadge" class="tdlg-tag"></span>
                    <span class="tdlg-sp"></span>
                    <button type="button" class="tdlg-x" onclick="closeTicketDetailsModal()" aria-label="Cerrar detalle">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                    </button>
                </div>
                <h2 id="modalDetailSubject" class="tdlg-title"></h2>
                <div role="tablist" aria-label="Secciones del ticket" class="dtabs">
                    <button type="button" role="tab" id="tdTabInfo" aria-controls="tdPanelInfo" aria-selected="true">Detalle</button>
                    <button type="button" role="tab" id="tdTabThread" aria-controls="tdPanelThread" aria-selected="false" tabindex="-1">Conversación<span class="dn" id="tdMsgCount" aria-label="mensajes">…</span></button>
                </div>
            </header>

            <!-- Pestaña Detalle -->
            <div id="tdPanelInfo" role="tabpanel" aria-labelledby="tdTabInfo" class="tdlg-body">
                <div class="dgrid">
                    <div class="dfield"><span>Área</span><span id="modalDetailArea"></span></div>
                    <div class="dfield"><span>Asignado a</span><span id="modalDetailAssigned"></span></div>
                    <div class="dfield"><span>Remitente</span><span id="modalDetailSender"></span></div>
                    <div class="dfield"><span>Origen</span><span id="modalDetailOrigin"></span></div>
                    <div class="dfield"><span>Recibido</span><span id="modalDetailCreated"></span></div>
                    <div class="dfield"><span>Puntos</span><span id="modalDetailPts"></span></div>
                </div>
                <div class="dsec">
                    <span class="dlabel">Descripción</span>
                    <div id="modalDetailDescription" class="ddesc"></div>
                </div>
                <div class="dsec">
                    <span class="dlabel">Adjuntos</span>
                    <div id="modalDetailFiles" class="dfiles"><span class="dmuted">Cargando…</span></div>
                </div>
            </div>

            <!-- Pestaña Conversación -->
            <div id="tdPanelThread" role="tabpanel" aria-labelledby="tdTabThread" class="tdlg-thread" hidden>
                <div id="tdWait" class="mwait" hidden>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2"></path></svg>
                    <span id="tdWaitText" style="flex:1"></span>
                </div>
                <div id="tdMsgs" class="mlist" role="log" aria-label="Conversación del ticket" aria-live="polite"></div>
                <div id="tdComposer" class="composer" data-mode="out" hidden>
                    <div class="composer-top">
                        <div role="radiogroup" aria-label="Tipo de mensaje" class="dtabs">
                            <button type="button" role="radio" data-cmode="out" aria-checked="true" aria-selected="true">Responder al cliente</button>
                            <button type="button" role="radio" data-cmode="note" aria-checked="false" aria-selected="false">Nota interna</button>
                        </div>
                        <span id="tdTo" class="composer-to"></span>
                    </div>
                    <label style="display:contents">
                        <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Mensaje</span>
                        <textarea id="tdText" rows="3" maxlength="5000" placeholder="Escribe la respuesta al cliente…"></textarea>
                    </label>
                    <div id="tdFiles" class="dfiles" hidden></div>
                    <div class="composer-tools">
                        <span id="tdTpls" style="display:contents"></span>
                        <span class="tdlg-sp"></span>
                        <input id="tdFileInput" type="file" multiple hidden>
                        <button type="button" id="tdAttach" class="tpl icon" aria-label="Adjuntar archivo" title="Adjuntar archivo">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11l-8.5 8.5a5 5 0 0 1-7-7L14 4a3.5 3.5 0 0 1 5 5l-8.5 8.5a2 2 0 0 1-3-3L15 7"></path></svg>
                        </button>
                    </div>
                </div>
                <div id="tdNoWrite" class="nowrite" hidden></div>
            </div>

            <div id="modalDetailFeedback" role="alert" class="tdlg-msg hidden" data-tone="error"></div>

            <footer class="tdlg-ft">
                <button type="button" class="td-btn s" onclick="closeTicketDetailsModal()">Cerrar</button>
                <span class="tdlg-sp"></span>
                <div id="tdSendGroup" class="tdlg-acts" hidden>
                    <button type="button" id="tdSendWait" class="td-btn s" title="Envía el correo y pasa el ticket a Espera de terceros" disabled>Enviar y esperar respuesta</button>
                    <button type="button" id="tdSend" class="td-btn p" disabled>Enviar</button>
                </div>
                <div id="modalDetailActionContainer" class="tdlg-acts"></div>
            </footer>
        </section>
    </div>
    <!-- END: Ticket Details Modal -->

    <script>
        function updateView() {
            const hash = window.location.hash || '#default';
            const queues = document.querySelectorAll('.queue-section');
            const tabs = document.querySelectorAll('.tab-link');
            
            // Reset tabs styling to default inactive
            tabs.forEach(t => {
                t.classList.remove('bg-white', 'text-[#007AFF]', 'shadow-[0_1px_3px_rgba(0,0,0,0.06)]', 'font-semibold', 'border', 'border-black/5');
                t.classList.add('text-[#3A3A3C]', 'hover:bg-black/5', 'font-medium');
                const badge = t.querySelector('.tab-badge');
                if (badge) {
                    badge.classList.remove('bg-[#007AFF]/15', 'text-[#0062CC]');
                    badge.classList.add('bg-black/5', 'text-[#8E8E93]');
                }
            });

            // Set active tab styling
            const activeTab = document.querySelector(`.tab-link[href="${hash}"]`);
            if (activeTab) {
                activeTab.classList.remove('text-[#3A3A3C]', 'hover:bg-black/5', 'font-medium');
                activeTab.classList.add('bg-white', 'text-[#007AFF]', 'shadow-[0_1px_3px_rgba(0,0,0,0.06)]', 'font-semibold', 'border', 'border-black/5');
                const badge = activeTab.querySelector('.tab-badge');
                if (badge) {
                    badge.classList.remove('bg-black/5', 'text-[#8E8E93]');
                    badge.classList.add('bg-[#007AFF]/15', 'text-[#0062CC]');
                }
            }

            // Show/hide queues
            if (hash === '#default') {
                queues.forEach(q => {
                    if (q.id === 'available' || q.id === 'assigned') {
                        q.classList.remove('hidden');
                        q.classList.add('flex');
                    } else {
                        q.classList.add('hidden');
                        q.classList.remove('flex');
                    }
                });
            } else if (hash === '#paused-waiting') {
                // Show both paused and waiting queues when clicking paused/espera KPI card
                queues.forEach(q => {
                    if (q.id === 'paused' || q.id === 'waiting') {
                        q.classList.remove('hidden');
                        q.classList.add('flex');
                    } else {
                        q.classList.add('hidden');
                        q.classList.remove('flex');
                    }
                });
            } else {
                queues.forEach(q => {
                    if ('#' + q.id === hash) {
                        q.classList.remove('hidden');
                        q.classList.add('flex');
                    } else {
                        q.classList.add('hidden');
                        q.classList.remove('flex');
                    }
                });
            }
        }

        window.addEventListener('hashchange', updateView);
        document.addEventListener('DOMContentLoaded', () => {
            updateView();
            syncResponsiveView();
            startRealtimeSync();
        });

        // View Mode Toggle (Table / Grid)
        let userPreferredViewMode = 'table'; // Desktop preference

        function updateSegmentedButtons(activeMode) {
            const tableBtn = document.getElementById('viewModeTableBtn');
            const gridBtn = document.getElementById('viewModeGridBtn');
            const tableSvg = tableBtn ? tableBtn.querySelector('svg') : null;
            const gridSvg = gridBtn ? gridBtn.querySelector('svg') : null;

            if (activeMode === 'table') {
                if (tableBtn) tableBtn.className = 'px-2.5 py-1 rounded-[5px] bg-white shadow-sm text-[#1C1C1E] font-medium transition cursor-pointer flex items-center gap-1.5';
                if (gridBtn) gridBtn.className = 'px-2.5 py-1 rounded-[5px] text-[#8E8E93] hover:text-[#1C1C1E] transition cursor-pointer flex items-center gap-1.5';
                if (tableSvg) tableSvg.className = 'w-3.5 h-3.5 text-[#1C1C1E]';
                if (gridSvg) gridSvg.className = 'w-3.5 h-3.5 text-[#8E8E93]';
            } else {
                if (gridBtn) gridBtn.className = 'px-2.5 py-1 rounded-[5px] bg-white shadow-sm text-[#1C1C1E] font-medium transition cursor-pointer flex items-center gap-1.5';
                if (tableBtn) tableBtn.className = 'px-2.5 py-1 rounded-[5px] text-[#8E8E93] hover:text-[#1C1C1E] transition cursor-pointer flex items-center gap-1.5';
                if (gridSvg) gridSvg.className = 'w-3.5 h-3.5 text-[#1C1C1E]';
                if (tableSvg) tableSvg.className = 'w-3.5 h-3.5 text-[#8E8E93]';
            }
        }

        function setViewMode(mode) {
            const container = document.getElementById('queues-container');
            if (!container) return;

            if (window.innerWidth >= 768) {
                userPreferredViewMode = mode;
            }
            if (mode === 'table') {
                container.classList.remove('queue-view-grid');
                container.classList.add('queue-view-table');
                updateSegmentedButtons('table');
            } else if (mode === 'grid') {
                container.classList.remove('queue-view-table');
                container.classList.add('queue-view-grid');
                updateSegmentedButtons('grid');
            }
        }

        function syncResponsiveView() {
            const isMobile = window.innerWidth < 768;
            const container = document.getElementById('queues-container');
            if (!container) return;

            if (isMobile) {
                // On mobile screen sizes (< 768px), cards are displayed automatically
                updateSegmentedButtons('grid');
            } else {
                // Restore user desktop preference
                setViewMode(userPreferredViewMode);
            }
        }

        window.addEventListener('resize', syncResponsiveView);

        // Unified Filter State (Search + Priority + Available Area)
        let currentPriorityFilter = 'ALL';
        let currentSearchQuery = '';
        let currentAvailableAreaFilter = 'ALL';

        function applyFilters() {
            const rows = document.querySelectorAll('[data-ticket-row]');
            rows.forEach(r => {
                const searchableText = `${r.textContent} ${r.dataset.ticketSender || ''} ${r.dataset.ticketOrigin || ''} ${r.dataset.ticketCode || ''}`.toLowerCase();
                const pts = parseInt(r.dataset.ticketPts || '0', 10);
                const prioCode = r.dataset.ticketPriorityCode || 'NONE';
                const ticketArea = r.dataset.ticketArea || 'GENERAL';
                const queueId = r.dataset.ticketQueue;

                const matchesSearch = !currentSearchQuery || searchableText.includes(currentSearchQuery);
                
                let matchesPriority = true;
                if (currentPriorityFilter === 'HIGH') {
                    matchesPriority = pts >= 5;
                } else if (currentPriorityFilter === 'P1') {
                    matchesPriority = prioCode === 'P1';
                } else if (currentPriorityFilter === 'P2') {
                    matchesPriority = prioCode === 'P2';
                }

                // Available area filter specifically applies to tickets in the 'available' queue
                let matchesArea = true;
                if (queueId === 'available' && currentAvailableAreaFilter !== 'ALL') {
                    matchesArea = ticketArea === currentAvailableAreaFilter;
                }

                r.style.display = (matchesSearch && matchesPriority && matchesArea) ? '' : 'none';
            });

            // Toggle empty state for filtered queues
            const sections = document.querySelectorAll('.queue-section');
            sections.forEach(sec => {
                const tableRows = sec.querySelectorAll('tbody tr[data-ticket-row]');
                const visibleTableRows = Array.from(tableRows).filter(tr => tr.style.display !== 'none');
                const emptyRow = sec.querySelector('tr[data-filter-empty]');
                if (emptyRow && tableRows.length > 0) {
                    if (visibleTableRows.length === 0) {
                        emptyRow.classList.remove('hidden');
                    } else {
                        emptyRow.classList.add('hidden');
                    }
                }

                const gridCards = sec.querySelectorAll('.queue-grid-container article[data-ticket-row]');
                const visibleGridCards = Array.from(gridCards).filter(c => c.style.display !== 'none');
                const emptyGrid = sec.querySelector('[data-filter-empty-grid]');
                if (emptyGrid && gridCards.length > 0) {
                    if (visibleGridCards.length === 0) {
                        emptyGrid.classList.remove('hidden');
                    } else {
                        emptyGrid.classList.add('hidden');
                    }
                }
            });
        }

        function onSearchInput(query) {
            currentSearchQuery = (query || '').toLowerCase().trim();
            applyFilters();
        }

        // Available Tickets Area Filter
        function filterAvailableByArea(areaKey, buttonEl) {
            currentAvailableAreaFilter = areaKey;
            const chips = document.querySelectorAll('#availableAreaChips .area-chip');
            chips.forEach(c => {
                c.className = 'area-chip px-2.5 py-1 rounded-[6px] bg-[#F5F5F7] hover:bg-[#EBEBF0] text-[#1C1C1E] border border-black/5 text-[11px] font-medium transition cursor-pointer';
            });
            if (buttonEl) {
                buttonEl.className = 'area-chip active-area-chip px-2.5 py-1 rounded-[6px] bg-[#007AFF] text-white text-[11px] font-medium shadow-sm transition cursor-pointer';
            }
            applyFilters();
        }

        // Keyboard Shortcut ⌘K / Ctrl+K
        window.addEventListener('keydown', e => {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                const searchInput = document.getElementById('globalSearchInput');
                if (searchInput) {
                    searchInput.focus();
                    searchInput.select();
                }
            }
        });

        // Quick Priority Filter
        function filterByPriorityLocal(level) {
            currentPriorityFilter = level;
            applyFilters();

            const btnAll = document.getElementById('filterBtnAll');
            const btnHigh = document.getElementById('filterBtnHigh');
            const btnP1 = document.getElementById('filterBtnP1');
            const btnP2 = document.getElementById('filterBtnP2');

            const inactiveBtn = 'px-2.5 py-1 rounded-[6px] bg-[#F5F5F7] hover:bg-[#EBEBF0] text-[#1C1C1E] border border-black/5 text-[11px] font-medium transition cursor-pointer';
            const activeBtn = 'px-2.5 py-1 rounded-[6px] bg-[#007AFF] text-white text-[11px] font-medium shadow-sm transition cursor-pointer';

            if (btnAll) btnAll.className = level === 'ALL' ? activeBtn : inactiveBtn;
            if (btnHigh) btnHigh.className = level === 'HIGH' ? activeBtn : inactiveBtn;
            if (btnP1) btnP1.className = level === 'P1' ? (activeBtn + ' flex items-center gap-1') : (inactiveBtn + ' flex items-center gap-1');
            if (btnP2) btnP2.className = level === 'P2' ? (activeBtn + ' flex items-center gap-1') : (inactiveBtn + ' flex items-center gap-1');
        }

        // Close details dropdown when clicking outside
        document.addEventListener('click', e => {
            document.querySelectorAll('details[open]').forEach(details => {
                if (!details.contains(e.target)) {
                    details.removeAttribute('open');
                }
            });
        });

        // ==========================================
        // Ticket Details Modal Logic
        // ==========================================
        function openTicketDetails(ticketCode) {
            const el = document.querySelector(`[data-ticket-row][data-ticket-code="${ticketCode}"]`);
            if (!el) return;

            const code = el.dataset.ticketCode;
            const status = el.dataset.ticketStatus || 'NUEVO';
            const queue = el.dataset.ticketQueue;
            const prioCode = el.dataset.ticketPriorityCode || 'NONE';
            const pts = el.dataset.ticketPts || '0';
            const unassigned = queue === 'available';

            document.getElementById('modalDetailCode').textContent = code;
            document.getElementById('modalDetailSubject').textContent = el.dataset.ticketSubject || 'Sin asunto';
            document.getElementById('modalDetailDescription').textContent = el.dataset.ticketDescription || 'Sin descripción registrada.';
            document.getElementById('modalDetailArea').textContent = el.dataset.ticketAreaLabel || 'Operaciones IP';
            document.getElementById('modalDetailAssigned').textContent = unassigned ? 'Sin asignar' : 'Ti';
            document.getElementById('modalDetailSender').textContent = el.dataset.ticketSender || '—';
            document.getElementById('modalDetailOrigin').textContent = el.dataset.ticketOrigin || 'Correo';
            document.getElementById('modalDetailCreated').textContent = el.dataset.ticketCreated || 'Fecha no disponible';
            document.getElementById('modalDetailPts').textContent = `${pts} pts`;

            // Prioridad y estado con los colores del tema (claro u oscuro)
            const PRIO = {
                P1: ['P1', 'var(--red-bg)', 'var(--red-t)', '#EF4444'],
                P2: ['P2', 'var(--orange-bg)', 'var(--orange-t)', '#F59E0B'],
                P3: ['P3', 'var(--fill)', 'var(--t2)', '#94A3B8'],
                NONE: ['Sin prioridad', 'var(--fill)', 'var(--t2)', 'transparent']
            }[prioCode] || ['Sin prioridad', 'var(--fill)', 'var(--t2)', 'transparent'];
            const prioBadge = document.getElementById('modalDetailPriorityBadge');
            prioBadge.style.background = PRIO[1];
            prioBadge.style.color = PRIO[2];
            prioBadge.textContent = '';
            const dot = document.createElement('span');
            dot.className = 'dot';
            dot.style.background = PRIO[3];
            if (PRIO[3] === 'transparent') dot.style.boxShadow = 'inset 0 0 0 1px var(--t3)';
            prioBadge.append(dot, `${PRIO[0]} · ${pts} pts`);

            const STATUS = {
                NUEVO: unassigned ? ['Sin asignar', 'var(--fill)', 'var(--t2)'] : ['Asignado a ti · sin empezar', 'var(--purple-bg)', 'var(--purple-t)'],
                EN_PROGRESO: ['En atención', 'var(--accent-bg)', 'var(--accent-t)'],
                EN_PAUSA: ['En pausa', 'var(--orange-bg)', 'var(--orange-t)'],
                EN_ESPERA_TERCEROS: ['Espera de terceros', 'var(--purple-bg)', 'var(--purple-t)'],
                RESUELTO: ['Pendiente de cierre', 'var(--orange-bg)', 'var(--orange-t)'],
                CERRADO: ['Cerrado', 'var(--green-bg)', 'var(--green-t)']
            }[status] || [status, 'var(--fill)', 'var(--t2)'];
            const statusBadge = document.getElementById('modalDetailStatusBadge');
            statusBadge.textContent = STATUS[0];
            statusBadge.style.background = STATUS[1];
            statusBadge.style.color = STATUS[2];

            // Acciones del ticket (mismo manejador que en la lista: data-ticket-action)
            const actionContainer = document.getElementById('modalDetailActionContainer');
            actionContainer.innerHTML = '';
            const feedback = document.getElementById('modalDetailFeedback');
            feedback.textContent = '';
            feedback.classList.add('hidden');

            const addAction = (label, cls, action, targetStatus) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `td-btn ${cls}`;
                btn.setAttribute('data-ticket-action', action);
                btn.setAttribute('data-ticket-code', code);
                if (targetStatus) btn.setAttribute('data-ticket-status', targetStatus);
                const span = document.createElement('span');
                span.className = 'figma-button__label';
                span.textContent = label;
                btn.appendChild(span);
                actionContainer.appendChild(btn);
            };
            if (queue === 'available' || (queue === 'assigned' && status === 'NUEVO')) {
                addAction(unassigned ? 'Tomar' : 'Empezar', 'p', 'claim');
            } else if (queue === 'assigned') {
                addAction('Pausar', 's', 'status', 'EN_PAUSA');
                addAction('Resolver', 'g', 'status', 'CERRADO');
            } else if (queue === 'paused' || queue === 'waiting') {
                addAction('Reanudar', 'p', 'status', 'EN_PROGRESO');
                addAction('Resolver', 'g', 'status', 'CERRADO');
            }

            const overlay = document.getElementById('ticketDetailsOverlay');
            overlay.classList.remove('hidden');
            if (window.TicketConversacion) window.TicketConversacion.abrir(code);
            const closeBtn = overlay.querySelector('.tdlg-x');
            if (closeBtn) closeBtn.focus();
        }

        function closeTicketDetailsModal() {
            const overlay = document.getElementById('ticketDetailsOverlay');
            if (overlay && !overlay.classList.contains('hidden')) {
                overlay.classList.add('hidden');
                if (window.TicketConversacion) window.TicketConversacion.cerrar();
            }
        }

        function handleTicketDetailsBackdrop(event) {
            if (event.target === document.getElementById('ticketDetailsOverlay')) {
                closeTicketDetailsModal();
            }
        }

        document.addEventListener('keydown', e => {
            // Escape no descarta un mensaje a medio escribir
            if (e.key === 'Escape' && !(e.target && e.target.id === 'tdText' && e.target.value.trim())) {
                closeTicketDetailsModal();
            }
        });

        // ==========================================
        // Ticket Action Handlers (Tomar, Pausar, Resolver, Reanudar)
        // With Global Concurrency Lock to Prevent Race Conditions
        // ==========================================
        let isActionInProgress = false;

        document.addEventListener('click', async event => {
            const button = event.target.closest('[data-ticket-action]');
            if (!button || button.disabled) return;

            // Prevent rapid-click race condition across multiple tickets
            if (isActionInProgress) return;
            isActionInProgress = true;

            const row = button.closest('[data-ticket-row]');
            const feedback = row ? row.querySelector('[data-ticket-feedback]') : document.getElementById('modalDetailFeedback');
            const allActionButtons = Array.from(document.querySelectorAll('button[data-ticket-action]'));
            const ticketCode = button.dataset.ticketCode;
            const action = button.dataset.ticketAction;

            // Preserve original labels for all buttons
            const originalLabels = allActionButtons.map(control => {
                const labelSpan = control.querySelector('.figma-button__label');
                return labelSpan ? labelSpan.textContent.trim() : control.textContent.trim();
            });

            // Temporarily disable all action buttons
            allActionButtons.forEach(control => { control.disabled = true; });
            if (feedback) {
                feedback.textContent = '';
                feedback.classList.add('hidden');
            }

            const targetLabel = button.querySelector('.figma-button__label') || button;
            targetLabel.textContent = action === 'claim' ? 'Tomando…' : 'Actualizando…';

            try {
                const url = `/api/tickets/${encodeURIComponent(ticketCode)}/${action === 'claim' ? 'claim' : 'status'}`;
                const options = action === 'claim'
                    ? { method: 'POST' }
                    : {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ status: button.dataset.ticketStatus })
                    };
                const response = await fetch(url, options);
                let result = {};
                try {
                    result = await response.json();
                } catch (error) {
                    result = {};
                }
                if (!response.ok || !result.success) {
                    throw new Error(result.message || result.error || 'No se pudo actualizar el ticket.');
                }
                window.location.reload();
            } catch (error) {
                isActionInProgress = false;
                if (feedback) {
                    feedback.textContent = error.message || 'No se pudo completar la acción. Inténtalo de nuevo.';
                    feedback.classList.remove('hidden');
                } else {
                    alert(error.message || 'No se pudo completar la acción. Inténtalo de nuevo.');
                }
                allActionButtons.forEach((control, index) => {
                    control.disabled = false;
                    const labelSpan = control.querySelector('.figma-button__label') || control;
                    labelSpan.textContent = originalLabels[index];
                });
            }
        });

        // ==========================================
        // Real-Time Sync & Polling Engine
        // ==========================================
        let realtimePollingTimer = null;

        function getTicketFingerprint(root) {
            const rows = Array.from((root || document).querySelectorAll('tr[data-ticket-row]'));
            return rows.map(r => `${r.dataset.ticketCode || ''}:${r.dataset.ticketStatus || ''}:${r.dataset.ticketQueue || ''}`).sort().join('|');
        }

        let initialTicketFingerprint = '';
        if (typeof document !== 'undefined') {
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => {
                    initialTicketFingerprint = getTicketFingerprint(document);
                });
            } else {
                initialTicketFingerprint = getTicketFingerprint(document);
            }
        }

        function manualRefresh() {
            const icon = document.getElementById('refreshIcon');
            if (icon) icon.classList.add('animate-spin');
            window.location.reload();
        }

        async function checkRealtimeUpdates() {
            // Do not disrupt operator if details modal is open, action in progress, or tab is hidden
            if (document.hidden || isActionInProgress) return;
            const modal = document.getElementById('ticketDetailsOverlay');
            if (modal && !modal.classList.contains('hidden')) return;

            try {
                const res = await fetch(window.location.pathname + window.location.search, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    cache: 'no-store'
                });
                if (!res.ok) return;

                const html = await res.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');

                const newFingerprint = getTicketFingerprint(doc);
                if (newFingerprint && initialTicketFingerprint && newFingerprint !== initialTicketFingerprint) {
                    // Data changed on server! Refresh view smoothly
                    window.location.reload();
                } else {
                    const badge = document.getElementById('realtimeStatusText');
                    if (badge) badge.textContent = 'En tiempo real';
                }
            } catch (err) {
                // Silently skip on network hiccups
            }
        }

        function startRealtimeSync() {
            // WebSocket / Socket.io Auto-Discovery
            if (typeof io !== 'undefined') {
                try {
                    const socket = io();
                    socket.on('connect', () => {
                        const badge = document.getElementById('realtimeStatusText');
                        if (badge) badge.textContent = 'En vivo (Socket)';
                    });
                    const socketEvents = ['ticket_updated', 'ticket_assigned', 'ticket_created', 'ticket_status_changed', 'new_ticket'];
                    socketEvents.forEach(evt => {
                        socket.on(evt, () => {
                            if (!document.hidden && !isActionInProgress) {
                                const modal = document.getElementById('ticketDetailsOverlay');
                                if (!modal || modal.classList.contains('hidden')) {
                                    window.location.reload();
                                }
                            }
                        });
                    });
                } catch (e) {
                    // Fall back to robust polling below
                }
            }

            // Polling every 20 seconds
            if (realtimePollingTimer) clearInterval(realtimePollingTimer);
            realtimePollingTimer = setInterval(checkRealtimeUpdates, 20000);

            // Resync immediately when tab becomes visible again
            document.addEventListener('visibilitychange', () => {
                if (!document.hidden) {
                    checkRealtimeUpdates();
                }
            });
        }
    </script>
</body>
</html>