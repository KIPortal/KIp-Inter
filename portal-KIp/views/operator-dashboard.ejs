            </div>

            <div class="flex items-center gap-3">
                <!-- Manual refresh button -->
                <button id="manualRefreshBtn" type="button" onclick="manualRefresh()" title="Actualizar datos ahora" class="w-7 h-7 rounded-[7px] bg-[#F5F5F7] hover:bg-[#EBEBF0] text-[#636366] hover:text-[#1C1C1E] border border-[#D1D1D6] flex items-center justify-center transition cursor-pointer">
                    <svg id="refreshIcon" class="w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                </button>

                <div class="figma-toolbars-search__search !w-auto relative hidden sm:flex bg-[#F5F5F7] border border-[#D1D1D6] rounded-[7px] transition focus-within:bg-white focus-within:border-[#007AFF]">
