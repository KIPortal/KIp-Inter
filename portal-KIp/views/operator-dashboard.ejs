                                                <td class="finder-th py-3 px-4 text-right">
                                                    <div class="flex items-center justify-end gap-1.5">
                                                        <!-- View Details Button -->
                                                        <button type="button" onclick="openTicketDetails('<%= ticket.codigo_incidencia %>')" class="figma-button !w-auto !h-[26px] !px-2 bg-white border border-[#D1D1D6] hover:bg-[#F2F2F7] text-[#1C1C1E] rounded-[6px] shadow-sm transition cursor-pointer" title="Ver detalles antes de tomar">
                                                            <span class="figma-button__label text-[#1C1C1E] !text-[11px] font-medium flex items-center gap-1">
                                                                <svg class="w-3 h-3 text-[#636366]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                                                <span>Detalles</span>
                                                            </span>
                                                        </button>

                                                    <% if (queue.id === 'available') { %>
