<%
	// Administración (prototipo docs/rediseno/prototipo/Administracion.dc.html).
	// Áreas y equipos se dibujan aquí; reglas, plantillas y avisos los dibuja
	// public/js/admin.js con la configuración guardada y la vista previa.
	const totalOps = areas.reduce((n, a) => n + a.operadores.length, 0);
	const conOps = areas.filter(a => a.operadores.length);
	const coordinadores = typeof locals.coordinadores !== 'undefined' ? locals.coordinadores : [];
	const miId = locals.miId || null;
	const desactivados = locals.desactivados || [];
	const minClave = locals.minClave || 8;
	const miRol = locals.miRol || null;
	const ROL_TXT = { OPERADOR: 'Operador', COORDINADOR: 'Coordinador', JEFE: 'Jefe de área', GERENTE: 'Gerente' };
	const nombreArea = c => (areas.find(a => a.codigo === c) || {}).nombre || c;
	const usuarios = areas.flatMap(a => a.operadores.map(o => ({ id: o.id, nombre: o.nombre, email: o.email, rol: 'OPERADOR', area: o.area, telefono: o.telefono || '', subgrupo: o.subgrupo || '' })))
		.concat(coordinadores.map(c => ({ id: c.id, nombre: c.nombre, email: c.email, rol: c.rol || 'COORDINADOR', area: c.area_designada || 'GENERAL', atiende: c.atiende_tickets === true, telefono: c.telefono || '', subgrupo: c.subgrupo_id || '' })))
		.map(u => Object.assign(u, { activo: true }))
		.concat(desactivados.map(u => Object.assign({}, u, { activo: false })));
	const datos = { config, eventos, destinatarios, limites, vistaPrevia, usuarios, areas: areas.map(a => ({ codigo: a.codigo, nombre: a.nombre, activa: a.activa !== false, operadores: a.operadores.length, subgrupos: a.subgrupos || [] })), miId, miRol, daRolesAltos: locals.daRolesAltos === true || miRol === 'GERENTE', minClave, tiposCaso: locals.tiposCaso || [], niveles: locals.niveles || null, buzones: locals.buzones || [], correoModo: locals.correoModo || 'aplicacion' };
	const ini = n => String(n || '?').split(/\s+/).slice(0, 2).map(p => p[0]).join('').toUpperCase();
	const lapiz = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z"/></svg>';
	const SECS = [
		['areas', 'Áreas y equipos', areas.length + ' áreas · ' + totalOps + ' operadores', 'var(--tile-blue)', 'M9 8a3 3 0 1 0 0-.01M3 19a6 6 0 0 1 12 0M16 5a3 3 0 0 1 0 6M18 13a5 5 0 0 1 3 6'],
		['tipos', 'Tipos de caso', (locals.tiposCaso || []).filter(t => t.activo).length + ' casos comunes · nivel y puntos', 'var(--tile-green)', 'M4 6h16M4 12h10M4 18h7M17 15l2 2 3-4'],
		['buzones', 'Buzones de correo', (locals.buzones || []).filter(b => b.activo && !b.eliminadoEn).length + ' activos · área de cada buzón', 'var(--tile-blue)', 'M3 6h18v12H3zM3 7l9 6 9-6'],
		['plantillas', 'Plantillas', (config.plantillas.traspaso.length + config.plantillas.cierre.length) + ' textos', 'var(--tile-orange)', 'M5 4h10l4 4v12H5zM9 12h6M9 16h4'],
		['reglas', 'Reglas de alerta', 'Sobrecarga, antigüedad y sugerencia', 'var(--tile-red)', 'M12 3l10 18H2zM12 10v4M12 17.5v.5'],
		['avisos', 'Avisos', 'Eventos y destinatarios', 'var(--tile-purple)', 'M6 16V11a6 6 0 0 1 12 0v5l2 2H4zM10 21h4']
	];
%>
<!DOCTYPE html>
<html lang="es">
<head>
	<%- include('partials/head', { titulo: 'Administración' }) %>
</head>
<body>
<div class="app">
	<%- include('partials/sidebar', { currentUser, activo: 'admin', conteos: { tickets: activos, enTurno, totalOperadores } }) %>

	<main class="app-main">
		<header class="toolbar">
			<div style="display:flex;flex-direction:column;margin-right:6px">
				<h1>Administración</h1>
				<span class="sub">Áreas, tipos de caso, buzones, plantillas, reglas de alerta y avisos</span>
			</div>
			<span class="grow"></span>
			<span class="dirty" data-dirty hidden><i></i>Cambios sin guardar</span>
			<button type="button" class="pill pillbtn plain" data-discard hidden style="height:36px">Descartar</button>
			<button type="button" class="primary lg" data-save hidden>Guardar cambios</button>
		</header>

		<div class="admin-layout">
			<nav class="glass admin-nav" aria-label="Secciones de administración">
				<% SECS.forEach(([k, l, sub, tile, glyph], i) => { %>
					<button type="button" data-sec="<%= k %>" aria-current="<%= i === 0 ? 'page' : 'false' %>">
						<span class="tile" style="background:<%= tile %>"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" class="on-solid" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= glyph %>"/></svg></span>
						<span class="txt"><b><%= l %></b><span data-sec-sub="<%= k %>"><%= sub %></span></span>
					</button>
				<% }) %>
			</nav>

			<div class="admin-body">
				<!-- Áreas y equipos -->
				<section class="glass" data-panel="areas" aria-labelledby="h-ar" style="display:flex;flex-direction:column;overflow:hidden">
					<div class="card-head" style="padding:18px 24px 14px">
						<h2 id="h-ar">Áreas y equipos</h2>
						<span class="hint"><%= areas.length %> áreas · <%= totalOps %> operadores · <%= coordinadores.length %> en coordinación</span>
						<span class="grow"></span>
						<button type="button" class="pill pillbtn plain" style="height:30px;font-size:12px" data-area-new>＋ Nueva área</button>
					</div>
					<div class="areas-split">
						<div class="area-list" role="listbox" aria-label="Áreas">
							<% areas.forEach((a, i) => { %>
								<button type="button" role="option" data-area-pick="<%= a.codigo %>" aria-selected="<%= a.codigo === (conOps[0] || areas[0]).codigo %>">
									<b><%= a.nombre %><% if (a.activa === false) { %> <span class="tag gray">Desactivada</span><% } %></b><span class="n"><%= a.operadores.length %></span>
									<span class="meta"><span><i class="st-turno"></i><%= a.turno %> en turno</span><% if (a.guardia) { %><span><i class="st-guardia"></i><%= a.guardia %> de guardia</span><% } %></span>
								</button>
							<% }) %>
							<% if (desactivados.length) { %>
							<button type="button" role="option" data-area-pick="__off" aria-selected="false">
								<b>Usuarios desactivados</b><span class="n"><%= desactivados.length %></span>
								<span class="meta"><span>No entran ni reciben tickets</span></span>
							</button>
							<% } %>
							<button type="button" role="option" data-area-pick="__coord" aria-selected="false">
								<b>Coordinación y jefaturas</b><span class="n"><%= coordinadores.length %></span>
								<span class="meta"><span>Coordinadores, jefes y gerencia</span></span>
							</button>
						</div>
						<div class="area-detail">
							<% areas.forEach(a => { %>
								<div data-area-panel="<%= a.codigo %>"<% if (a.codigo !== (conOps[0] || areas[0]).codigo) { %> hidden<% } %>>
									<div style="display:flex;align-items:center;gap:10px;padding:16px 24px 12px"><span style="display:flex;flex-direction:column;flex:1"><b style="font-size:15px"><%= a.nombre %></b><span class="t2" style="font-size:12px"><%= a.operadores.length %> <%= a.operadores.length === 1 ? 'operador' : 'operadores' %> · <%= a.turno %> en turno<%= a.guardia ? ' · ' + a.guardia + ' de guardia' : '' %><% const sgs = (a.subgrupos || []).filter(g => g.activo); if (sgs.length) { %> · Subgrupos: <%= sgs.map(g => g.nombre).join(', ') %><% } %></span></span>
										<button type="button" class="pill pillbtn plain" style="height:30px;padding:0 14px;font-size:12px" data-area-edit="<%= a.codigo %>">Editar área</button>
										<% if (a.codigo !== 'GENERAL' && a.activa !== false) { %><button type="button" class="pill pillbtn plain" style="height:30px;padding:0 14px;font-size:12px" data-area-edit="<%= a.codigo %>" data-focus-subgrupo>＋ Subgrupo</button><% } %>
										<% if (a.activa !== false) { %><button type="button" class="primary" style="height:30px;padding:0 14px;font-size:12px" data-user-new="<%= a.codigo %>">＋ Agregar operador</button><% } %></div>
									<% if (!a.operadores.length) { %>
										<p class="empty" style="padding:4px 24px 12px">Esta área no tiene operadores.</p>
									<% } else { %>
									<table class="rank-table">
										<thead><tr><th style="padding-left:24px">Operador</th><th style="width:150px">Estado de turno</th><th class="r" style="width:70px">Activos</th><th style="width:56px;padding-right:24px"><span class="sr-only">Acciones</span></th></tr></thead>
										<tbody>
											<% a.operadores.forEach(o => { %>
												<tr class="row">
													<td style="padding-left:24px"><span style="display:flex;align-items:center;gap:10px"><span class="avatar"><%= o.nombre.split(/\s+/).slice(0, 2).map(p => p[0]).join('').toUpperCase() %></span><span style="display:flex;flex-direction:column"><b style="font-size:13px"><%= o.nombre %><% if (o.subgrupoNombre) { %> <span class="t2" style="font-weight:500">· <%= o.subgrupoNombre %></span><% } %></b><span class="t2"><%= o.email %></span></span></span></td>
													<td><span class="opstate st-<%= o.estado.grupo %>" style="font-weight:500"><i></i><%= o.estado.etiqueta %></span></td>
													<td class="r" style="font-weight:600"><%= o.carga %></td>
													<td style="padding-right:24px;text-align:right"><button type="button" class="ico" data-user-edit="<%= o.id %>" title="Editar" aria-label="Editar <%= o.nombre %>"><%- lapiz %></button></td>
												</tr>
											<% }) %>
										</tbody>
									</table>
									<% } %>
								</div>
							<% }) %>
							<div data-area-panel="__off" hidden>
								<div style="display:flex;flex-direction:column;padding:16px 24px 12px"><b style="font-size:15px">Usuarios desactivados</b><span class="t2" style="font-size:12px">Edita uno para reactivarlo; su historial se conserva</span></div>
								<table class="rank-table">
									<thead><tr><th style="padding-left:24px">Usuario</th><th style="width:140px">Rol</th><th style="width:56px;padding-right:24px"><span class="sr-only">Acciones</span></th></tr></thead>
									<tbody>
										<% desactivados.forEach(u => { %>
											<tr class="row">
												<td style="padding-left:24px"><span style="display:flex;align-items:center;gap:10px"><span class="avatar sys"><%= ini(u.nombre) %></span><span style="display:flex;flex-direction:column"><b style="font-size:13px"><%= u.nombre %></b><span class="t2"><%= u.email %></span></span></span></td>
												<td class="t2"><%= ROL_TXT[u.rol] || u.rol %></td>
												<td style="padding-right:24px;text-align:right"><button type="button" class="ico" data-user-edit="<%= u.id %>" title="Editar" aria-label="Editar <%= u.nombre %>"><%- lapiz %></button></td>
											</tr>
										<% }) %>
									</tbody>
								</table>
							</div>
							<div data-area-panel="__coord" hidden>
								<div style="display:flex;align-items:center;gap:10px;padding:16px 24px 12px"><span style="display:flex;flex-direction:column;flex:1"><b style="font-size:15px">Coordinación y jefaturas</b><span class="t2" style="font-size:12px">El coordinador y el gerente ven todas las áreas; el jefe, solo la suya<%= miRol === 'GERENTE' ? '' : (locals.daRolesAltos ? '. Aún no hay gerente: nombra al primero con “Editar” o “＋ Agregar”' : '. Solo el gerente da los roles Jefe y Gerente') %></span></span>
									<button type="button" class="primary" style="height:30px;padding:0 14px;font-size:12px" data-user-new="__coord">＋ Agregar</button></div>
								<table class="rank-table">
									<thead><tr><th style="padding-left:24px">Persona</th><th style="width:180px">Rol</th><th style="width:56px;padding-right:24px"><span class="sr-only">Acciones</span></th></tr></thead>
									<tbody>
										<% coordinadores.forEach(c => { %>
											<tr class="row">
												<td style="padding-left:24px"><span style="display:flex;align-items:center;gap:10px"><span class="avatar"><%= ini(c.nombre) %></span><span style="display:flex;flex-direction:column"><b style="font-size:13px"><%= c.nombre %><%= c.id === miId ? ' (tú)' : '' %></b><span class="t2"><%= c.email %></span></span></span></td>
												<td class="t2"><%= ROL_TXT[c.rol] || 'Coordinador' %><%= c.rol === 'JEFE' ? ' · ' + nombreArea(c.area_designada) : '' %></td>
												<td style="padding-right:24px;text-align:right"><button type="button" class="ico" data-user-edit="<%= c.id %>" title="Editar" aria-label="Editar <%= c.nombre %>"><%- lapiz %></button></td>
											</tr>
										<% }) %>
									</tbody>
								</table>
							</div>
							<p class="t3" style="padding:12px 24px 16px;font-size:12px;margin:0">El estado de turno y la guardia se cambian en Gestión de Turno. Las claves de usuarios nuevos son temporales: se guardan sin cifrar hasta activar la seguridad del login.</p>
						</div>
					</div>
				</section>

				<section class="glass" data-panel="tipos" hidden aria-label="Tipos de caso" style="display:flex;flex-direction:column;overflow:hidden"></section>
				<section class="glass" data-panel="buzones" hidden aria-label="Buzones de correo" style="display:flex;flex-direction:column;overflow:hidden"></section>
				<div data-panel="plantillas" hidden style="display:flex;flex-direction:column;gap:16px"></div>
				<div data-panel="reglas" hidden style="display:flex;flex-direction:column;gap:16px"></div>
				<section class="glass" data-panel="avisos" hidden style="display:flex;flex-direction:column;overflow:hidden"></section>
			</div>
		</div>
	</main>
</div>

<script id="admin-data" type="application/json"><%- JSON.stringify(datos).replace(/</g, '\\u003c') %></script>
<script src="/js/admin.js?v=<%= locals.v || 1 %>" defer></script>
</body>
</html>
