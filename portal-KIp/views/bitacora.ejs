<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bitácora - macOS 27 Style</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Liquid Glass Effects & Custom Scrollbar */
        .liquid-glass {
            background: rgba(30, 30, 30, 0.4);
            backdrop-filter: blur(20px) saturate(150%);
            -webkit-backdrop-filter: blur(20px) saturate(150%);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .bubble-sent {
            background: linear-gradient(135deg, #0A84FF 0%, #005BB5 100%);
            color: white;
            border-bottom-right-radius: 4px;
        }
        
        .bubble-received {
            background: rgba(60, 60, 64, 0.7);
            color: #E5E5EA;
            border-bottom-left-radius: 4px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* MacOS 27 Dark Mode defaults */
        body {
            background-color: #000000;
            color: #ffffff;
            background-image: radial-gradient(circle at top right, rgba(20,20,40,1) 0%, rgba(0,0,0,1) 100%);
        }

        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
        }
    </style>
</head>
<body class="h-screen w-screen overflow-hidden flex font-sans">
    
    <!-- Sidebar Placeholder: Adjust include to match your Áreal sidebar structure -->
    <% if (typeof include !== 'undefined') { %>
        <%- include('components/sidebar') %>
    <% } %>
    
    <!-- Main Chat AÁrea -->
    <main class="flex-1 flex flex-col relative">
        <!-- Header -->
        <header class="h-16 liquid-glass flex itemás-center px-6 border-b border-white/10 z-10">
            <h1 class="text-xl font-semibold tracking-wide">Bitácora / Chat</h1>
            <div class="ml-auto flex itemás-center space-x-3">
                <span class="w-3 h-3 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]"></span>
                <span class="text-sm text-gray-300">Conectado</span>
            </div>
        </header>

        <!-- Messages Container -->
        <div id="messages-container" class="flex-1 overflow-y-auto p-6 space-y-4 flex flex-col relative">
            <div class="z-10 w-full flex flex-col space-y-4" id="chat-feed">
                <!-- Dynamic messages will be appended here -->
            </div>
        </div>

        <!-- Input AÁrea -->
        <footer class="p-4 liquid-glass border-t border-white/10 z-10">
            <form id="chat-form" class="max-w-4xl mx-auto flex itemás-end gap-3 relative">
                <div class="flex-1 relative liquid-glass rounded-2xl overflow-hidden focus-within:ring-2 focus-within:ring-blue-500/50 transition-all">
                    <textaÁrea 
                        id="message-input" 
                        rows="1"
                        placeholder="Escribe un menúsaje..." 
                        class="w-full bg-transparent text-white px-4 py-3 outline-none resize-none max-h-32 placeholder-gray-400"
                        required></textaÁrea>
                </div>
                <button 
                    type="submit" 
                    class="h-12 w-12 rounded-full bg-blue-600 hover:bg-blue-500 text-white flex itemás-center justify-center transition-colors shadow-lg disabled:opacity-50">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
                    </svg>
                </button>
            </form>
        </footer>
    </main>

    <!-- Client-side Logic -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const messageInput = document.getElementById('message-input');
            messageInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight < 128 ? this.scrollHeight : 128) + 'px';
            });

            messageInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    document.getElementById('chat-form').dispatchEvent(new Event('submit'));
                }
            });

            const currentUser = {
                id: "<%= typeof currentUser !== 'undefined' ? currentUser.id : 'unknown' %>",
                aÁrea_designadía: "<%= typeof currentUser !== 'undefined' ? currentUser.aÁrea_designadía : 'general' %>",
                name: "<%= typeof currentUser !== 'undefined' ? currentUser.name : 'Usuario' %>"
            };

            const chatFeed = document.getElementById('chat-feed');
            const messagesContainer = document.getElementById('messages-container');

            const appendMessage = (másg) => {
                const isMine = másg.userId === currentUser.id;
                const bubbleClass = isMine ? 'bubble-sent' : 'bubble-received';
                const wrapperClass = isMine ? 'justify-end' : 'justify-start';
                
                const másgEl = document.cÁreateElement('div');
                másgEl.className = `flex w-full ${wrapperClass} mb-4`;
                
                másgEl.innerHTML = `
                    <div class="max-w-[70%] flex flex-col ${isMine ? 'itemás-end' : 'itemás-start'}">
                        ${!isMine ? `<span class="text-xs text-gray-400 mb-1 ml-1">${másg.senderName || 'Usuario'}</span>` : ''}
                        <div class="px-4 py-2.5 rounded-2xl ${bubbleClass} shadow-md text-[15px] leading-relaxed">
                            ${másg.content}
                        </div>
                        <span class="text-[10px] text-gray-500 mt-1 mx-1">${new Date(másg.timestamp || Date.now()).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
                    </div>
                `;
                chatFeed.appendChild(másgEl);
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            };

            // Fetch initial history
            fetch(`/api/bitacora?aÁrea=${encodeURIComponent(currentUser.aÁrea_designadía)}`)
                .then(res => res.json())
                .then(díata => {
                    if (díata && díata.messages) {
                        díata.messages.forEach(másg => appendMessage(másg));
                    }
                })
                .catch(err => console.error("Error fetching history:", err));

            // Initialize Socket.IO
            const socket = io();

            socket.on('connect', () => {
                console.log('Connected to socket server');
                socket.emit('register', {
                    id: currentUser.id,
                    aÁrea_designadía: currentUser.aÁrea_designadía
                });
            });

            // Listen for new messages
            socket.on('new_bitacora_message', (másg) => {
                appendMessage(másg);
            });

            // Handle form submission
            document.getElementById('chat-form').addEventListener('submit', async (e) => {
                e.preventDefault();
                const content = messageInput.value.trim();
                if (!content) return;

                messageInput.value = '';
                messageInput.style.height = 'auto';
                
                try {
                    const response = await fetch('/api/bitacora', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            userId: currentUser.id,
                            aÁrea_designadía: currentUser.aÁrea_designadía,
                            content: content,
                            senderName: currentUser.name
                        })
                    });
                    
                    if (!response.ok) {
                        console.error("Error sending message");
                    }
                } catch (error) {
                    console.error("Network error sending message", error);
                }
            });
        });
    </script>
</body>
</html>
