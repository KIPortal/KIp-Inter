<div class="mx-auto w-full max-w-6xl">
    <!-- Header de Gestión de Turno -->
    <header class="flex flex-wrap items-center justify-between gap-4 border-b border-[#E5E5EA] pb-4">
        <div class="flex items-center gap-3">
            <button type="button" onclick="showDashboardSection('dashboard')" aria-label="Volver al dashboard"
                class="flex h-9 w-9 items-center justify-center rounded-[9px] border border-[#E5E5EA] text-[#636366] hover:bg-[#F5F5F7] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#007AFF]/30 transition cursor-pointer">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6M9 12h12"></path></svg>
            </button>
            <div>
                <p class="text-[10px] font-semibold uppercase tracking-wider text-[#8E8E93]">IP · Operaciones</p>
                <h1 class="mt-0.5 text-[17px] font-semibold text-[#1C1C1E]">Gestión de Turno y Guardias</h1>
            </div>
        </div>

        <!-- Controles de Semana -->
        <div class="flex items-center gap-2">
            <div class="flex items-center bg-[#F2F2F7] border border-[#D1D1D6] rounded-[8px] p-0.5 shadow-xs">
                <button type="button" id="btnShiftPrevWeek" onclick="navigateShiftWeek(-1)"
                    class="px-2.5 py-1 text-[12px] font-medium text-[#48484A] hover:bg-white hover:text-black rounded-[6px] transition cursor-pointer"
                    title="Semana anterior">
                    ‹
                </button>
                <span id="shiftWeekDisplay" class="px-3 py-1 text-[11px] font-medium font-mono text-[#1C1C1E] select-none">
                    Cargando semana...
                </span>
                <button type="button" id="btnShiftNextWeek" onclick="navigateShiftWeek(1)"
                    class="px-2.5 py-1 text-[12px] font-medium text-[#48484A] hover:bg-white hover:text-black rounded-[6px] transition cursor-pointer"
                    title="Semana siguiente">
                    ›
                </button>
            </div>
            <button type="button" onclick="navigateShiftCurrentWeek()"
                class="px-2.5 py-1.5 bg-white hover:bg-[#F2F2F7] border border-[#D1D1D6] text-[#48484A] text-[11px] font-medium rounded-[8px] shadow-xs transition cursor-pointer">
                Hoy
            </button>
            <button type="button" id="btnSaveAllGuardias" onclick="saveShiftGuardias()"
                class="px-3.5 py-1.5 bg-[#007AFF] hover:bg-[#0062CC] active:bg-[#0051A8] text-white text-[12px] font-medium rounded-[8px] shadow-xs transition cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                <span>Guardar guardia</span>
            </button>
        </div>
    </header>

    <!-- Resumen Dinámico -->
    <section aria-label="Resumen de guardia y turnos" class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-4">
        <div class="rounded-[10px] bg-[#F9F9FB] border border-[#E5E5EA] p-3.5">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-[#8E8E93]">Total Operadores</span>
            <strong id="shiftStatTotal" class="block font-mono text-[22px] font-semibold tabular-nums text-[#1C1C1E] mt-1">0</strong>
        </div>
        <div class="rounded-[10px] bg-[#F9F9FB] border border-[#E5E5EA] p-3.5">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-[#0369A1]">De Guardia Esta Semana</span>
            <strong id="shiftStatGuardia" class="block font-mono text-[22px] font-semibold tabular-nums text-[#0284C7] mt-1">0</strong>
        </div>
        <div class="rounded-[10px] bg-[#F9F9FB] border border-[#E5E5EA] p-3.5">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-[#16834A]">En Turno Actual</span>
            <strong id="shiftStatEnTurno" class="block font-mono text-[22px] font-semibold tabular-nums text-[#16834A] mt-1">0</strong>
        </div>
        <div class="rounded-[10px] bg-[#F9F9FB] border border-[#E5E5EA] p-3.5">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-[#71717A]">Fuera de Turno / Ausentes</span>
            <strong id="shiftStatFuera" class="block font-mono text-[22px] font-semibold tabular-nums text-[#71717A] mt-1">0</strong>
        </div>
    </section>

    <!-- Lista / Tabla de Operadores -->
    <section class="mt-6">
        <div class="flex items-center justify-between pb-3">
            <div>
                <h2 class="text-[14px] font-semibold text-[#1C1C1E]">Plantilla de Operadores</h2>
                <p class="text-[11px] text-[#8E8E93]">Asignación de guardia semanal y configuración individual de horario</p>
            </div>
            <span id="shiftStatusMessage" class="text-[11px] font-medium text-emerald-600 hidden"></span>
        </div>

        <div id="shiftOperatorsContainer" class="space-y-3">
            <div class="py-12 text-center text-[#8E8E93] text-[12px]">
                <svg class="animate-spin h-5 w-5 mx-auto mb-2 text-[#007AFF]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                Cargando datos de turnos...
            </div>
        </div>
    </section>
</div>

<script>
    (function () {
        let currentShiftWeekISO = null;
        let shiftOperatorsCache = [];

        const STATUS_BADGES = {
            'En turno': { class: 'bg-[#E5F9ED] text-[#16834A] border-emerald-200', dot: '#34C759' },
            'De guardia': { class: 'bg-[#E0F2FE] text-[#0369A1] border-sky-200', dot: '#0284C7' },
            'En casa de guardia': { class: 'bg-[#EEF2FF] text-[#4338CA] border-indigo-200', dot: '#6366F1' },
            'Fuera de turno': { class: 'bg-[#F4F4F5] text-[#71717A] border-zinc-200', dot: '#A1A1AA' },
            'Ausente': { class: 'bg-[#FEE2E2] text-[#B91C1C] border-red-200', dot: '#EF4444' }
        };

        const AREA_NAMES = {
            GENERAL: 'Operaciones IP',
            REDES_FTTH: 'Redes FTTH / OLT',
            TRAFICO_INALAMBRICO: 'Tráfico inalámbrico',
            WAN: 'WAN',
            GRANDES_CLIENTES: 'Grandes clientes',
            SEGURIDAD: 'Seguridad',
            TELEFONIA: 'Telefonía'
        };

        const DAY_NAMES = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];

        function showShiftFeedback(msg, isError = false) {
            const el = document.getElementById('shiftStatusMessage');
            if (!el) return;
            el.textContent = msg;
            el.className = `text-[11px] font-medium ${isError ? 'text-red-600' : 'text-emerald-600'}`;
            el.classList.remove('hidden');
            setTimeout(() => el.classList.add('hidden'), 4000);
        }

        function formatWeekDisplay(isoString) {
            if (!isoString) return '';
            const monday = new Date(isoString);
            const sunday = new Date(monday.getTime() + 6 * 24 * 60 * 60 * 1000);
            const opt = { day: 'numeric', month: 'short' };
            const mStr = monday.toLocaleDateString('es-VE', opt);
            const sStr = sunday.toLocaleDateString('es-VE', opt);
            const yStr = sunday.getFullYear();
            return `Semana: ${mStr} – ${sStr} ${yStr}`;
        }

        async function loadShiftTurnos(semanaParam) {
            const container = document.getElementById('shiftOperatorsContainer');
            if (!container) return;
            
            try {
                const url = semanaParam ? `/api/turnos?semana=${encodeURIComponent(semanaParam)}` : '/api/turnos';
                const res = await fetch(url);
                if (!res.ok) throw new Error('Error al consultar turnos');
                const data = await res.json();
                
                currentShiftWeekISO = data.semana;
                shiftOperatorsCache = data.operadores || [];
                
                const weekDisplay = document.getElementById('shiftWeekDisplay');
                if (weekDisplay) weekDisplay.textContent = formatWeekDisplay(data.semana);

                renderShiftStats(shiftOperatorsCache);
                renderShiftOperators(shiftOperatorsCache);
            } catch (err) {
                console.error('Error cargando turnos:', err);
                container.innerHTML = `
                    <div class="py-8 text-center text-red-600 text-[12px]">
                        Error al cargar la información de turnos. <button type="button" onclick="loadShiftTurnos()" class="underline font-semibold ml-1">Reintentar</button>
                    </div>`;
            }
        }

        function renderShiftStats(operadores) {
            let total = operadores.length;
            let guardiaCount = 0;
            let enTurnoCount = 0;
            let fueraCount = 0;

            operadores.forEach(op => {
                if (op.deGuardia) guardiaCount++;
                const status = (op.turno && op.turno.codigo) || '';
                if (status === 'EN_TURNO' || status === 'DE_GUARDIA' || status === 'EN_CASA_GUARDIA') {
                    enTurnoCount++;
                } else {
                    fueraCount++;
                }
            });

            const elTotal = document.getElementById('shiftStatTotal');
            const elGuardia = document.getElementById('shiftStatGuardia');
            const elTurno = document.getElementById('shiftStatEnTurno');
            const elFuera = document.getElementById('shiftStatFuera');

            if (elTotal) elTotal.textContent = total;
            if (elGuardia) elGuardia.textContent = guardiaCount;
            if (elTurno) elTurno.textContent = enTurnoCount;
            if (elFuera) elFuera.textContent = fueraCount;
        }

        function renderShiftOperators(operadores) {
            const container = document.getElementById('shiftOperatorsContainer');
            if (!container) return;

            if (!operadores || operadores.length === 0) {
                container.innerHTML = '<div class="py-10 text-center text-[#8E8E93] text-[12px]">No hay operadores registrados.</div>';
                return;
            }

            container.innerHTML = operadores.map(op => {
                const initials = op.nombre.split(/\s+/).slice(0, 2).map(p => p[0]).join('').toUpperCase() || 'OP';
                const areaLabel = AREA_NAMES[op.area_designada] || op.area_designada;
                const turnoInfo = op.turno || { etiqueta: 'Fuera de turno', codigo: 'FUERA_DE_TURNO' };
                const badgeCfg = STATUS_BADGES[turnoInfo.etiqueta] || { class: 'bg-[#F4F4F5] text-[#71717A] border-zinc-200', dot: '#A1A1AA' };
                const schedule = op.horario || { dias: [1, 2, 3, 4, 5], inicio: '08:00', fin: '17:00' };
                const activeDays = new Set(schedule.dias || []);

                return `
                <div class="rounded-[12px] border border-[#E5E5EA] bg-white p-4 shadow-xs transition hover:border-[#D1D1D6] space-y-3" id="shift-card-${op.id}">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[#D8E8FF] bg-[#EFF6FF] text-[12px] font-semibold text-[#3974C6]">
                                ${initials}
                            </span>
                            <div>
                                <div class="flex items-center gap-2">
                                    <h3 class="text-[13px] font-semibold text-[#1C1C1E]">${escapeHtml(op.nombre)}</h3>
                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-medium border ${badgeCfg.class}">
                                        <span class="w-1.5 h-1.5 rounded-full" style="background-color: ${badgeCfg.dot}"></span>
                                        ${escapeHtml(turnoInfo.etiqueta)}
                                    </span>
                                </div>
                                <p class="text-[11px] text-[#8E8E93] mt-0.5">${escapeHtml(areaLabel)} · <span class="text-[#636366] font-mono">${escapeHtml(op.email)}</span></p>
                            </div>
                        </div>

                        <!-- Checkbox De Guardia -->
                        <div class="flex items-center gap-2 bg-[#F9F9FB] border border-[#E5E5EA] px-3 py-1.5 rounded-[8px]">
                            <input type="checkbox" id="guardia-cb-${op.id}" data-operator-id="${op.id}" class="shift-guardia-cb w-4 h-4 rounded text-[#007AFF] border-[#D1D1D6] focus:ring-0 cursor-pointer" ${op.deGuardia ? 'checked' : ''}>
                            <label for="guardia-cb-${op.id}" class="text-[11px] font-medium text-[#1C1C1E] cursor-pointer select-none">
                                De guardia
                            </label>
                        </div>
                    </div>

                    <!-- Editor de Horario Inline -->
                    <div class="pt-2 border-t border-[#F2F2F7] flex flex-wrap items-center justify-between gap-3 text-[11px]">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="text-[#8E8E93] font-medium mr-1">Días:</span>
                            ${[0, 1, 2, 3, 4, 5, 6].map(d => `
                                <label class="inline-flex items-center gap-1 px-2 py-0.5 rounded-[5px] border cursor-pointer select-none transition ${activeDays.has(d) ? 'bg-[#EBF5FF] border-[#B9DBFE] text-[#0062CC] font-semibold' : 'bg-white border-[#E5E5EA] text-[#8E8E93]'}">
                                    <input type="checkbox" data-day="${d}" data-op-id="${op.id}" class="hidden shift-day-cb" ${activeDays.has(d) ? 'checked' : ''} onchange="toggleDayBadge(this)">
                                    ${DAY_NAMES[d]}
                                </label>
                            `).join('')}
                        </div>

                        <div class="flex items-center gap-2">
                            <div class="flex items-center gap-1">
                                <span class="text-[#8E8E93]">Horario:</span>
                                <input type="time" id="inicio-${op.id}" value="${schedule.inicio || '08:00'}" class="h-[28px] px-1.5 bg-[#F2F2F7] border border-[#D1D1D6] rounded-[6px] text-[11px] font-mono text-[#1C1C1E] focus:outline-none focus:border-[#007AFF]">
                                <span class="text-[#8E8E93]">–</span>
                                <input type="time" id="fin-${op.id}" value="${schedule.fin || '17:00'}" class="h-[28px] px-1.5 bg-[#F2F2F7] border border-[#D1D1D6] rounded-[6px] text-[11px] font-mono text-[#1C1C1E] focus:outline-none focus:border-[#007AFF]">
                            </div>
                            <button type="button" onclick="saveShiftHorario(${op.id})" class="h-[28px] px-2.5 bg-white hover:bg-[#F2F2F7] active:bg-[#E5E5EA] border border-[#D1D1D6] rounded-[6px] text-[11px] font-medium text-[#1C1C1E] transition cursor-pointer shadow-2xs">
                                Guardar horario
                            </button>
                        </div>
                    </div>
                </div>`;
            }).join('');
        }

        window.toggleDayBadge = function(cb) {
            const label = cb.closest('label');
            if (cb.checked) {
                label.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-[5px] border cursor-pointer select-none transition bg-[#EBF5FF] border-[#B9DBFE] text-[#0062CC] font-semibold';
            } else {
                label.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-[5px] border cursor-pointer select-none transition bg-white border-[#E5E5EA] text-[#8E8E93]';
            }
        };

        window.navigateShiftWeek = function (offset) {
            if (!currentShiftWeekISO) return;
            const current = new Date(currentShiftWeekISO);
            current.setDate(current.getDate() + (offset * 7));
            const yyyy = current.getUTCFullYear();
            const mm = String(current.getUTCMonth() + 1).padStart(2, '0');
            const dd = String(current.getUTCDate()).padStart(2, '0');
            loadShiftTurnos(`${yyyy}-${mm}-${dd}`);
        };

        window.navigateShiftCurrentWeek = function () {
            loadShiftTurnos();
        };

        window.saveShiftGuardias = async function () {
            const btn = document.getElementById('btnSaveAllGuardias');
            const originalContent = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Guardando...';
            }

            try {
                const checkboxes = document.querySelectorAll('.shift-guardia-cb:checked');
                const operatorIds = Array.from(checkboxes).map(cb => parseInt(cb.dataset.operatorId, 10)).filter(id => !isNaN(id));
                const semana = currentShiftWeekISO ? currentShiftWeekISO.slice(0, 10) : undefined;

                const res = await fetch('/api/turnos/guardia', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ semana, operatorIds })
                });

                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'No se pudo guardar la guardia');

                showShiftFeedback('Guardia actualizada correctamente');
                await loadShiftTurnos(semana);
            } catch (err) {
                console.error('Error al guardar guardia:', err);
                alert(err.message || 'Error al guardar guardia');
                showShiftFeedback(err.message || 'Error al guardar guardia', true);
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalContent;
                }
            }
        };

        window.saveShiftHorario = async function (operatorId) {
            const card = document.getElementById(`shift-card-${operatorId}`);
            if (!card) return;

            const dayCheckboxes = card.querySelectorAll('.shift-day-cb:checked');
            const dias = Array.from(dayCheckboxes).map(cb => parseInt(cb.dataset.day, 10));
            const inicio = (document.getElementById(`inicio-${operatorId}`)?.value || '').trim();
            const fin = (document.getElementById(`fin-${operatorId}`)?.value || '').trim();

            if (dias.length === 0) {
                alert('Debes seleccionar al menos un día para el horario.');
                return;
            }

            try {
                const res = await fetch(`/api/turnos/horario/${encodeURIComponent(operatorId)}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dias, inicio, fin })
                });

                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'No se pudo guardar el horario');

                showShiftFeedback(`Horario del operador guardado`);
                const semana = currentShiftWeekISO ? currentShiftWeekISO.slice(0, 10) : undefined;
                await loadShiftTurnos(semana);
            } catch (err) {
                console.error('Error al guardar horario:', err);
                alert(err.message || 'Error al guardar horario');
            }
        };

        function escapeHtml(str) {
            return String(str || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        window.loadShiftSectionData = function () {
            loadShiftTurnos();
        };

        // Si la URL arranca con #gestion-turno, cargar datos automáticamente
        if (window.location.hash === '#gestion-turno') {
            loadShiftTurnos();
        }
    })();
</script>