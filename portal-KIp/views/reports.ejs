<!DOCTYPE html>
<html class="h-full bg-slate-100" lang="es">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title><%= titulo %></title>
    <!-- Tailwind CSS v3 with Plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
        rel="stylesheet">
    <link href="/css/figma-assets.css" rel="stylesheet">
    <!-- Apache ECharts CDN -->
    <script src="https://cdn.jsdelivr.net/npm/echarts/dist/echarts.min.js"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', 'Inter', 'SF Pro Text', 'SF Pro Display', 'Helvetica Neue', 'sans-serif'],
                        mono: ['SF Mono', 'JetBrains Mono', 'Menlo', 'Monaco', 'Courier New', 'monospace']
                    },
                    colors: {
                        mac: {
                            bg: '#F5F5F7', window: '#FFFFFF', sidebar: '#EBEBF0', accent: '#0EA5E9', accentHover: '#0284C7',
                            subtle: '#8E8E93', border: '#E5E5EA', borderLight: '#F2F2F7', headerBorder: '#D1D1D6',
                            selected: '#E0F2FE', selectedText: '#0284C7', dangerLight: '#FFE5E5', dangerText: '#D70015',
                            successLight: '#E3F9E5', successText: '#1B873F', warningLight: '#FFF4D6', warningText: '#B25E02'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            user-select: none;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.15);
            border-radius: 9999px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 0, 0, 0.28);
        }

        .num-tabular {
            font-variant-numeric: tabular-nums;
        }

        /* macOS 27 NEW (Ocean-Glass) Card Design System */
        .figma-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            border-radius: 16px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .figma-card:hover {
            box-shadow: 0 4px 12px 0 rgba(0, 0, 0, 0.06);
        }

        .macos-focus-ring {
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.35);
            border-color: #38bdf8 !important;
        }
    </style>
</head>

<body class="h-dvh w-full min-w-0 bg-gradient-to-br from-slate-100 via-blue-50 to-sky-100 overflow-hidden flex flex-col font-sans text-[13px] text-[#1C1C1E] m-0 p-0">

    <!-- macOS Full Application Viewport -->
    <div class="relative w-full h-full flex flex-col overflow-hidden bg-transparent select-none">

        <!-- BEGIN: macOS Unified Titlebar & Toolbar -->
        <header
            class="h-[56px] bg-white/70 backdrop-blur-xl border-b border-[#E5E5EA]/60 px-2 sm:px-4 flex items-center justify-between gap-2 select-none z-20 flex-shrink-0">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-3">
                    <img alt="Logo Inter" class="h-[28px] w-auto object-contain" onerror="this.style.display='none'"
                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuAtCf1kyA5Xv3ji8h2EifMIzU5ZiU3r5XlzhgnLFSjZns31wuEmyWwyxb7Ibp30TQgk1BU7IO9qFU5Ri9xtP1U6XPsTT3Ew2iMHnDiOmn4Y-IT_Fy4lZdLyfTzEBMnrxeUJ-S7GYU870d6-54QeqaoelnE_92ZTd36r0rRy5wwIyJJcT881mYSiNC15GTzaM5v_ZLKyzhMIEo-MMFCaNtJqZCR6YOc7FYA8AUcQvEfl_R03WH_n6yHU3a8zKevr3gppvw">
                    <div class="h-5 w-[1px] bg-[#D1D1D6]"></div>
                    <span class="text-[14px] font-semibold text-[#1C1C1E] tracking-tight">Operaciones IP</span>
                </div>
                <div
                    class="ml-2 hidden md:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#F2F2F7] border border-[#D1D1D6] text-[11px] text-[#48484A] font-medium">
                    <span class="w-2 h-2 rounded-full bg-[#34C759]"></span>
                    <span>Turno A (07:00 - 15:00)</span>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div
                    class="figma-toolbars-search__search !w-auto relative hidden sm:flex bg-[#F5F5F7] border border-[#D1D1D6] rounded-[7px] transition focus-within:bg-white focus-within:border-sky-500">
                    <div class="figma-toolbars-search__liquid-glass absolute inset-0"></div>
                    <svg class="figma-toolbars-search__symbol w-3.5 h-3.5 text-[#8E8E93] flex-shrink-0 pointer-events-none" fill="none"
                        stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
                    </svg>
                    <input
                        id="globalSearchInput"
                        class="figma-toolbars-search__search-label !w-[100px] focus:!w-[160px] transition-all duration-200 bg-transparent text-[11px] text-[#1C1C1E] placeholder-[#8E8E93] focus:outline-none border-none p-0"
                        placeholder="Buscar..." type="text">
                    <span
                        class="flex-shrink-0 px-1 py-0.5 text-[9px] font-mono text-[#8E8E93] bg-white border border-[#D1D1D6] rounded pointer-events-none font-medium relative z-10">⌘K</span>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/?nuevo=1" id="newTicketButton"
                        class="figma-button !w-auto !h-[28px] bg-sky-500 hover:bg-sky-600 text-white shadow-sm transition inline-flex items-center px-3 rounded-[6px]">
                        <div class="figma-button__label text-white flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <line x1="12" x2="12" y1="5" y2="19"></line>
                                <line x1="5" x2="19" y1="12" y2="12"></line>
                            </svg>
                            <span class="hidden sm:inline">Nuevo Ticket</span>
                        </div>
                    </a>
                </div>
                <div class="h-5 w-[1px] bg-[#D1D1D6] mx-0.5"></div>
                <details class="relative group select-none z-50">
                    <summary
                        class="list-none flex items-center gap-2 px-2 py-1 rounded-[8px] hover:bg-[#F2F2F7] transition cursor-pointer border border-transparent hover:border-[#D1D1D6]">
                        <div
                            class="w-7 h-7 rounded-full bg-sky-500 text-white flex items-center justify-center font-mono font-semibold text-[11px]">
                            <%= typeof currentUser !== 'undefined' && currentUser && currentUser.nombre ? (currentUser.nombre.trim().split(/\s+/).slice(0, 2).map(part => part.charAt(0)).join('').toUpperCase() || 'CP') : 'CP' %></div>
                        <div class="hidden sm:flex flex-col text-left">
                            <span class="text-[11px] font-medium text-[#1C1C1E] leading-tight"><%= typeof currentUser !== 'undefined' && currentUser && currentUser.nombre ? currentUser.nombre : 'Coord. NOC' %></span>
                            <span class="text-[9px] font-mono font-bold text-[#34C759] tracking-wider leading-tight"><%= typeof currentUser !== 'undefined' && currentUser && currentUser.email ? currentUser.email : '● LÍDER ACTIVO' %></span>
                        </div>
                    </summary>
                    <div class="absolute right-0 top-[100%] mt-1 w-[150px] bg-white rounded-[6px] border border-[#D1D1D6] shadow-[0_4px_14px_rgba(0,0,0,0.1)] p-1 z-50 text-[12px]">
                        <form action="/auth/logout" method="POST" class="m-0">
                            <button type="submit" class="w-full text-left px-2 py-1.5 rounded-[4px] text-[#1C1C1E] hover:bg-sky-500 hover:text-white font-medium transition cursor-pointer">
                                Cerrar Sesión
                            </button>
                        </form>
                    </div>
                </details>
            </div>
        </header>

        <!-- Main Body Workspace -->
        <div class="flex-1 flex overflow-hidden min-h-0 bg-transparent">

            <!-- BEGIN: Finder-style macOS Sidebar -->
            <aside
                class="w-[52px] md:w-[200px] flex-shrink-0 bg-slate-100/90 backdrop-blur-xl border-r border-[#D8D8DC]/60 flex flex-col justify-between select-none py-3 px-1 md:px-2">
                <div class="space-y-4">
                    <div>
                        <div class="hidden md:block px-2.5 pb-1.5 text-[10px] font-bold text-[#8E8E93] uppercase tracking-wider">
                            Navegación</div>
                        <nav class="space-y-0.5">
                            <a id="dashboardNavLink" class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#3A3A3C] hover:bg-black/5 font-medium text-[12px] transition"
                                href="/">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-[#8E8E93]" fill="currentColor" viewBox="0 0 24 24">
                                        <path
                                             d="M19.5 21a3 3 0 0 0 3-3v-4.5a3 3 0 0 0-3-3h-15a3 3 0 0 0-3-3V18a3 3 0 0 0 3 3h15ZM1.5 10.5V6a3 3 0 0 1 3-3h15a3 3 0 0 1 3 3v4.5">
                                        </path>
                                    </svg>
                                    <span class="hidden md:inline">Dashboard General</span>
                                </div>
                            </a>
                            <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#3A3A3C] hover:bg-black/5 text-[12px] font-medium transition"
                                href="/auditoria">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-[#8E8E93]" fill="none" stroke="currentColor"
                                        stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <span class="hidden md:inline">Auditoría</span>
                                </div>
                            </a>
                            <a id="shiftManagementNavLink" class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#3A3A3C] hover:bg-black/5 text-[12px] font-medium transition"
                                href="/#gestion-turno">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-[#8E8E93]" fill="none" stroke="currentColor"
                                        stroke-width="2" viewBox="0 0 24 24">
                                        <path
                                            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                                        </path>
                                    </svg>
                                    <span class="hidden md:inline">Gestión de Turno</span>
                                </div>
                            </a>
                            <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] bg-sky-500 hover:bg-sky-600 text-white text-[12px] font-medium transition shadow-xs"
                                href="/reportes">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor"
                                        stroke-width="2" viewBox="0 0 24 24">
                                        <path
                                            d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
                                        </path>
                                    </svg>
                                    <span class="hidden md:inline">Reportes</span>
                                </div>
                            </a>
                        </nav>
                    </div>
                </div>

                <!-- Sidebar Bottom Footer -->
                <div class="p-1.5 md:p-2.5 rounded-[8px] bg-white/70 border border-black/5 shadow-xs space-y-1">
                    <div class="flex items-center justify-between text-[11px]">
                        <span class="flex items-center gap-1.5 font-medium text-[#1C1C1E]"><span
                                class="w-2 h-2 rounded-full bg-[#34C759]"></span><span class="hidden md:inline">Servidor NOC</span></span>
                        <span class="hidden md:inline font-mono text-[10px] text-[#34C759] font-bold">18ms</span>
                    </div>
                    <div class="hidden md:flex items-center justify-between text-[10px] text-[#8E8E93] font-mono">
                        <span>Sincronía OLT</span>
                        <span class="text-[#3A3A3C]">Activo (0s)</span>
                    </div>
                </div>
            </aside>
            <!-- END: Sidebar -->

            <!-- Main Scrollable Dashboard Content -->
            <main class="flex-1 flex flex-col min-w-0 bg-transparent overflow-y-auto p-4 sm:p-6 lg:p-8 gap-6 sm:gap-7">

                <!-- Page Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <h1 class="text-xl sm:text-2xl font-bold text-[#1C1C1E] tracking-tight">Reportes y Rendimiento</h1>
                        <p class="text-[12px] text-[#8E8E93] mt-0.5">Métricas operativas dinámicas, saturación de área y ranking de operadores</p>
                    </div>
                    <div class="flex items-center flex-wrap gap-2.5">
                        <!-- Selector de Periodo - R3 -->
                        <div class="flex items-center gap-1.5 bg-white/80 backdrop-blur-md border border-[#D1D1D6] rounded-[8px] px-2.5 py-1 shadow-2xs">
                            <svg class="w-3.5 h-3.5 text-[#8E8E93]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <label for="periodoSelect" class="text-[11px] font-medium text-[#8E8E93] leading-none">Periodo:</label>
                            <select id="periodoSelect" class="bg-transparent text-[12px] font-semibold text-[#1C1C1E] border-none focus:outline-none focus:ring-0 cursor-pointer pr-1">
                                <option value="jornada" selected>Jornada</option>
                                <option value="semana">Semana</option>
                                <option value="mes">Mes</option>
                                <option value="especifica">Fecha específica</option>
                            </select>
                        </div>

                        <!-- Botón Descargar Excel (verde/sky con estilo macOS Ocean-Glass) - R3 -->
                        <button type="button" id="btnDescargarExcel" class="px-3 py-1.5 rounded-[8px] bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-medium text-[12px] flex items-center gap-1.5 shadow-xs hover:shadow transition duration-150 cursor-pointer select-none">
                            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                            <span>Descargar Excel</span>
                        </button>

                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/80 border border-[#D1D1D6] text-[11px] text-[#1C1C1E] font-medium shadow-2xs">
                            <span class="w-2 h-2 rounded-full bg-sky-500 animate-pulse"></span>
                            <span>Jornada Activa</span>
                        </span>
                    </div>
                </div>

                <!-- BEGIN: macOS Segmented Control (Tabs) - R1, R2 -->
                <div class="flex items-center justify-between flex-wrap gap-4 pt-1 flex-shrink-0">
                    <div class="inline-flex p-1 rounded-[12px] bg-black/10 backdrop-blur-md border border-black/5 shadow-inner" role="tablist" aria-label="Secciones de Reporte">
                        <button type="button" role="tab" id="tab-btn-overview" data-target="tab-overview" aria-selected="true" class="report-tab-btn flex items-center gap-2 px-4 py-1.5 rounded-[9px] text-[12px] font-semibold bg-white text-[#1C1C1E] shadow-sm transition-all duration-200">
                            <svg class="w-3.5 h-3.5 text-sky-500 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                            </svg>
                            <span>Visión General</span>
                        </button>
                        <button type="button" role="tab" id="tab-btn-team" data-target="tab-team" aria-selected="false" class="report-tab-btn flex items-center gap-2 px-4 py-1.5 rounded-[9px] text-[12px] font-medium text-[#8E8E93] hover:text-[#1C1C1E] hover:bg-white/40 transition-all duration-200">
                            <svg class="w-3.5 h-3.5 text-[#8E8E93] transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                            <span>Equipo</span>
                        </button>
                        <button type="button" role="tab" id="tab-btn-geo" data-target="tab-geo" aria-selected="false" class="report-tab-btn flex items-center gap-2 px-4 py-1.5 rounded-[9px] text-[12px] font-medium text-[#8E8E93] hover:text-[#1C1C1E] hover:bg-white/40 transition-all duration-200">
                            <svg class="w-3.5 h-3.5 text-[#8E8E93] transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                                <line x1="8" y1="2" x2="8" y2="18"></line>
                                <line x1="16" y1="6" x2="16" y2="22"></line>
                            </svg>
                            <span>Geografía</span>
                        </button>
                    </div>
                </div>
                <!-- END: macOS Segmented Control (Tabs) -->

                <!-- BEGIN: Tab 1 (Visión General) -->
                <div id="tab-overview" class="tab-pane flex flex-col gap-6" role="tabpanel" aria-labelledby="tab-btn-overview">

                    <!-- BEGIN: 4 KPI Cards (Liquid Glass) - R2.1 -->
                <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 flex-shrink-0" data-purpose="kpi-cards">
                    <!-- Card 1: Tickets Totales -->
                    <div class="figma-card p-5 flex flex-col justify-between relative overflow-hidden group">
                        <div class="flex items-start justify-between">
                            <span class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider leading-tight">
                                Tickets Totales
                            </span>
                            <span class="w-2 h-2 rounded-full bg-sky-500 mt-0.5"></span>
                        </div>
                        <div class="mt-3">
                            <div class="text-[34px] font-semibold font-mono text-[#1C1C1E] tracking-tight num-tabular leading-none" id="kpi-total">
                                <%= typeof kpis !== 'undefined' && typeof kpis.total !== 'undefined' ? kpis.total : (typeof ticketsTotales !== 'undefined' ? ticketsTotales : 0) %>
                            </div>
                            <span class="text-[11px] text-[#8E8E93] mt-1.5 block">Volumen histórico global</span>
                        </div>
                    </div>

                    <!-- Card 2: Tickets de la Jornada -->
                    <div class="figma-card p-5 flex flex-col justify-between relative overflow-hidden group">
                        <div class="flex items-start justify-between">
                            <span class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider leading-tight">
                                Tickets de la Jornada
                            </span>
                            <span class="w-2 h-2 rounded-full bg-[#34C759] mt-0.5"></span>
                        </div>
                        <div class="mt-3">
                            <div class="text-[34px] font-semibold font-mono text-[#1C1C1E] tracking-tight num-tabular leading-none" id="kpi-jornada">
                                <%= typeof kpis !== 'undefined' && typeof kpis.jornada !== 'undefined' ? kpis.jornada : (typeof ticketsJornada !== 'undefined' ? ticketsJornada : 0) %>
                            </div>
                            <span class="text-[11px] text-[#8E8E93] mt-1.5 block">Creados o resueltos hoy</span>
                        </div>
                    </div>

                    <!-- Card 3: Tickets Resueltos / Tasa -->
                    <div class="figma-card p-5 flex flex-col justify-between relative overflow-hidden group">
                        <div class="flex items-start justify-between">
                            <span class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider leading-tight">
                                Tickets Resueltos
                            </span>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#E3F9E5] text-[#1B873F] border border-[#BCE8C5]">
                                <%= typeof kpis !== 'undefined' && kpis.tasa ? kpis.tasa : (typeof tasa !== 'undefined' ? tasa : '0%') %>
                            </span>
                        </div>
                        <div class="mt-3">
                            <div class="text-[34px] font-semibold font-mono text-[#1C1C1E] tracking-tight num-tabular leading-none" id="kpi-resueltos">
                                <%= typeof kpis !== 'undefined' && typeof kpis.resueltos !== 'undefined' ? kpis.resueltos : (typeof resueltos !== 'undefined' ? resueltos : 0) %>
                            </div>
                            <span class="text-[11px] text-[#8E8E93] mt-1.5 block">Tasa de resolución efectiva</span>
                        </div>
                    </div>

                    <!-- Card 4: Área Crítica (R1.6 / R2.1) + Puntos de Complejidad -->
                    <% 
                        const critArea = (typeof areaCritica !== 'undefined' && areaCritica) 
                            ? areaCritica 
                            : ((typeof kpis !== 'undefined' && kpis.areaCritica) ? kpis.areaCritica : { nombre: 'Ninguna', abiertos: 0 });
                        const isCritActive = critArea.abiertos > 0;
                    %>
                    <div class="figma-card p-5 flex flex-col justify-between relative overflow-hidden group">
                        <div class="flex items-start justify-between">
                            <span class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider leading-tight">
                                Área Crítica
                            </span>
                            <% if (isCritActive) { %>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#FFE5E5] text-[#D70015] border border-[#FFC2C2] animate-pulse">
                                    Mayor Congestión
                                </span>
                            <% } else { %>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#E3F9E5] text-[#1B873F] border border-[#BCE8C5]">
                                    Estable
                                </span>
                            <% } %>
                        </div>
                        <div class="mt-2.5">
                            <div class="text-[22px] font-bold text-[#1C1C1E] tracking-tight truncate leading-tight" id="kpi-area-critica">
                                <%= critArea.nombre || critArea.label || 'Ninguna' %>
                            </div>
                            <div class="flex items-center justify-between text-[11px] text-[#8E8E93] mt-2">
                                <span>
                                    <strong class="num-tabular <%= isCritActive ? 'text-[#D70015] font-semibold' : 'text-[#34C759]' %>"><%= critArea.abiertos || critArea.ticketsAbiertos || 0 %></strong> tickets abiertos
                                </span>
                                <span id="kpi-puntos" class="font-mono text-[10px] text-[#8E8E93]">
                                    <%= typeof kpis !== 'undefined' && typeof kpis.puntosTotales !== 'undefined' ? kpis.puntosTotales : (typeof puntosTotales !== 'undefined' ? puntosTotales : 0) %> pts
                                </span>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- END: KPI Cards -->

                <!-- BEGIN: Hourly Flow Chart (Line Chart) - Gráfica 4: Flujo 24h (Creados vs Asignados vs Cerrados) [Ancho Completo] -->
                <section class="figma-card p-5 sm:p-6 flex flex-col flex-shrink-0">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-[#E5E5EA]">
                        <div>
                            <h2 class="text-[14px] font-semibold text-[#1C1C1E] tracking-tight">Flujo Horario 24h de la Jornada</h2>
                            <p class="text-[11px] text-[#8E8E93] mt-0.5">Comparativa en tiempo real: incidencias creadas vs tickets asignados y cerrados por hora (00:00 - 23:00)</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="flex items-center gap-1.5 text-[11px] text-[#48484A]">
                                <span class="w-2.5 h-2.5 rounded-full bg-[#1C1C1E]"></span>
                                <span>Creados</span>
                            </div>
                            <div class="flex items-center gap-1.5 text-[11px] text-[#48484A]">
                                <span class="w-2.5 h-2.5 rounded-full bg-sky-500"></span>
                                <span>Asignados</span>
                            </div>
                            <div class="flex items-center gap-1.5 text-[11px] text-[#48484A]">
                                <span class="w-2.5 h-2.5 rounded-full bg-[#34C759]"></span>
                                <span>Cerrados</span>
                            </div>
                            <span class="text-[10px] font-mono text-[#8E8E93] px-2 py-0.5 rounded bg-black/5 font-semibold">LÍNEAS</span>
                        </div>
                    </div>
                    <div class="relative w-full mt-4">
                        <div id="hourlyFlowChart" style="width: 100%; height: 300px;"></div>
                    </div>
                </section>
                <!-- END: Hourly Flow Chart -->

                <!-- BEGIN: Gráficas en Mitades (Área vs Tickets & Mediana de Resolución) -->
                <section class="grid grid-cols-1 lg:grid-cols-2 gap-5 flex-shrink-0">
                    <!-- Gráfica 1: Área vs Tickets (Asignados/Creados, Resueltos, Rechazados) & Indicadores de Saturación (R2.2) [Mitad] -->
                    <div class="figma-card p-5 sm:p-6 flex flex-col">
                        <div class="flex items-center justify-between pb-3 border-b border-[#E5E5EA]">
                            <div>
                                <h2 class="text-[14px] font-semibold text-[#1C1C1E] tracking-tight">Área vs Tickets (Creados, Resueltos, Rechazados)</h2>
                                <p class="text-[11px] text-[#8E8E93] mt-0.5">Asignados/Creados vs Resueltos y Rechazados por área técnica (catálogo de estados)</p>
                            </div>
                            <span class="text-[10px] font-mono text-[#8E8E93] px-2 py-0.5 rounded bg-black/5 font-semibold">BARRAS AGRUPADAS</span>
                        </div>

                        <!-- ECharts Grouped Bars Container -->
                        <div class="relative w-full mt-3">
                            <div id="areaTicketsChart" style="width: 100%; height: 300px;"></div>
                        </div>

                        <!-- Indicadores de Saturación por Área (Barras de Progreso) -->
                        <div class="mt-5 pt-4 border-t border-[#E5E5EA]">
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider">Indicadores de Saturación Técnica</span>
                                <span class="text-[10px] font-mono text-[#8E8E93]">% tickets aún abiertos</span>
                            </div>
                            <div class="space-y-2.5 max-h-[190px] overflow-y-auto pr-1">
                                <% 
                                    let areaDetalles = (typeof volumenPorArea !== 'undefined' && volumenPorArea.detalles) ? volumenPorArea.detalles : [];
                                    if ((!areaDetalles || areaDetalles.length === 0) && typeof volumenPorArea !== 'undefined' && volumenPorArea.labels && volumenPorArea.labels.length > 0) {
                                        const vLabels = volumenPorArea.labels;
                                        const vTotals = volumenPorArea.totales || volumenPorArea.data || volumenPorArea.values || [];
                                        const vClosed = volumenPorArea.cerrados || [];
                                        const vSats = volumenPorArea.saturaciones || [];
                                        areaDetalles = vLabels.map((lbl, idx) => {
                                             const tot = vTotals[idx] || 0;
                                             const cls = vClosed[idx] || 0;
                                             const sat = (typeof vSats[idx] !== 'undefined') ? vSats[idx] : (tot > 0 ? Math.round(((tot - cls) / tot) * 100) : 0);
                                             return { label: lbl, total: tot, cerrados: cls, saturacion: sat };
                                        });
                                    }
                                    if (areaDetalles.length > 0) {
                                        areaDetalles.forEach(areaItem => {
                                            const sat = areaItem.saturacion || 0;
                                            const isHigh = sat >= 60 && areaItem.total > 0;
                                            const isMid = sat >= 30 && sat < 60 && areaItem.total > 0;
                                %>
                                    <div class="flex flex-col gap-1 text-[11px]">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-1.5">
                                                <span class="font-medium text-[#1C1C1E]"><%= areaItem.label %></span>
                                                <span class="text-[10px] font-mono text-[#8E8E93]">(<%= areaItem.cerrados %>/<%= areaItem.total %> cerrados)</span>
                                            </div>
                                            <div class="flex items-center gap-1.5 font-mono">
                                                <% if (isHigh) { %>
                                                    <span class="text-[10px] font-bold text-[#D70015] bg-[#FFE5E5] px-1.5 py-0.2 rounded">Sat. <%= sat %>%</span>
                                                <% } else if (isMid) { %>
                                                    <span class="text-[10px] font-bold text-[#B25E02] bg-[#FFF4D6] px-1.5 py-0.2 rounded">Sat. <%= sat %>%</span>
                                                <% } else { %>
                                                    <span class="text-[10px] font-bold text-[#1B873F] bg-[#E3F9E5] px-1.5 py-0.2 rounded">Sat. <%= sat %>%</span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="w-full bg-[#E5E5EA] h-1.5 rounded-full overflow-hidden">
                                            <div class="h-full rounded-full transition-all duration-500 <%= isHigh ? 'bg-[#FF3B30]' : (isMid ? 'bg-[#FF9500]' : 'bg-[#34C759]') %>"
                                                 style="width: <%= Math.min(100, Math.max(0, sat)) %>%"></div>
                                        </div>
                                    </div>
                                <% 
                                        });
                                    } else { 
                                %>
                                    <span class="text-[11px] text-[#8E8E93]">No hay registros de saturación por área.</span>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Gráfica 5: Mediana de Tiempo de Resolución por Área (Últimas 24h) [Mitad] -->
                    <div class="figma-card p-5 sm:p-6 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between pb-3 border-b border-[#E5E5EA]">
                                <div>
                                    <h2 class="text-[14px] font-semibold text-[#1C1C1E] tracking-tight">Mediana de Tiempo de Resolución</h2>
                                    <p class="text-[11px] text-[#8E8E93] mt-0.5">Diferencia (resolución - creación) calculada en memoria para tickets de las últimas 24h</p>
                                </div>
                                <span class="text-[10px] font-mono text-sky-500 px-2 py-0.5 rounded bg-sky-500/10 font-semibold">ÚLTIMAS 24H</span>
                            </div>

                            <!-- ECharts Median Container -->
                            <div class="relative w-full mt-3">
                                <div id="medianResolutionChart" style="width: 100%; height: 300px;"></div>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-[#E5E5EA] flex items-center justify-between text-[11px] text-[#8E8E93]">
                            <span>Métrica: <strong class="text-[#1C1C1E]">Mediana de Duración (minutos)</strong></span>
                            <span class="font-mono text-[10px]"><%= typeof volumenPorArea !== 'undefined' && volumenPorArea.labels ? volumenPorArea.labels.length : 7 %> Áreas Monitoreadas</span>
                        </div>
                    </div>
                </section>
                <!-- END: Gráficas en Mitades -->

                <!-- Preservación de Resumen de Áreas para retrocompatibilidad de tests -->
                <div class="hidden" aria-hidden="true">
                    <span>Métrica activa: <strong class="text-[#1C1C1E]"><%= (typeof puntosPorArea !== 'undefined' && puntosPorArea.tipo) ? puntosPorArea.tipo : 'Puntos' %></strong></span>
                    <span class="font-mono text-[10px]"><%= typeof volumenPorArea !== 'undefined' && volumenPorArea.labels ? volumenPorArea.labels.length : 7 %> Áreas Monitoreadas</span>
                </div>
            </div>
            <!-- END: Tab 1 (Visión General) -->

            <!-- BEGIN: Tab 2 (Equipo) -->
            <div id="tab-team" class="tab-pane hidden flex flex-col gap-6" role="tabpanel" aria-labelledby="tab-btn-team">
                <!-- Gráfica 3: Barras por Operador (Agrupados por Área) - Asignados Totales vs Resueltos -->
                <section class="figma-card p-5 sm:p-6 flex flex-col flex-shrink-0">
                    <div class="flex items-center justify-between pb-3 border-b border-[#E5E5EA]">
                        <div>
                            <h2 class="text-[14px] font-semibold text-[#1C1C1E] tracking-tight">Rendimiento por Operador (Agrupado por Área)</h2>
                            <p class="text-[11px] text-[#8E8E93] mt-0.5">Comparativa de tickets asignados totales vs tickets resueltos por cada operador</p>
                        </div>
                        <span class="text-[10px] font-mono text-[#8E8E93] px-2 py-0.5 rounded bg-black/5 font-semibold">BARRAS AGRUPADAS</span>
                    </div>
                    <div class="relative w-full mt-4">
                        <div id="operatorBarChart" style="width: 100%; height: 300px;"></div>
                    </div>
                </section>

                <!-- BEGIN: Ranking de Operadores (Liquid Glass Table) - R1.4, R2.4 -->
                <section class="figma-card flex flex-col overflow-hidden mb-2">
                    <div class="px-5 py-4 border-b border-[#E5E5EA] bg-white/40 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div>
                            <h2 class="text-[14px] font-semibold text-[#1C1C1E] tracking-tight">Ranking de Operadores</h2>
                            <p class="text-[11px] text-[#8E8E93] mt-0.5">Rendimiento calculado en vivo: resolución, eficiencia histórica y semáforo de carga actual</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="inline-flex items-center gap-1 text-[11px] text-[#48484A] font-medium bg-[#F2F2F7] px-2.5 py-1 rounded-full border border-[#D1D1D6]">
                                <svg class="w-3.5 h-3.5 text-sky-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                                <span>Efectividad NOC</span>
                            </span>
                        </div>
                    </div>

                    <div class="overflow-x-auto overflow-y-auto max-h-[500px]">
                        <table class="w-full text-left border-collapse text-[12px]">
                            <thead class="bg-white/90 backdrop-blur-md sticky top-0 z-10 border-b border-[#E5E5EA]">
                                <tr>
                                    <th class="py-2.5 px-4 font-semibold text-[#8E8E93] uppercase tracking-wider text-[10px] w-12 text-center">Pos.</th>
                                    <th class="py-2.5 px-4 font-semibold text-[#8E8E93] uppercase tracking-wider text-[10px]">Operador</th>
                                    <th class="py-2.5 px-4 font-semibold text-[#8E8E93] uppercase tracking-wider text-[10px]">Área</th>
                                    <th class="py-2.5 px-4 font-semibold text-[#8E8E93] uppercase tracking-wider text-[10px] text-right">Asignados</th>
                                    <th class="py-2.5 px-4 font-semibold text-[#8E8E93] uppercase tracking-wider text-[10px] text-right">Cerrados</th>
                                    <th class="py-2.5 px-4 font-semibold text-[#8E8E93] uppercase tracking-wider text-[10px]">Eficiencia</th>
                                    <th class="py-2.5 px-4 font-semibold text-[#8E8E93] uppercase tracking-wider text-[10px]">Carga Actual</th>
                                    <th class="py-2.5 px-4 font-semibold text-[#8E8E93] uppercase tracking-wider text-[10px] text-right">Puntos Complejidad</th>
                                    <th class="py-2.5 px-4 font-semibold text-[#8E8E93] uppercase tracking-wider text-[10px]">Tiempo Promedio</th>
                                    <th class="py-2.5 px-4 font-semibold text-[#8E8E93] uppercase tracking-wider text-[10px] text-center">Estado</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#E5E5EA] bg-transparent">
                                <% const rankItems = (typeof ranking !== 'undefined' && ranking && ranking.length > 0) ? ranking : ((typeof rankingOperadores !== 'undefined' && rankingOperadores && rankingOperadores.length > 0) ? rankingOperadores : ((typeof operadores !== 'undefined' && operadores && operadores.length > 0) ? operadores : [])); %>
                                <% if (rankItems.length > 0) { %>
                                    <% rankItems.forEach((op, index) => { %>
                                    <tr class="hover:bg-white/60 transition-colors operator-ranking-row">
                                        <!-- Posición con medallas -->
                                        <td class="py-3 px-4 text-center">
                                             <% if (index === 0) { %>
                                                 <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#FFF4D6] text-[#B25E02] font-mono font-bold text-[11px] shadow-2xs">🥇</span>
                                             <% } else if (index === 1) { %>
                                                 <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#F2F2F7] text-[#48484A] font-mono font-bold text-[11px] shadow-2xs">🥈</span>
                                             <% } else if (index === 2) { %>
                                                 <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#FFE5E5] text-[#991B1B] font-mono font-bold text-[11px] shadow-2xs">🥉</span>
                                             <% } else { %>
                                                 <span class="inline-flex items-center justify-center w-6 h-6 text-[#8E8E93] font-mono font-semibold text-[11px]">#<%= index + 1 %></span>
                                             <% } %>
                                        </td>

                                        <!-- Operador Info -->
                                        <td class="py-3 px-4">
                                            <div class="flex items-center gap-2.5">
                                                <div class="w-7 h-7 rounded-full bg-sky-500 text-white flex items-center justify-center font-mono font-semibold text-[10px] flex-shrink-0 shadow-2xs">
                                                    <%= op.nombre && op.nombre.trim() ? (op.nombre.trim().split(/\s+/).slice(0, 2).map(p => p.charAt(0)).join('').toUpperCase() || 'OP') : 'OP' %>
                                                </div>
                                                <div class="flex flex-col min-w-0">
                                                    <span class="font-medium text-[#1C1C1E] truncate"><%= op.nombre || 'Operador' %></span>
                                                    <span class="text-[10px] font-mono text-[#8E8E93] truncate"><%= op.email || 'Sin correo' %></span>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Área -->
                                        <td class="py-3 px-4">
                                            <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-medium bg-[#F2F2F7] text-[#48484A] border border-[#E5E5EA]">
                                                <%= op.area || 'General' %>
                                            </span>
                                        </td>

                                        <!-- Asignados Totales (R1.4) -->
                                        <td class="py-3 px-4 text-right">
                                            <span class="font-mono text-[#48484A] font-medium num-tabular">
                                                <%= typeof op.asignadosTotales !== 'undefined' ? op.asignadosTotales : (typeof op.asignados !== 'undefined' ? op.asignados : 0) %>
                                            </span>
                                        </td>

                                        <!-- Tickets Cerrados / Resueltos (R1.4) -->
                                        <td class="py-3 px-4 text-right">
                                            <span class="font-mono text-[#1C1C1E] font-semibold num-tabular">
                                                <%= typeof op.cerrados !== 'undefined' ? op.cerrados : (op.resueltos || 0) %>
                                            </span>
                                        </td>

                                        <!-- Eficiencia (Barra de Porcentaje) - R1.4, R2.4 -->
                                        <td class="py-3 px-4 min-w-[130px]">
                                            <% 
                                                const ef = typeof op.eficiencia !== 'undefined' ? Number(op.eficiencia) : 0;
                                            %>
                                            <div class="flex items-center gap-2">
                                                <span class="font-mono font-semibold text-[11px] text-[#1C1C1E] w-9 text-right num-tabular"><%= ef %>%</span>
                                                <div class="w-16 bg-[#E5E5EA] rounded-full h-1.5 overflow-hidden flex-shrink-0">
                                                    <div class="h-full rounded-full transition-all duration-300 <%= ef >= 80 ? 'bg-[#34C759]' : (ef >= 50 ? 'bg-sky-500' : 'bg-[#FF9500]') %>"
                                                         style="width: <%= Math.min(100, Math.max(0, ef)) %>%"></div>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Carga Actual (Semáforo Verde/Amarillo/Rojo) - R1.4, R2.4 -->
                                        <td class="py-3 px-4 min-w-[130px]">
                                            <% 
                                                const carga = typeof op.cargaActual !== 'undefined' ? Number(op.cargaActual) : (typeof op.carga !== 'undefined' ? Number(op.carga) : 0);
                                            %>
                                            <% if (carga <= 2) { %>
                                                <!-- Baja (Verde) -->
                                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#E3F9E5] text-[#1B873F] border border-[#BCE8C5]">
                                                    <span class="w-2 h-2 rounded-full bg-[#34C759]"></span>
                                                    <span><%= carga %> activas (Baja)</span>
                                                </span>
                                            <% } else if (carga <= 4) { %>
                                                <!-- Media (Amarillo) -->
                                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#FFF4D6] text-[#B25E02] border border-[#FFE8A3]">
                                                    <span class="w-2 h-2 rounded-full bg-[#FF9500]"></span>
                                                    <span><%= carga %> activas (Media)</span>
                                                </span>
                                            <% } else { %>
                                                <!-- Alta (Rojo) -->
                                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#FFE5E5] text-[#D70015] border border-[#FFC2C2]">
                                                    <span class="w-2 h-2 rounded-full bg-[#FF3B30] animate-pulse"></span>
                                                    <span><%= carga %> activas (Alta)</span>
                                                </span>
                                            <% } %>
                                        </td>

                                        <!-- Puntos Complejidad -->
                                        <td class="py-3 px-4 text-right">
                                            <span class="text-sky-600 font-mono font-bold text-[12px] num-tabular">
                                                <%= op.puntos || 0 %> <span class="text-[10px] font-sans font-medium text-[#8E8E93]">pts</span>
                                            </span>
                                        </td>

                                        <!-- Tiempo Promedio -->
                                        <td class="py-3 px-4 font-mono text-[#48484A]">
                                            <%= op.tiempoPromedio || 'N/A' %>
                                        </td>

                                        <!-- Estado Operativo -->
                                        <td class="py-3 px-4 text-center">
                                            <% if (op.estado === 'DISPONIBLE') { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#E3F9E5] text-[#1B873F] border border-[#BCE8C5]">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-[#34C759]"></span> Disponible
                                                </span>
                                            <% } else if (op.estado === 'EN_TERRENO') { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-sky-50 text-sky-700 border border-sky-200">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span> En Terreno
                                                </span>
                                            <% } else if (op.estado === 'AUSENTE') { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#F2F2F7] text-[#8E8E93] border border-[#E5E5EA]">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-[#8E8E93]"></span> Ausente
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#F2F2F7] text-[#8E8E93] border border-[#E5E5EA]">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-[#8E8E93]"></span> <%= op.estado || 'Ausente' %>
                                                </span>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                    <tr id="rankingNoMatchRow" class="hidden">
                                        <td colspan="10" class="py-8 text-center text-[#8E8E93]">
                                            No se encontraron operadores que coincidan con la búsqueda.
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <tr>
                                        <td colspan="10" class="py-8 text-center text-[#8E8E93]">
                                            No hay operadores registrados para mostrar en el ranking.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </section>
                <!-- END: Ranking Table -->
            </div>
            <!-- END: Tab 2 (Equipo) -->

            <!-- BEGIN: Tab 3 (Geografía) -->
            <div id="tab-geo" class="tab-pane hidden flex flex-col gap-6" role="tabpanel" aria-labelledby="tab-btn-geo">
                <!-- BEGIN: Mapa de Venezuela Interactivo por Estados -->
                <section class="figma-card p-5 sm:p-6 lg:p-7 flex flex-col flex-shrink-0" id="venezuela-map-section">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-[#E5E5EA]">
                        <div>
                            <h2 class="text-[14px] font-semibold text-[#1C1C1E] tracking-tight">Distribución Territorial de Incidencias</h2>
                            <p class="text-[11px] text-[#8E8E93] mt-0.5">Monitoreo en vivo de tickets e impacto operativo por estados de Venezuela</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-mono font-semibold bg-sky-500/10 text-sky-500 border border-sky-500/20">
                                <span class="w-2 h-2 rounded-full bg-sky-500"></span>
                                24 Entidades Federales
                            </span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-4 items-center">
                        <!-- Left: Mapa SVG de Venezuela -->
                        <div class="lg:col-span-8 relative flex items-center justify-center min-h-[380px] sm:min-h-[460px] bg-white/40 rounded-[12px] p-4 border border-[#E5E5EA]/60 overflow-hidden">
                            <div id="venezuela-map-container" class="w-full h-full flex items-center justify-center max-h-[460px]">
                                <div class="flex flex-col items-center gap-2 text-[#8E8E93] animate-pulse">
                                    <svg class="w-6 h-6 animate-spin text-sky-500" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                    </svg>
                                    <span class="text-[11px] font-mono">Cargando mapa vectorial de Venezuela...</span>
                                </div>
                            </div>

                            <!-- Floating Liquid Glass Tooltip for Map (Dark macOS Style) -->
                            <div id="map-state-tooltip" class="fixed hidden pointer-events-none z-50 px-3 py-2 rounded-[8px] bg-[#1C1C1E]/95 backdrop-blur-md border border-white/10 shadow-[0_8px_24px_rgba(0,0,0,0.28)] text-[12px] transition-opacity duration-150 text-white">
                                <div class="flex items-center gap-2 font-bold text-white">
                                    <span class="w-2 h-2 rounded-full bg-sky-500" id="tooltip-state-dot"></span>
                                    <span id="tooltip-state-name">Estado</span>
                                </div>
                                <div class="text-[11px] text-[#AEAEB2] mt-1 space-y-0.5">
                                    <div>Tickets Totales: <strong class="font-mono text-white" id="tooltip-state-total">0</strong></div>
                                    <div class="flex items-center gap-2 text-[10px]">
                                        <span class="text-[#FF453A]">Abiertos: <strong id="tooltip-state-open">0</strong></span>
                                        <span class="text-[#30D158]">Cerrados: <strong id="tooltip-state-closed">0</strong></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Resumen de Estados con Mayor Actividad -->
                        <div class="lg:col-span-4 flex flex-col justify-between h-full space-y-4">
                            <div>
                                <div class="flex items-center justify-between pb-2 border-b border-[#E5E5EA]">
                                    <span class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider">Top Estados con Mayor Carga</span>
                                    <span class="text-[10px] font-mono text-[#8E8E93]">Incidencias</span>
                                </div>
                                <div class="space-y-2 mt-3 max-h-[340px] overflow-y-auto pr-1" id="top-states-list">
                                    <% 
                                        const estadosList = (typeof distribucionPorEstado !== 'undefined' && distribucionPorEstado) ? distribucionPorEstado.slice(0, 7) : [];
                                        if (estadosList.length > 0) {
                                            estadosList.forEach((st, idx) => {
                                    %>
                                        <div class="flex items-center justify-between p-2 rounded-[8px] hover:bg-white/80 transition-all border border-transparent hover:border-[#E5E5EA] text-[11px] state-list-item cursor-pointer" data-state-id="<%= st.id %>">
                                            <div class="flex items-center gap-2 min-w-0">
                                                <span class="w-5 h-5 rounded-full bg-[#F2F2F7] text-[#48484A] font-mono font-semibold text-[10px] flex items-center justify-center flex-shrink-0">
                                                    <%= idx + 1 %>
                                                </span>
                                                <span class="font-medium text-[#1C1C1E] truncate"><%= st.nombre %></span>
                                            </div>
                                            <div class="flex items-center gap-2 font-mono flex-shrink-0">
                                                <span class="text-[#1C1C1E] font-semibold"><%= st.total %> tickets</span>
                                                <span class="text-[10px] text-[#8E8E93]">(<%= st.porcentaje %>%)</span>
                                            </div>
                                        </div>
                                    <% 
                                            });
                                        } else { 
                                    %>
                                        <span class="text-[11px] text-[#8E8E93]">Sin registros territoriales.</span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Legend Bar -->
                            <div class="p-3 rounded-[8px] bg-white/70 border border-[#E5E5EA] space-y-1.5">
                                <span class="text-[10px] font-semibold text-[#8E8E93] uppercase tracking-wider block">Intensidad de Incidencias</span>
                                <div class="w-full h-2 rounded-full overflow-hidden flex" style="background: linear-gradient(90deg, #E5E5EA 0%, #E0F2FE 25%, #7DD3FC 50%, #0EA5E9 75%, #0369A1 100%);"></div>
                                <div class="flex justify-between text-[9px] font-mono text-[#8E8E93]">
                                    <span>Baja</span>
                                    <span>Media</span>
                                    <span>Crítica</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- END: Mapa de Venezuela -->
            </div>
            <!-- END: Tab 3 (Geografía) -->

            </main>
        </div>
    </div>

    <!-- Raw Report Data safely encoded for Client-Side Charts -->
    <script id="report-data-json" type="application/json">
        <%- JSON.stringify(typeof reportData !== 'undefined' ? reportData : {}).replace(/</g, '\\u003c') %>
    </script>

    <!-- Client-side logic for Apache ECharts & Shortcuts -->
    <script>
        document.addEventListener('keydown', function (e) {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                const searchInput = document.getElementById('globalSearchInput');
                if (searchInput) {
                    searchInput.focus();
                    searchInput.select();
                }
            }
        });

        // Filtro en tiempo real para el ranking de operadores
        (function setupRankingFilter() {
            const searchInput = document.getElementById('globalSearchInput');
            if (!searchInput) return;

            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    searchInput.value = '';
                    searchInput.dispatchEvent(new Event('input'));
                    searchInput.blur();
                }
            });

            searchInput.addEventListener('input', function(e) {
                const query = (e.target.value || '').toLowerCase().trim();
                const rows = document.querySelectorAll('.operator-ranking-row');
                let matchCount = 0;

                // Auto-switch to Team tab if user is actively searching an operator
                if (query.length > 0 && typeof window.switchReportsTab === 'function') {
                    const teamPane = document.getElementById('tab-team');
                    if (teamPane && teamPane.classList.contains('hidden')) {
                        window.switchReportsTab('tab-team');
                    }
                }

                rows.forEach(function(row) {
                    const text = (row.textContent || '').toLowerCase();
                    const visible = !query || text.includes(query);
                    row.style.display = visible ? '' : 'none';
                    if (visible) matchCount++;
                });

                const noMatchRow = document.getElementById('rankingNoMatchRow');
                if (noMatchRow) {
                    if (rows.length > 0 && matchCount === 0 && query.length > 0) {
                        noMatchRow.classList.remove('hidden');
                    } else {
                        noMatchRow.classList.add('hidden');
                    }
                }
            });
        })();

        // Initialize Charts when DOM is fully loaded & Apache ECharts is ready
        (function() {
            function escapeHtml(str) {
                if (str == null) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function getReportData() {
                let reportData = {
                    kpis: {},
                    volumenPorArea: { labels: [], data: [], totales: [], cerrados: [], creados: [], asignados: [], resueltos: [], rechazados: [] },
                    areaTickets: { labels: [], creados: [], asignados: [], resueltos: [], rechazados: [] },
                    barrasOperadores: { labels: [], asignados: [], resueltos: [] },
                    puntosPorArea: { labels: [], data: [] },
                    flujoPorHora: { labels: [], creados: [], asignados: [], cerrados: [] },
                    medianaTiempoPorArea: { labels: [], data: [], formateado: [] },
                    rankingOperadores: []
                };
                try {
                    const dataEl = document.getElementById('report-data-json');
                    if (dataEl && dataEl.textContent.trim()) {
                        const parsed = JSON.parse(dataEl.textContent);
                        if (parsed && typeof parsed === 'object') {
                            reportData = parsed;
                        }
                    }
                } catch (err) {
                    console.error('Error al inicializar reportData:', err);
                }
                return reportData;
            }

            const echartsInstances = [];

            function initCharts() {
                if (typeof echarts === 'undefined') return;
                const reportData = getReportData();

                // 1. Gráfica 4: Flujo 24h (hourlyFlowChart)
                const flowEl = document.getElementById('hourlyFlowChart');
                if (flowEl) {
                    const flujo = reportData.flujoPorHora || reportData.flujo_por_hora || {};
                    const defaultHours = Array.from({ length: 24 }, (_, i) => `${String(i).padStart(2, '0')}:00`);
                    const flujoLabels = (flujo.labels && flujo.labels.length > 0) ? flujo.labels : defaultHours;
                    const rawCreados = flujo.creados || [];
                    const rawAsignados = flujo.asignados || [];
                    const rawCerrados = flujo.cerrados || [];
                    const safeCreados = flujoLabels.map((_, i) => {
                        const n = Number(rawCreados[i]);
                        return (!isNaN(n) && isFinite(n) && n >= 0) ? n : 0;
                    });
                    const safeAsignados = flujoLabels.map((_, i) => {
                        const n = Number(rawAsignados[i]);
                        return (!isNaN(n) && isFinite(n) && n >= 0) ? n : 0;
                    });
                    const safeCerrados = flujoLabels.map((_, i) => {
                        const n = Number(rawCerrados[i]);
                        return (!isNaN(n) && isFinite(n) && n >= 0) ? n : 0;
                    });

                    const flowChart = echarts.init(flowEl);
                    flowChart.setOption({
                        tooltip: {
                            trigger: 'axis',
                            backgroundColor: 'rgba(28, 28, 30, 0.94)',
                            borderColor: 'rgba(255, 255, 255, 0.2)',
                            textStyle: { color: '#FFFFFF', fontSize: 12 },
                            borderRadius: 8
                        },
                        legend: {
                            data: ['Creados Hoy', 'Asignados Hoy', 'Cerrados Hoy'],
                            top: 0,
                            textStyle: { color: '#1C1C1E', fontSize: 11 }
                        },
                        grid: {
                            top: 40,
                            left: 20,
                            right: 20,
                            bottom: 20,
                            containLabel: true
                        },
                        xAxis: {
                            type: 'category',
                            data: flujoLabels,
                            boundaryGap: false,
                            axisLine: { show: false },
                            axisTick: { show: false },
                            axisLabel: { color: '#8E8E93', fontSize: 10 }
                        },
                        yAxis: {
                            type: 'value',
                            minInterval: 1,
                            axisLine: { show: false },
                            axisTick: { show: false },
                            axisLabel: { color: '#8E8E93', fontSize: 10 },
                            splitLine: {
                                lineStyle: { color: 'rgba(0,0,0,0.05)' }
                            }
                        },
                        series: [
                            {
                                name: 'Creados Hoy',
                                type: 'line',
                                smooth: true,
                                data: safeCreados,
                                lineStyle: { color: '#1C1C1E', width: 2.5 },
                                itemStyle: { color: '#1C1C1E' },
                                showSymbol: false,
                                areaStyle: {
                                    color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                                        { offset: 0, color: 'rgba(28, 28, 30, 0.12)' },
                                        { offset: 1, color: 'rgba(28, 28, 30, 0.00)' }
                                    ])
                                }
                            },
                            {
                                name: 'Asignados Hoy',
                                type: 'line',
                                smooth: true,
                                data: safeAsignados,
                                lineStyle: { color: '#0ea5e9', width: 2 },
                                itemStyle: { color: '#0ea5e9' },
                                showSymbol: false,
                                areaStyle: {
                                    color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                                        { offset: 0, color: 'rgba(14, 165, 233, 0.15)' },
                                        { offset: 1, color: 'rgba(14, 165, 233, 0.00)' }
                                    ])
                                }
                            },
                            {
                                name: 'Cerrados Hoy',
                                type: 'line',
                                smooth: true,
                                data: safeCerrados,
                                lineStyle: { color: '#34C759', width: 2 },
                                itemStyle: { color: '#34C759' },
                                showSymbol: false,
                                areaStyle: {
                                    color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                                        { offset: 0, color: 'rgba(52, 199, 89, 0.12)' },
                                        { offset: 1, color: 'rgba(52, 199, 89, 0.00)' }
                                    ])
                                }
                            }
                        ]
                    });
                    echartsInstances.push(flowChart);
                }

                // 2. Gráfica 1: Área vs Tickets (areaTicketsChart)
                const areaEl = document.getElementById('areaTicketsChart');
                if (areaEl) {
                    const volumen = reportData.areaTickets || reportData.volumenPorArea || reportData.volumen_por_area || {};
                    const barLabels = Array.isArray(volumen.labels) ? volumen.labels : [];
                    const rawTotal = Array.isArray(volumen.creados) ? volumen.creados
                        : (Array.isArray(volumen.asignados) ? volumen.asignados
                        : (Array.isArray(volumen.totales) ? volumen.totales
                        : (Array.isArray(volumen.data) ? volumen.data
                        : (Array.isArray(volumen.values) ? volumen.values : []))));
                    const rawClosed = Array.isArray(volumen.resueltos) ? volumen.resueltos
                        : (Array.isArray(volumen.cerrados) ? volumen.cerrados : []);
                    const rawRech = Array.isArray(volumen.rechazados) ? volumen.rechazados : barLabels.map(() => 0);

                    const safeTotal = barLabels.map((_, i) => {
                        const n = Number(rawTotal[i]);
                        return (!isNaN(n) && isFinite(n) && n >= 0) ? n : 0;
                    });
                    const safeClosed = barLabels.map((_, i) => {
                        const n = Number(rawClosed[i]);
                        return (!isNaN(n) && isFinite(n) && n >= 0) ? n : 0;
                    });
                    const safeRech = barLabels.map((_, i) => {
                        const n = Number(rawRech[i]);
                        return (!isNaN(n) && isFinite(n) && n >= 0) ? n : 0;
                    });

                    const areaChart = echarts.init(areaEl);
                    areaChart.setOption({
                        tooltip: {
                            trigger: 'axis',
                            axisPointer: { type: 'shadow' },
                            backgroundColor: 'rgba(28, 28, 30, 0.94)',
                            borderColor: 'rgba(255, 255, 255, 0.2)',
                            textStyle: { color: '#FFFFFF', fontSize: 12 },
                            borderRadius: 8
                        },
                        legend: {
                            data: ['Asignados / Creados', 'Resueltos', 'Rechazados'],
                            top: 0,
                            textStyle: { color: '#1C1C1E', fontSize: 11 }
                        },
                        grid: {
                            top: 40,
                            left: 20,
                            right: 20,
                            bottom: 30,
                            containLabel: true
                        },
                        xAxis: {
                            type: 'category',
                            data: barLabels,
                            axisLine: { show: false },
                            axisTick: { show: false },
                            axisLabel: {
                                color: '#1C1C1E',
                                fontSize: 10,
                                interval: 0,
                                rotate: barLabels.length > 4 ? 20 : 0
                            }
                        },
                        yAxis: {
                            type: 'value',
                            minInterval: 1,
                            axisLine: { show: false },
                            axisTick: { show: false },
                            axisLabel: { color: '#8E8E93', fontSize: 10 },
                            splitLine: {
                                lineStyle: { color: 'rgba(0,0,0,0.05)' }
                            }
                        },
                        series: [
                            {
                                name: 'Asignados / Creados',
                                type: 'bar',
                                data: safeTotal,
                                showBackground: true,
                                backgroundStyle: { borderRadius: 20, color: 'rgba(255,255,255,0.5)' },
                                itemStyle: { borderRadius: 20, color: '#85A8E0' },
                                barGap: '20%'
                            },
                            {
                                name: 'Resueltos',
                                type: 'bar',
                                data: safeClosed,
                                showBackground: true,
                                backgroundStyle: { borderRadius: 20, color: 'rgba(255,255,255,0.5)' },
                                itemStyle: { borderRadius: 20, color: '#4FE0B5' }
                            },
                            {
                                name: 'Rechazados',
                                type: 'bar',
                                data: safeRech,
                                showBackground: true,
                                backgroundStyle: { borderRadius: 20, color: 'rgba(255,255,255,0.5)' },
                                itemStyle: { borderRadius: 20, color: '#FF8A80' }
                            }
                        ]
                    });
                    echartsInstances.push(areaChart);
                }

                // 3. Gráfica 5: Mediana de Resolución (medianResolutionChart)
                const medianEl = document.getElementById('medianResolutionChart');
                if (medianEl) {
                    const medData = reportData.medianaTiempoPorArea || reportData.mediana_tiempo_por_area || {};
                    let medLabels = Array.isArray(medData.labels) ? medData.labels : [];
                    let medValues = Array.isArray(medData.data) ? medData.data
                        : (Array.isArray(medData.valoresMinutos) ? medData.valoresMinutos : []);
                    let medFormateados = Array.isArray(medData.formateado) ? medData.formateado : [];

                    if ((!medLabels || medLabels.length === 0) && medData.detalles && Array.isArray(medData.detalles)) {
                        medLabels = medData.detalles.map(d => d.area || d.label || 'General');
                        medValues = medData.detalles.map(d => d.medianaMinutos ?? d.mediana ?? 0);
                        medFormateados = medData.detalles.map(d => d.formateado || (d.medianaMinutos > 0 ? (d.medianaMinutos >= 60 ? (d.medianaMinutos/60).toFixed(1) + ' h' : d.medianaMinutos + ' min') : 'N/A'));
                    }

                    const safeMed = medLabels.map((_, i) => {
                        const n = Number(medValues[i]);
                        return (!isNaN(n) && isFinite(n) && n >= 0) ? n : 0;
                    });

                    const medianChart = echarts.init(medianEl);
                    medianChart.setOption({
                        tooltip: {
                            trigger: 'axis',
                            axisPointer: { type: 'shadow' },
                            backgroundColor: 'rgba(28, 28, 30, 0.94)',
                            borderColor: 'rgba(255, 255, 255, 0.2)',
                            textStyle: { color: '#FFFFFF', fontSize: 12 },
                            borderRadius: 8,
                            formatter: function(params) {
                                if (!params || !params[0]) return '';
                                const p = params[0];
                                const idx = p.dataIndex;
                                const fmt = (medFormateados && medFormateados[idx]) || (p.value > 0 ? `${p.value} min` : 'N/A');
                                return `${p.name}: <b>${fmt}</b> (${p.value} min)`;
                            }
                        },
                        grid: {
                            top: 20,
                            left: 20,
                            right: 40,
                            bottom: 20,
                            containLabel: true
                        },
                        xAxis: {
                            type: 'value',
                            axisLine: { show: false },
                            axisTick: { show: false },
                            axisLabel: {
                                color: '#8E8E93',
                                fontSize: 10,
                                formatter: '{value}m'
                            },
                            splitLine: {
                                lineStyle: { color: 'rgba(0,0,0,0.05)' }
                            }
                        },
                        yAxis: {
                            type: 'category',
                            data: medLabels,
                            inverse: true,
                            axisLine: { show: false },
                            axisTick: { show: false },
                            axisLabel: {
                                color: '#1C1C1E',
                                fontSize: 11,
                                width: 120,
                                overflow: 'truncate'
                            }
                        },
                        series: [
                            {
                                name: 'Duración Mediana',
                                type: 'bar',
                                data: safeMed,
                                showBackground: true,
                                backgroundStyle: { borderRadius: 20, color: 'rgba(255,255,255,0.5)' },
                                itemStyle: {
                                    borderRadius: 20,
                                    color: new echarts.graphic.LinearGradient(1, 0, 0, 0, [
                                        { offset: 0, color: '#38bdf8' },
                                        { offset: 1, color: '#0284c7' }
                                    ])
                                },
                                label: {
                                    show: true,
                                    position: 'right',
                                    formatter: function(p) {
                                        return (medFormateados && medFormateados[p.dataIndex]) || (p.value > 0 ? p.value + 'm' : 'N/A');
                                    },
                                    color: '#1C1C1E',
                                    fontSize: 10,
                                    fontFamily: 'SF Mono, monospace'
                                }
                            }
                        ]
                    });
                    echartsInstances.push(medianChart);
                }

                // 4. Gráfica 3: Operadores (operatorBarChart)
                const opEl = document.getElementById('operatorBarChart');
                if (opEl) {
                    const barrasOp = reportData.barrasOperadores || reportData.barras_operadores || reportData.operadoresBarras || {};
                    const opLabels = (barrasOp.labels && barrasOp.labels.length > 0)
                        ? barrasOp.labels
                        : (reportData.rankingOperadores || []).map(o => `${o.nombre} (${o.area || o.area_designada || 'General'})`);
                    const rawAsignadosOp = (barrasOp.asignados && barrasOp.asignados.length > 0)
                        ? barrasOp.asignados
                        : (reportData.rankingOperadores || []).map(o => o.asignadosTotales ?? o.asignados ?? 0);
                    const rawResueltosOp = (barrasOp.resueltos && barrasOp.resueltos.length > 0)
                        ? barrasOp.resueltos
                        : (reportData.rankingOperadores || []).map(o => o.cerrados ?? o.resueltos ?? 0);

                    const safeAsignadosOp = opLabels.map((_, i) => {
                        const n = Number(rawAsignadosOp[i]);
                        return (!isNaN(n) && isFinite(n) && n >= 0) ? n : 0;
                    });
                    const safeResueltosOp = opLabels.map((_, i) => {
                        const n = Number(rawResueltosOp[i]);
                        return (!isNaN(n) && isFinite(n) && n >= 0) ? n : 0;
                    });

                    const opChart = echarts.init(opEl);
                    opChart.setOption({
                        tooltip: {
                            trigger: 'axis',
                            axisPointer: { type: 'shadow' },
                            backgroundColor: 'rgba(28, 28, 30, 0.94)',
                            borderColor: 'rgba(255, 255, 255, 0.2)',
                            textStyle: { color: '#FFFFFF', fontSize: 12 },
                            borderRadius: 8
                        },
                        legend: {
                            data: ['Asignados Totales', 'Resueltos'],
                            top: 0,
                            textStyle: { color: '#1C1C1E', fontSize: 11 }
                        },
                        grid: {
                            top: 40,
                            left: 20,
                            right: 20,
                            bottom: 40,
                            containLabel: true
                        },
                        xAxis: {
                            type: 'category',
                            data: opLabels,
                            axisLine: { show: false },
                            axisTick: { show: false },
                            axisLabel: {
                                color: '#1C1C1E',
                                fontSize: 10,
                                interval: 0,
                                rotate: opLabels.length > 3 ? 20 : 0
                            }
                        },
                        yAxis: {
                            type: 'value',
                            minInterval: 1,
                            axisLine: { show: false },
                            axisTick: { show: false },
                            axisLabel: { color: '#8E8E93', fontSize: 10 },
                            splitLine: {
                                lineStyle: { color: 'rgba(0,0,0,0.05)' }
                            }
                        },
                        series: [
                            {
                                name: 'Asignados Totales',
                                type: 'bar',
                                data: safeAsignadosOp,
                                showBackground: true,
                                backgroundStyle: { borderRadius: 20, color: 'rgba(255,255,255,0.5)' },
                                itemStyle: { borderRadius: 20, color: '#85A8E0' },
                                barGap: '20%'
                            },
                            {
                                name: 'Resueltos',
                                type: 'bar',
                                data: safeResueltosOp,
                                showBackground: true,
                                backgroundStyle: { borderRadius: 20, color: 'rgba(255,255,255,0.5)' },
                                itemStyle: { borderRadius: 20, color: '#4FE0B5' }
                            }
                        ]
                    });
                    echartsInstances.push(opChart);
                }

                initVenezuelaMap(reportData);

                // Global resize listener
                if (typeof window !== 'undefined') {
                    window.addEventListener('resize', function() {
                        echartsInstances.forEach(function(chart) {
                            if (chart && typeof chart.resize === 'function') {
                                const dom = chart.getDom ? chart.getDom() : null;
                                if (!dom || dom.offsetParent !== null) {
                                    chart.resize();
                                }
                            }
                        });
                    });
                }
            }

            function initVenezuelaMap(reportData) {
                const mapContainer = document.getElementById('venezuela-map-container');
                const tooltip = document.getElementById('map-state-tooltip');
                if (!mapContainer) return;

                const distEstados = (reportData && (reportData.distribucionPorEstado || reportData.distribucion_por_estado)) || [];
                const stateDataMap = {};
                distEstados.forEach(st => {
                    stateDataMap[st.id] = st;
                });

                fetch('/maps/venezuela.svg')
                    .then(res => {
                        if (!res.ok) throw new Error('No se pudo cargar el mapa SVG');
                        return res.text();
                    })
                    .then(svgText => {
                        mapContainer.innerHTML = svgText;
                        const svg = mapContainer.querySelector('svg');
                        if (!svg) return;

                        svg.setAttribute('width', '100%');
                        svg.setAttribute('height', '100%');
                        svg.style.maxHeight = '390px';
                        svg.style.filter = 'drop-shadow(0 4px 14px rgba(0, 0, 0, 0.05))';

                        const getColorForCount = (count) => {
                            if (count === 0) return 'rgba(229, 229, 234, 0.7)';
                            if (count <= 2) return '#E0F2FE';
                            if (count <= 5) return '#7DD3FC';
                            if (count <= 10) return '#0EA5E9';
                            return '#0284C7';
                        };

                        const paths = svg.querySelectorAll('path');
                        paths.forEach(path => {
                            const stateId = path.getAttribute('id');
                            const stateName = path.getAttribute('name') || stateId;
                            const sData = stateDataMap[stateId] || { total: 0, abiertos: 0, cerrados: 0, nombre: stateName };

                            const baseColor = getColorForCount(sData.total);
                            path.setAttribute('fill', baseColor);
                            path.setAttribute('stroke', '#FFFFFF');
                            path.setAttribute('stroke-width', '1');
                            path.style.transition = 'all 0.25s ease';
                            path.style.cursor = 'pointer';

                            path.addEventListener('mouseenter', function() {
                                path.setAttribute('fill', sData.total > 0 ? '#0284C7' : '#C7C7CC');
                                path.setAttribute('stroke', '#0EA5E9');
                                path.setAttribute('stroke-width', '2');
                                path.style.filter = 'drop-shadow(0 2px 8px rgba(14, 165, 233, 0.35))';

                                if (tooltip) {
                                    const dot = document.getElementById('tooltip-state-dot');
                                    if (dot) {
                                        dot.className = 'w-2 h-2 rounded-full ' + (sData.abiertos > 0 ? 'bg-[#FF3B30]' : 'bg-[#34C759]');
                                    }
                                    document.getElementById('tooltip-state-name').textContent = sData.nombre || stateName;
                                    document.getElementById('tooltip-state-total').textContent = sData.total;
                                    document.getElementById('tooltip-state-open').textContent = sData.abiertos;
                                    document.getElementById('tooltip-state-closed').textContent = sData.cerrados;
                                    tooltip.classList.remove('hidden');
                                }
                            });

                            path.addEventListener('mousemove', function(e) {
                                if (tooltip) {
                                    tooltip.style.left = (e.clientX + 16) + 'px';
                                    tooltip.style.top = (e.clientY + 16) + 'px';
                                }
                            });

                            path.addEventListener('mouseleave', function() {
                                path.setAttribute('fill', baseColor);
                                path.setAttribute('stroke', '#FFFFFF');
                                path.setAttribute('stroke-width', '1');
                                path.style.filter = 'none';
                                if (tooltip) tooltip.classList.add('hidden');
                            });
                        });

                        // Hover sincronizado entre la lista lateral y los estados del mapa
                        document.querySelectorAll('.state-list-item').forEach(item => {
                            const sId = item.getAttribute('data-state-id');
                            const targetPath = svg.querySelector(`path#${sId}`);
                            if (!targetPath) return;

                            item.addEventListener('mouseenter', () => {
                                targetPath.dispatchEvent(new Event('mouseenter'));
                            });
                            item.addEventListener('mouseleave', () => {
                                targetPath.dispatchEvent(new Event('mouseleave'));
                            });
                        });
                    })
                    .catch(err => {
                        console.warn('Error al cargar mapa vectorial de Venezuela:', err);
                        mapContainer.innerHTML = '<span class="text-[11px] text-[#8E8E93]">No fue posible inicializar el mapa vectorial.</span>';
                    });
            }

            // Tab Switching Controller for macOS Segmented Controls
            function setupTabNavigation() {
                const tabButtons = document.querySelectorAll('.report-tab-btn');
                const tabPanes = document.querySelectorAll('.tab-pane');
                if (!tabButtons.length || !tabPanes.length) return;

                function switchTab(targetId) {
                    if (!targetId) return;
                    const targetPane = document.getElementById(targetId);
                    if (!targetPane) return;

                    tabButtons.forEach(btn => {
                        const isTarget = btn.getAttribute('data-target') === targetId;
                        btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
                        if (isTarget) {
                            btn.className = 'report-tab-btn flex items-center gap-2 px-4 py-1.5 rounded-[9px] text-[12px] font-semibold bg-white text-[#1C1C1E] shadow-sm transition-all duration-200';
                        } else {
                            btn.className = 'report-tab-btn flex items-center gap-2 px-4 py-1.5 rounded-[9px] text-[12px] font-medium text-[#8E8E93] hover:text-[#1C1C1E] hover:bg-white/40 transition-all duration-200';
                        }

                        // Sincronizar color de acento de icono en pestaña activa / inactiva
                        const icon = btn.querySelector('svg');
                        if (icon) {
                            if (isTarget) {
                                icon.classList.remove('text-[#8E8E93]');
                                icon.classList.add('text-sky-500');
                            } else {
                                icon.classList.remove('text-sky-500');
                                icon.classList.add('text-[#8E8E93]');
                            }
                        }
                    });

                    tabPanes.forEach(pane => {
                        if (pane.id === targetId) {
                            pane.classList.remove('hidden');
                            pane.setAttribute('aria-hidden', 'false');
                            // Forzar cálculo de reflow antes de redimensionar gráficas
                            void pane.offsetWidth;
                        } else {
                            pane.classList.add('hidden');
                            pane.setAttribute('aria-hidden', 'true');
                        }
                    });

                    // Trigger chart resize upon tab visibility change
                    requestAnimationFrame(() => {
                        const activePane = document.getElementById(targetId);
                        if (!activePane || activePane.classList.contains('hidden')) return;

                        echartsInstances.forEach(function(chart) {
                            if (chart && typeof chart.resize === 'function') {
                                const dom = chart.getDom ? chart.getDom() : null;
                                if (!dom || dom.offsetParent !== null) {
                                    chart.resize();
                                }
                            }
                        });

                        const chartsByTab = {
                            'tab-overview': ['hourlyFlowChart', 'areaTicketsChart', 'medianResolutionChart'],
                            'tab-team': ['operatorBarChart'],
                            'tab-geo': []
                        };
                        const tabChartIds = chartsByTab[targetId] || [];
                        tabChartIds.forEach(id => {
                            const el = document.getElementById(id);
                            if (el && typeof echarts !== 'undefined') {
                                const chart = echarts.getInstanceByDom(el);
                                if (chart && typeof chart.resize === 'function') {
                                    chart.resize();
                                }
                            }
                        });

                        if (targetId === 'tab-geo') {
                            const svg = document.querySelector('#venezuela-map-container svg');
                            if (svg) {
                                svg.style.transform = 'translateZ(0)';
                            }
                        }
                    });
                }

                tabButtons.forEach(btn => {
                    btn.addEventListener('click', function(e) {
                        e.preventDefault();
                        const targetId = this.getAttribute('data-target');
                        if (targetId) switchTab(targetId);
                    });
                });

                window.switchReportsTab = switchTab;

                // Soporte para deep-linking mediante hash en URL (ej. #tab-team, #tab-geo)
                if (typeof window !== 'undefined' && window.location && window.location.hash) {
                    const initialTab = window.location.hash.replace('#', '');
                    if (document.getElementById(initialTab)) {
                        switchTab(initialTab);
                    }
                }
            }

            function waitForECharts(retries) {
                if (typeof echarts !== 'undefined') {
                    initCharts();
                } else if (retries > 0) {
                    setTimeout(function() { waitForECharts(retries - 1); }, 100);
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function() {
                    setupTabNavigation();
                    waitForECharts(40);
                });
            } else {
                setupTabNavigation();
                waitForECharts(40);
            }
        })();
    </script>
</body>

</html>
