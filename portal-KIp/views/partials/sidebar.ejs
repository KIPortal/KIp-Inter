<%#
  Barra lateral del coordinador (IMPLEMENTACION.md §2.1, prototipo Main.dc.html).
  Uso: include('partials/sidebar', { currentUser, activo: 'dashboard', conteos: { tickets, enTurno, totalOperadores } })
  activo: dashboard | tickets | turno | reportes | auditoria | admin | contactos | panel (operador)
  Coordinador, jefe y gerente ven Coordinación; Auditoría y Administración, solo coordinador y gerente.
  conteos es opcional; si falta un dato, no se muestra.
  Operador: conteos.misTickets (activos) y conteos.area (nombre del área, va bajo su nombre).
%>
<%
	const usuario = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : {};
	const actual = (typeof activo !== 'undefined') ? activo : '';
	const c = (typeof conteos !== 'undefined' && conteos) ? conteos : {};
	const nombre = usuario.nombre || 'Usuario';
	const inicial = nombre.trim().charAt(0).toUpperCase() || '?';
	const esSupervisor = ['COORDINADOR', 'JEFE', 'GERENTE'].includes(usuario.rol);
	const administra = usuario.rol === 'COORDINADOR' || usuario.rol === 'GERENTE';
	const esOperador = usuario.rol === 'OPERADOR';
	const tieneTurno = Number.isFinite(c.enTurno) && Number.isFinite(c.totalOperadores);

	const iconos = {
		dashboard: '<rect x="3" y="3" width="7" height="9" rx="2"/><rect x="14" y="3" width="7" height="5" rx="2"/><rect x="14" y="12" width="7" height="9" rx="2"/><rect x="3" y="16" width="7" height="5" rx="2"/>',
		tickets: '<path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a3 3 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a3 3 0 0 0 0-6z"/>',
		turno: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 6"/>',
		reportes: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
		auditoria: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
		admin: '<path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1"/><circle cx="15" cy="6" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="18" r="2"/>',
		avisos: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
		contactos: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
		panel: '<rect x="3" y="3" width="7" height="9" rx="2"/><rect x="14" y="3" width="7" height="5" rx="2"/><rect x="14" y="12" width="7" height="9" rx="2"/><rect x="3" y="16" width="7" height="5" rx="2"/>',
		tema: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>',
		salir: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>'
	};
	const svg = (clave) => `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${iconos[clave]}</svg>`;

	const coordinacion = [
		{ clave: 'dashboard', texto: 'Dashboard General', href: '/' },
		{ clave: 'tickets', texto: 'Tickets', href: '/tickets#tickets', dato: Number.isFinite(c.tickets) ? String(c.tickets) : '' },
		{ clave: 'turno', texto: 'Gestión de Turno', href: '/gestion-turno', dato: tieneTurno ? `${c.enTurno}/${c.totalOperadores}` : '', datoClase: 'ok' }
	];
	// Coordinador que también atiende tickets: tiene su propio panel de trabajo
	if ((usuario.rol === 'COORDINADOR' || usuario.rol === 'JEFE') && usuario.atiende_tickets === true) {
		coordinacion.push({ clave: 'panel', texto: 'Mi panel', href: '/mi-panel', dato: Number.isFinite(c.misTickets) ? String(c.misTickets) : '' });
	}
	const operacion = [
		{ clave: 'panel', texto: 'Mi panel', href: '/', dato: Number.isFinite(c.misTickets) ? String(c.misTickets) : '' },
		{ clave: 'contactos', texto: 'Contactos', href: '/contactos' }
	];
	const control = [
		{ clave: 'reportes', texto: 'Reportes', href: '/reportes' },
		{ clave: 'contactos', texto: 'Contactos', href: '/contactos' }
	].concat(administra ? [
		{ clave: 'auditoria', texto: 'Auditoría', href: '/auditoria' },
		{ clave: 'admin', texto: 'Administración', href: '/admin' }
	] : []);
%>
<nav class="side" id="kip-sidebar" aria-label="Navegación principal" data-collapsed="false">
	<div class="sb-head">
		<a class="sb-brand" href="/" title="Operaciones IP">
			<span class="sb-logo">inter</span>
			<span class="sb-div" aria-hidden="true"></span>
			<span class="sb-name">Operaciones IP</span>
		</a>
		<button type="button" class="pill pillbtn sb-toggle" data-sidebar-toggle aria-controls="kip-sidebar" aria-expanded="true" title="Minimizar barra lateral" aria-label="Minimizar barra lateral">
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="15" rx="3"/><path d="M9 4.5v15"/></svg>
		</button>
	</div>
	<%# Aplica el estado guardado antes de pintar para que no parpadee. %>
	<script>
		(function () {
			try {
				if (localStorage.getItem('kip.sidebar') === 'collapsed') {
					document.getElementById('kip-sidebar').setAttribute('data-collapsed', 'true');
				}
			} catch (e) {}
		})();
	</script>

	<div class="sb-top">
		<div class="sb-user" title="<%= nombre %><%= usuario.email ? ' · ' + usuario.email : '' %>">
			<span class="sb-avatar" aria-hidden="true"><%= inicial %></span>
			<span class="sb-txt">
				<span class="sb-uname"><%= nombre %></span>
				<% if (esOperador && c.area) { %><span class="sb-mail"><%= c.area %></span><% } else if (usuario.email) { %><span class="sb-mail"><%= usuario.email %></span><% } %>
			</span>
		</div>
	</div>

	<% const principal = esOperador ? operacion : coordinacion; %>
	<span class="sb-sec"><%= esOperador ? 'Operación' : 'Coordinación' %></span>
	<% principal.forEach(item => { %>
		<a class="sideitem" href="<%= item.href %>" title="<%= item.texto %>"<% if (actual === item.clave) { %> aria-current="page"<% } %>>
			<%- svg(item.clave) %>
			<span class="sb-label"><%= item.texto %></span>
			<% if (item.dato) { %><span class="sb-count<%= item.datoClase ? ' ' + item.datoClase : '' %>"><%= item.dato %></span><% } %>
		</a>
	<% }) %>

	<% if (esSupervisor) { %>
		<%# Avisos: tickets resueltos que esperan revisión y cierre (public/js/avisos.js) %>
		<a class="sideitem" href="/tickets#por-cerrar" role="button" data-avisos-coord aria-haspopup="dialog" aria-expanded="false" title="Por cerrar: tickets resueltos que esperan tu revisión">
			<%- svg('avisos') %>
			<span class="sb-label">Por cerrar</span>
			<span class="sb-count sb-alert" data-avisos-n hidden></span>
		</a>
		<span class="sb-sec">Control</span>
		<% control.forEach(item => { %>
			<a class="sideitem" href="<%= item.href %>" title="<%= item.texto %>"<% if (actual === item.clave) { %> aria-current="page"<% } %>>
				<%- svg(item.clave) %>
				<span class="sb-label"><%= item.texto %></span>
			</a>
		<% }) %>
	<% } %>

	<div class="sb-foot">
		<a class="sideitem" href="#" role="button" data-theme-toggle title="Cambiar tema claro/oscuro">
			<%- svg('tema') %>
			<span class="sb-label">Tema</span>
		</a>
		<a class="sideitem" href="/auth/logout" title="Cerrar sesión">
			<%- svg('salir') %>
			<span class="sb-label">Cerrar sesión</span>
		</a>
	</div>
</nav>
