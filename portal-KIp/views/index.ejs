        <!-- BEGIN: Modal Traspasar a Guardia - R2 -->
        <div id="guardShiftOverlay"
            class="fixed inset-0 bg-black/40 backdrop-blur-md z-[85] hidden items-center justify-center p-4"
            onclick="handleGuardShiftBackdrop(event)">
            <section role="dialog" aria-modal="true" aria-labelledby="guardShiftTitle"
                class="w-[440px] max-w-[calc(100vw-2rem)] bg-white/95 backdrop-blur-2xl rounded-[20px] border border-white/60 shadow-[0_24px_60px_rgba(0,0,0,0.2)] p-6 text-[#1C1C1E] flex flex-col gap-4">
                <div class="flex items-start justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-9 h-9 rounded-full bg-blue-50 text-[#007AFF] flex items-center justify-center border border-blue-100 shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 id="guardShiftTitle" class="text-[16px] font-bold text-[#1C1C1E] leading-tight">Traspasar a Guardia</h3>
                            <p class="text-[12px] text-[#8E8E93] mt-0.5">Entrega operativa de tickets a la guardia entrante</p>
                        </div>
                    </div>
                    <button type="button" onclick="closeGuardShiftModal()" class="w-7 h-7 flex items-center justify-center rounded-[7px] text-[#8E8E93] hover:bg-[#F2F2F7] hover:text-[#1C1C1E] transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg>
                    </button>
                </div>
                <div class="space-y-1.5">
                    <label for="guardShiftOperatorId" class="text-[12px] font-medium text-[#3A3A3C] flex items-center justify-between">
                        <span>Operador de guardia entrante</span>
                        <span class="text-[10px] text-[#8E8E93] font-normal">Opcional</span>
                    </label>
                    <select id="guardShiftOperatorId" class="w-full text-[12px] p-2.5 rounded-[10px] border border-[#D1D1D6] bg-white focus:outline-none focus:ring-2 focus:ring-[#007AFF]/40 focus:border-[#007AFF] transition cursor-pointer">
                        <option value="">— Sin asignar a operador específico —</option>
                        <% if (typeof operadoresTurno !== 'undefined' && Array.isArray(operadoresTurno)) { %>
                            <% operadoresTurno.forEach(function(op) { if (!op) return; %>
                                <option value="<%= op.id %>"><%= op.nombre %> (<%= op.area_designada || 'General' %>)</option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="space-y-1.5">
                    <label for="guardShiftNote" class="text-[12px] font-medium text-[#3A3A3C] flex items-center justify-between">
                        <span>Nota de traspaso <span class="text-red-500 font-bold">*</span></span>
                        <span class="text-[10px] text-[#8E8E93] font-normal">Obligatoria</span>
                    </label>
                    <textarea id="guardShiftNote" rows="3" oninput="document.getElementById('guardShiftError')?.classList.add('hidden')" placeholder="Indica el estado crítico, pendientes inmediatos y acuerdos de la guardia..." class="w-full text-[12px] p-3 rounded-[10px] border border-[#D1D1D6] bg-white focus:outline-none focus:ring-2 focus:ring-[#007AFF]/40 focus:border-[#007AFF] transition resize-none"></textarea>
                    <p id="guardShiftError" class="text-[11px] text-red-500 hidden font-medium">Debes escribir una nota antes de confirmar el traspaso.</p>
                </div>
                <div class="flex items-center justify-end gap-2 pt-2 border-t border-black/5">
                    <button type="button" onclick="closeGuardShiftModal()" class="px-4 py-2 rounded-[8px] border border-[#D1D1D6] bg-white text-[#3A3A3C] hover:bg-[#F2F2F7] font-medium text-[12px] transition shadow-2xs cursor-pointer">
                        Cancelar
                    </button>
                    <!-- TODO backend: conectar endpoint -->
                    <button type="button" data-action="confirm-guard-shift" onclick="confirmGuardShift()" class="px-4 py-2 rounded-[8px] bg-[#007AFF] hover:bg-[#0062CC] text-white font-medium text-[12px] transition shadow-xs cursor-pointer flex items-center gap-1.5">
                        <span>Confirmar</span>
                    </button>
                </div>
            </section>
        </div>
