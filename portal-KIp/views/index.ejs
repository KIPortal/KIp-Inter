                        <h3 id="ticketDetailsTitle" class="text-[15px] font-bold text-[#1C1C1E] uppercase">Detalles del ticket</h3>
                        <p id="ticketDetailsCount" class="text-[12px] text-[#8E8E93] mt-1"></p>
                    </div>
                    <button type="button" onclick="closeTicketDetailsModal()" aria-label="Cerrar detalles"
                        class="w-8 h-8 flex items-center justify-center rounded-[8px] text-[#636366] hover:bg-[#F2F2F7]">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="m6 6 12 12M18 6 6 18"></path>
                        </svg>
                    </button>
                </header>
                <div id="ticketDetailsList" class="min-h-0 overflow-y-auto p-5 space-y-3"></div>
