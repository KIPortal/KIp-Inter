                style="width: 40px; height: 53px; display: flex; align-items: center; justify-content: center; padding: 0 4px; flex-shrink: 0;">
                <div
                    style="width: 32px; height: 32px; border-radius: 10px; background: #34C759; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 6px rgba(52,199,89,0.35);">
                    <svg style="width: 18px; height: 18px; color: #FFFFFF; stroke-width: 2.8; stroke: currentColor; fill: none; stroke-linecap: round; stroke-linejoin: round;"
                        viewBox="0 0 24 24">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
            </div>
            <div
                style="width: 232px; height: 53px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; z-index: 2;">
                <span id="notifTitleText"
                    style="font-weight: 700; font-size: 13px; line-height: 16px; letter-spacing: -0.02em; color: #1A1A1A;">Nueva
                    Asignación</span>
                <span id="notifDescriptionText"
                    style="font-weight: 400; font-size: 13px; line-height: 16px; letter-spacing: -0.008em; color: #1A1A1A; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 228px;">se
                    asignó correctamente</span>
            </div>
            <div
                style="width: 32px; height: 53px; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; gap: 7px; z-index: 3; flex-shrink: 0;">
                <span style="font-size: 11px; line-height: 14px; text-align: right; color: #8E8E93;">Ahora</span>
                <div id="notifAvatarBadge"
                    style="width: 28px; height: 28px; border-radius: 8px; background: #007AFF; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 600; box-shadow: 0 1px 3px rgba(0,122,255,0.3);">
                    CM</div>
            </div>
        </div>

    </div>
    <!-- END: macOS Window Frame -->

    <!-- Interactive Client Script -->
    <script>
        let currentTicketCode = '';
        let pendingTicketAction = null;
        let currentOperatorInitials = 'CM';
        let notifTimeout = null;

        const dashboardOverview = document.getElementById('dashboardOverview');
        const ticketsSection = document.getElementById('tickets');
        const shiftManagementSection = document.getElementById('shiftManagementSection');
        const dashboardNavLink = document.getElementById('dashboardNavLink');
        const ticketsNavLink = document.getElementById('ticketsNavLink');
        const shiftManagementNavLink = document.getElementById('shiftManagementNavLink');

        function showDashboardSection(section, updateHistory = true) {
            const isShift = section === 'shift' || section === 'gestion-turno';
            const isTickets = section === 'tickets';
            const isDashboard = !isShift && !isTickets;

            dashboardOverview?.classList.toggle('hidden', !isDashboard);
            ticketsSection?.classList.toggle('hidden', !isTickets);
            shiftManagementSection?.classList.toggle('hidden', !isShift);

            dashboardNavLink?.classList.toggle('bg-black/5', isDashboard);
            dashboardNavLink?.classList.toggle('text-[#007AFF]', isDashboard);
            dashboardNavLink?.classList.toggle('text-[#3A3A3C]', !isDashboard);
            dashboardNavLink?.setAttribute('aria-current', isDashboard ? 'page' : 'false');

            ticketsNavLink?.classList.toggle('bg-black/5', isTickets);
            ticketsNavLink?.classList.toggle('text-[#007AFF]', isTickets);
            ticketsNavLink?.classList.toggle('text-[#3A3A3C]', !isTickets);
            ticketsNavLink?.setAttribute('aria-current', isTickets ? 'page' : 'false');

            shiftManagementNavLink?.classList.toggle('bg-black/5', isShift);
            shiftManagementNavLink?.classList.toggle('text-[#007AFF]', isShift);
            shiftManagementNavLink?.classList.toggle('text-[#3A3A3C]', !isShift);
            shiftManagementNavLink?.setAttribute('aria-current', isShift ? 'page' : 'false');

            if (operatorsPopover?.contains(document.activeElement)) {
                (isShift ? shiftManagementNavLink : (isTickets ? ticketsNavLink : dashboardNavLink))?.focus();
            }
            setOperatorsPopoverOpen(false);

            if (isTickets && typeof applyTableFilters === 'function') {
                applyTableFilters();
            }

            if (isShift && typeof loadShiftSectionData === 'function') {
                loadShiftSectionData();
            }

            const targetHash = isShift ? '#gestion-turno' : (isTickets ? '#tickets' : (window.location.hash === '#general' ? '#general' : '#dashboard'));
            if (updateHistory && window.location.hash !== targetHash) {
                window.history.pushState({ section: isShift ? 'shift' : (isTickets ? 'tickets' : 'dashboard') }, '', targetHash);
            }
        }

        function getSectionFromHash() {
            const h = window.location.hash;
            if (h === '#gestion-turno') return 'shift';
            if (h === '#tickets') return 'tickets';
            if (h === '#general' || h === '#dashboard') return 'dashboard';
            return 'dashboard';
        }

        window.addEventListener('popstate', () => {
            showDashboardSection(getSectionFromHash(), false);
        });

        window.addEventListener('hashchange', () => {
            showDashboardSection(getSectionFromHash(), false);
        });

        if (window.location.hash) {
            showDashboardSection(getSectionFromHash(), false);
        }

        function setOperatorsPopoverOpen(isOpen, restoreFocus = false) {
            if (!operatorsPopover || !operatorsPopoverButton) return;
            operatorsPopover.classList.toggle('hidden', !isOpen);
            operatorsPopover.setAttribute('aria-hidden', String(!isOpen));
            operatorsPopoverButton.setAttribute('aria-expanded', String(isOpen));
            if (isOpen) operatorsPopoverClose?.focus();
            else if (restoreFocus) operatorsPopoverButton.focus();
        }

        operatorsPopoverButton?.addEventListener('click', () => {
            setOperatorsPopoverOpen(operatorsPopover?.classList.contains('hidden'));
        });
        operatorsPopoverClose?.addEventListener('click', () => setOperatorsPopoverOpen(false, true));

        document.addEventListener('click', event => {
            if (!operatorsPopover?.classList.contains('hidden') && !operatorsKpiCard?.contains(event.target)) {
                setOperatorsPopoverOpen(false);
            }
        });

        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && operatorsPopover && !operatorsPopover.classList.contains('hidden')) {
                setOperatorsPopoverOpen(false, true);
            }
        });

        function setNewTicketDropdownValue(dropdown, value) {
            const hiddenInput = dropdown.querySelector('input[type="hidden"]');
            const options = [...dropdown.querySelectorAll('[data-ticket-option]')];
            const selectedOption = options.find(option => option.dataset.value === value);
            if (!hiddenInput || !selectedOption) return false;

            hiddenInput.value = value;
            dropdown.querySelector('[data-ticket-dropdown-label]').textContent = selectedOption.dataset.label;
            options.forEach(option => option.setAttribute('aria-selected', String(option === selectedOption)));
            if (dropdown.id === 'newTicketOriginDropdown') syncNewTicketSenderField();
            dropdown.open = false;
            dropdown.querySelector('summary').focus();
            return true;
        }

        function syncNewTicketDropdowns() {
            document.querySelectorAll('[data-ticket-dropdown]').forEach(dropdown => {
                setNewTicketDropdownValue(dropdown, dropdown.dataset.defaultValue);
            });
            syncNewTicketSenderField();
        }

        function syncNewTicketSenderField() {
            const isEmailOrigin = document.getElementById('newTicketOrigin').value === 'CORREO';
            const senderField = document.getElementById('newTicketSenderField');
            const senderInput = document.getElementById('newTicketSender');
            senderField.classList.toggle('hidden', !isEmailOrigin);
            senderInput.required = isEmailOrigin;
            if (!isEmailOrigin) senderInput.value = '';
        }

        document.querySelectorAll('[data-ticket-dropdown]').forEach(dropdown => {
            dropdown.addEventListener('click', event => {
                const option = event.target.closest('[data-ticket-option]');
                if (option) setNewTicketDropdownValue(dropdown, option.dataset.value);
            });
            dropdown.addEventListener('toggle', () => {
                if (dropdown.open) {
                    document.querySelectorAll('[data-ticket-dropdown][open]').forEach(otherDropdown => {
                        if (otherDropdown !== dropdown) otherDropdown.open = false;
                    });
                }
            });
            dropdown.addEventListener('keydown', event => {
                if (event.key === 'Escape' && dropdown.open) {
                    dropdown.open = false;
                    dropdown.querySelector('summary').focus();
                }
            });
        });

        document.addEventListener('click', event => {
            if (event.target.closest('[data-ticket-dropdown]')) return;
            document.querySelectorAll('[data-ticket-dropdown][open]').forEach(dropdown => {
                dropdown.open = false;
            });
        });

        function openNewTicketModal() {
            const overlay = document.getElementById('newTicketOverlay');
            const form = document.getElementById('newTicketForm');
            const errorMessage = document.getElementById('newTicketError');
            form.reset();
            syncNewTicketDropdowns();
            errorMessage.textContent = '';
            errorMessage.classList.add('hidden');
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            document.getElementById('newTicketSubject').focus();
        }

        function closeNewTicketModal() {
            const overlay = document.getElementById('newTicketOverlay');
            overlay.classList.remove('flex');
            overlay.classList.add('hidden');
        }

        function handleNewTicketBackdrop(event) {
            if (event.target === document.getElementById('newTicketOverlay')) {
                closeNewTicketModal();
            }
        }

        async function createNewTicket(event) {
            event.preventDefault();
            const form = document.getElementById('newTicketForm');
            if (!form.reportValidity()) return;

            const submitButton = document.getElementById('newTicketSubmitButton');
            const errorMessage = document.getElementById('newTicketError');
            const originalLabel = submitButton.textContent;
            const attachmentInput = document.getElementById('newTicketAttachment');
            const payload = {
                asunto: document.getElementById('newTicketSubject').value.trim(),
                descripcion: document.getElementById('newTicketDescription').value.trim(),
                remitente: document.getElementById('newTicketSender').value.trim(),
                areaDesignada: document.getElementById('newTicketArea').value,
                origenIngesta: document.getElementById('newTicketOrigin').value,
                prioridad: document.getElementById('newTicketPriority').value,
                adjunto: attachmentInput && attachmentInput.files.length ? attachmentInput.files[0].name : ''
            };

            submitButton.disabled = true;
            submitButton.textContent = 'Creando...';
            errorMessage.textContent = '';
            errorMessage.classList.add('hidden');

            try {
                const response = await fetch('/api/tickets', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (!response.ok || !result.success) {
                    errorMessage.textContent = result.error || 'No se pudo crear el ticket.';
                    errorMessage.classList.remove('hidden');
                    return;
                }

                closeNewTicketModal();
                window.location.reload();
            } catch (error) {
                console.error('Error al crear ticket:', error);
                errorMessage.textContent = 'No se pudo conectar con el servidor.';
                errorMessage.classList.remove('hidden');
            } finally {
                submitButton.disabled = false;
                submitButton.textContent = originalLabel;
            }
        }

        document.getElementById('newTicketButton')?.addEventListener('click', openNewTicketModal);
        document.getElementById('newTicketForm')?.addEventListener('submit', createNewTicket);

        // Abrir Modal de Asignación con datos del ticket
        function openAssignModal(ticketCode, subject, area, operatorId, operatorName, priority) {
            currentTicketCode = ticketCode;
            const overlay = document.getElementById('assignModalOverlay');
            const card = document.getElementById('assignModalCard');
            const ticketInput = document.getElementById('modalTicketInput');
            const subjectInput = document.getElementById('modalSubjectInput');
            const areaText = document.getElementById('modalAreaText');
            const areaValue = document.getElementById('selectedAreaValue');
            const opText = document.getElementById('modalOperatorText');
            const opIdInput = document.getElementById('selectedOperatorId');
            const opEmailInput = document.getElementById('selectedOperatorEmail');
            const unassignBtn = document.getElementById('modalUnassignBtn');

            if (ticketInput) ticketInput.value = ticketCode || '#INC-00000';
            if (subjectInput) subjectInput.value = subject || '';

            // Área
            const areaLabels = {
                'REDES_FTTH': 'Redes FTTH',
                'GENERAL': 'Operaciones IP (General)',
                'WAN': 'WAN',
                'GRANDES_CLIENTES': 'Grandes Clientes',
                'TELEFONIA': 'Telefonía',
                'SEGURIDAD': 'Seguridad',
                'TRAFICO_INALAMBRICO': 'Tráfico'
            };
            const targetArea = area || 'REDES_FTTH';
            if (areaText) areaText.textContent = areaLabels[targetArea] || targetArea || 'Redes FTTH';
            if (areaValue) areaValue.value = targetArea;

            // Prioridad
            const p = (priority || 'P1').toUpperCase();
            const prioDot = document.getElementById('modalPriorityDot');
            const prioText = document.getElementById('modalPriorityText');
            const prioVal = document.getElementById('selectedPriorityValue');
            if (p === 'P2') {
                if (prioDot) prioDot.style.backgroundColor = '#FFBD2E';
                if (prioText) prioText.textContent = 'P2 - Media';
                if (prioVal) prioVal.value = 'P2';
            } else if (p === 'P3') {
                if (prioDot) prioDot.style.backgroundColor = '#8E8E93';
                if (prioText) prioText.textContent = 'P3 - Normal';
                if (prioVal) prioVal.value = 'P3';
            } else {
                // P1 por defecto (o si viene NONE / Sin Prioridad, sugerir P1 para asignación por el coordinador)
                if (prioDot) prioDot.style.backgroundColor = '#FF3B30';
                if (prioText) prioText.textContent = 'P1 - Crítico';
                if (prioVal) prioVal.value = 'P1';
            }

            // Operador
            if (opIdInput) opIdInput.value = operatorId || '';
            const selectedOperator = Array.from(document.querySelectorAll('#modalOperatorDropdown [data-operator-id]'))
                .find(option => option.dataset.operatorId === operatorId);
            if (opEmailInput) opEmailInput.value = selectedOperator?.dataset.operatorEmail || '';
            if (opText) {
                opText.textContent = operatorName || 'Seleccionar operador...';
                if (operatorName) {
                    let parts = operatorName.split(' ');
                    currentOperatorInitials = parts.length > 1 ? (parts[0][0] + parts[1][0]).toUpperCase() : operatorName.substring(0, 2).toUpperCase();
                } else {
                    currentOperatorInitials = 'OP';
                }
            }

            // Mostrar u ocultar la opción de desasignar
            if (unassignBtn) {
                if (operatorId) {
                    unassignBtn.classList.remove('hidden');
                } else {
                    unassignBtn.classList.add('hidden');
                }
            }

            // Mostrar Overlay con animación suave
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            requestAnimationFrame(() => {
                overlay.classList.remove('opacity-0', 'pointer-events-none');
                overlay.classList.add('opacity-100');
                card.classList.remove('scale-95', 'opacity-0');
                card.classList.add('scale-100', 'opacity-100');
            });
        }

        // Cerrar Modal
        function closeAssignModal() {
            const overlay = document.getElementById('assignModalOverlay');
            const card = document.getElementById('assignModalCard');

            card.classList.remove('scale-100', 'opacity-100');
            card.classList.add('scale-95', 'opacity-0');
            overlay.classList.remove('opacity-100');
            overlay.classList.add('opacity-0', 'pointer-events-none');

            setTimeout(() => {
                overlay.classList.remove('flex');
                overlay.classList.add('hidden');
            }, 200);
        }

        // Selección de Área en Dropdown
        function setModalArea(enumVal, label) {
            document.getElementById('modalAreaText').textContent = label;
            document.getElementById('selectedAreaValue').value = enumVal;
            const details = document.getElementById('modalAreaDropdown');
            if (details) details.removeAttribute('open');
        }

        // Selección de Prioridad en Dropdown
        function setModalPriority(prio, label, dotColor) {
            const prioText = document.getElementById('modalPriorityText');
            const prioVal = document.getElementById('selectedPriorityValue');
            const prioDot = document.getElementById('modalPriorityDot');
            if (prioText) prioText.textContent = label;
            if (prioVal) prioVal.value = prio;
            if (prioDot) prioDot.style.backgroundColor = dotColor;
            const details = document.getElementById('modalPriorityDropdown');
            if (details) details.removeAttribute('open');
        }

        // Selección de Operador en Dropdown
        function setModalOperator(operatorId, operatorName, initials, operatorEmail) {
            document.getElementById('modalOperatorText').textContent = operatorName;
            document.getElementById('selectedOperatorId').value = operatorId;
            document.getElementById('selectedOperatorEmail').value = operatorEmail || '';
            currentOperatorInitials = initials;
            const details = document.getElementById('modalOperatorDropdown');
            if (details) details.removeAttribute('open');
        }

        function openTicketDetailsForCode(ticketCode) {
            currentTicketCode = ticketCode;
            openTicketDetailsModal();
        }

        function openTicketDetailsModal() {
            const detailsList = document.getElementById('ticketDetailsList');
            const template = document.getElementById('ticketDetailsTemplate');
            const overlay = document.getElementById('ticketDetailsOverlay');
            const areaLabels = {
                GENERAL: 'Operaciones IP (General)',
                REDES_FTTH: 'Redes FTTH',
                TRAFICO_INALAMBRICO: 'Tráfico inalámbrico',
                WAN: 'WAN',
                GRANDES_CLIENTES: 'Grandes clientes',
                SEGURIDAD: 'Seguridad',
                TELEFONIA: 'Telefonía'
            };
            const codes = currentTicketCode.split(',').map(code => code.trim()).filter(Boolean);
            const rows = codes.map(code => document.getElementById(`row-${code}`)).filter(Boolean);

            detailsList.replaceChildren();
            rows.forEach(row => {
                const item = template.content.cloneNode(true);
                const area = row.dataset.area || 'GENERAL';
                const createdAt = row.dataset.createdAt ? new Date(row.dataset.createdAt) : null;
                const formattedDate = createdAt && !Number.isNaN(createdAt.getTime())
                    ? new Intl.DateTimeFormat('es-CL', { dateStyle: 'medium', timeStyle: 'short' }).format(createdAt)
                    : 'No registrada';

                item.querySelector('[data-detail-code]').textContent = row.id.replace(/^row-/, '');
                item.querySelector('[data-detail-subject]').textContent = row.dataset.detailSubject || 'Sin asunto';
                item.querySelector('[data-detail-area]').textContent = areaLabels[area] || area;
                item.querySelector('[data-detail-area-copy]').textContent = areaLabels[area] || area;
                item.querySelector('[data-detail-created-at]').textContent = formattedDate;
                item.querySelector('[data-detail-description]').textContent = row.dataset.description || 'Sin descripción registrada.';
                const historyListEl = item.querySelector('[data-detail-history-list]');
                const codeForHistory = row.id.replace(/^row-/, '');
                detailsList.appendChild(item);

                if (historyListEl && codeForHistory) {
                    fetch(`/api/tickets/${encodeURIComponent(codeForHistory)}/history`)
                        .then(r => r.json())
                        .then(data => {
                            const entries = Array.isArray(data) ? data : (data.history || data.historial || []);
                            if (!entries.length) {
                                historyListEl.innerHTML = '<p class="text-[#8E8E93] italic">Sin registros de auditoría para este ticket.</p>';
                                return;
                            }
                            historyListEl.innerHTML = entries.map(it => `
                                <div class="flex items-start gap-2 py-1 border-b border-black/5 last:border-0">
                                    <span class="w-1.5 h-1.5 rounded-full bg-sky-500 mt-1 shrink-0"></span>
                                    <div class="flex-1">
                                        <div class="flex items-center justify-between">
                                            <span class="font-semibold text-slate-700">${it.accion || it.action || 'Evento'}</span>
                                            <span class="text-[#8E8E93] text-[10px]">${it.createdAt ? new Date(it.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : 'Turno'}</span>
                                        </div>
                                        <p class="text-[#636366] text-[11px] mt-0.5">${it.detalles || it.nota || it.mensaje || ''}</p>
                                    </div>
                                </div>
                            `).join('');
                        })
                        .catch(() => {
                            historyListEl.innerHTML = '<p class="text-[#8E8E93] italic">Historial no disponible.</p>';
                        });
                }
            });

            const countLabel = rows.length === 1 ? '1 incidencia' : `${rows.length} incidencias`;
            document.getElementById('ticketDetailsCount').textContent = countLabel;
            if (rows.length === 0) {
                detailsList.textContent = 'No se encontraron detalles para la selección actual.';
            }

            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            overlay.querySelector('button')?.focus();
        }

        function closeTicketDetailsModal() {
            const overlay = document.getElementById('ticketDetailsOverlay');
            overlay.classList.remove('flex');
            overlay.classList.add('hidden');
        }

        function handleTicketDetailsBackdrop(event) {
            if (event.target === document.getElementById('ticketDetailsOverlay')) {
                closeTicketDetailsModal();
            }
        }

        function openAssignmentConfirmation() {
            const operatorId = document.getElementById('selectedOperatorId').value;
            const operatorName = document.getElementById('modalOperatorText').textContent.trim();
            const operatorEmail = document.getElementById('selectedOperatorEmail').value.trim();
            if (!operatorId) {
                alert('Por favor selecciona un operador para realizar la asignación.');
                return;
            }

            const ticketCodes = currentTicketCode.split(',').map(code => code.trim()).filter(Boolean);
            if (!ticketCodes.length) {
                alert('No hay tickets válidos para asignar.');
                return;
            }

            const operatorContact = operatorEmail ? ` (${operatorEmail})` : '';
            const message = ticketCodes.length === 1
                ? `¿Confirmas asignar el ticket ${ticketCodes[0]} a ${operatorName}${operatorContact}?`
                : `¿Confirmas asignar ${ticketCodes.length} tickets a ${operatorName}${operatorContact}?`;
            openTicketActionConfirmation('assign', 'Confirmar asignación', message, 'Asignar');
        }

        function openUnassignmentConfirmation(ticketCode = currentTicketCode) {
            currentTicketCode = ticketCode || currentTicketCode;
            const row = document.getElementById(`row-${currentTicketCode}`);
            const operatorName = row?.dataset.operatorName || document.getElementById('modalOperatorText').textContent.trim();
            const message = `El ticket ${currentTicketCode} se desasignará de ${operatorName || 'su operador actual'} y volverá a la cola general. El ticket no se eliminará.`;
            openTicketActionConfirmation('unassign', 'Confirmar desasignación', message, 'Desasignar');
        }

        function openTicketActionConfirmation(action, title, message, confirmLabel) {
            pendingTicketAction = action;
            document.getElementById('ticketActionConfirmTitle').textContent = title;
            document.getElementById('ticketActionConfirmMessage').textContent = message;
            document.getElementById('ticketActionConfirmButton').textContent = confirmLabel;
            const overlay = document.getElementById('ticketActionConfirmOverlay');
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            overlay.querySelector('button')?.focus();
        }

        function closeTicketActionConfirmation() {
            pendingTicketAction = null;
            const overlay = document.getElementById('ticketActionConfirmOverlay');
            overlay.classList.remove('flex');
            overlay.classList.add('hidden');
        }

        function handleTicketActionConfirmationBackdrop(event) {
            if (event.target === document.getElementById('ticketActionConfirmOverlay')) {
                closeTicketActionConfirmation();
            }
        }

        async function confirmTicketAction() {
            const action = pendingTicketAction;
            closeTicketActionConfirmation();
            if (action === 'assign') await saveAssignModal();
            if (action === 'unassign') await unassignCurrentTicket();
        }

        // Guardar Asignación en la Base de Datos
        async function saveAssignModal() {
            const saveButton = document.getElementById('saveAssignButton');
            const operatorId = document.getElementById('selectedOperatorId').value;
            const operatorName = document.getElementById('modalOperatorText').textContent;
            const areaDesignada = document.getElementById('selectedAreaValue').value;
            const prioridad = document.getElementById('selectedPriorityValue')?.value || 'P1';
            const isBatch = currentTicketCode.includes(',');
            const ticketCodes = isBatch
                ? [...new Set(currentTicketCode.split(',').map(code => code.trim()).filter(Boolean))]
                : [currentTicketCode.trim()];

            if (!operatorId) {
                alert('Por favor selecciona un operador para realizar la asignación.');
                return;
            }
            if (!ticketCodes.length || ticketCodes.some(code => !code)) {
                alert('No hay tickets válidos para asignar.');
                return;
            }
            if (saveButton?.disabled) return;

            const originalLabel = saveButton?.textContent;
            if (saveButton) {
                saveButton.disabled = true;
                saveButton.textContent = 'Guardando...';
            }
            try {
                // Si es asignación por lote múltiple
                if (isBatch) {
                    const response = await fetch('/api/tickets/batch-assign', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            ticketCodes,
                            operatorId,
                            areaDesignada,
                            prioridad
                        })
                    });

                    const result = await response.json();
                    if (response.ok && result.success && result.count === ticketCodes.length) {
                        closeAssignModal();
                        ticketCodes.forEach(code => {
                            updateRowDisplay(code, operatorName, true, operatorId, areaDesignada, prioridad, result.fechaAsignacion);
                        });
                        showNotification('Asignación Masiva', `Se asignaron ${ticketCodes.length} tickets a ${operatorName}`, currentOperatorInitials);
                        TableSelectionManager.clear();
                        updateKPIStats();
                    } else {
                        alert('Error: ' + (result.error || 'El servidor no confirmó la asignación de todos los tickets.'));
                    }
                    return;
                }

                // Asignación individual
                const response = await fetch('/api/tickets/assign', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        ticketCodes,
                        ticketCode: ticketCodes[0],
                        operatorId,
                        areaDesignada,
                        prioridad
                    })
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    closeAssignModal();

                    // Actualizar fila en la tabla visualmente
                    updateRowDisplay(currentTicketCode, operatorName, true, operatorId, areaDesignada, prioridad, result.ticket.fecha_asignacion);

                    // Disparar Notificación Liquid-Glass
                    showNotification('Nueva Asignación', `se asignó correctamente a ${operatorName}`, currentOperatorInitials);
                    updateKPIStats();
                } else {
                    alert('Error: ' + result.error);
                }
            } catch (err) {
                console.error(err);
                alert('Error al comunicarse con el servidor.');
            } finally {
                if (saveButton) {
                    saveButton.disabled = false;
                    saveButton.textContent = originalLabel;
                }
            }
        }

        function handleTicketAction(ticketCode, subject, area, operatorId, operatorName, priority) {
            const row = document.getElementById(`row-${ticketCode}`);
            if (row?.dataset.assigned === 'true') {
                return unassignTicketByCode(ticketCode);
            }
            return openAssignModal(ticketCode, subject, area, operatorId, operatorName, priority);
        }

        function unassignTicketByCode(ticketCode) {
            currentTicketCode = ticketCode;
            return openUnassignmentConfirmation(ticketCode);
        }

        // Desasignar Ticket
        async function unassignCurrentTicket() {
            try {
                const response = await fetch('/api/tickets/unassign', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketCode: currentTicketCode })
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    closeAssignModal();
                    updateRowDisplay(currentTicketCode, null, false, '', 'GENERAL', 'NONE');
                    showNotification('Ticket Desasignado', `${currentTicketCode} devuelto a cola general sin prioridad`, 'NOC');
                    updateKPIStats();
                } else {
                    alert('No se pudo desasignar el ticket: ' + (result.error || 'Inténtalo de nuevo.'));
                }
            } catch (err) {
                console.error(err);
                alert('Error al comunicarse con el servidor al desasignar el ticket.');
            }
        }

        function updateTicketElapsedMinutes(row, now = Date.now()) {
            const elapsedLabel = row.querySelector('[data-ticket-elapsed]');
            const createdAt = Date.parse(row.dataset.createdAt || '');
            const attendedAt = row.dataset.attendedAt ? Date.parse(row.dataset.attendedAt) : now;
            if (!elapsedLabel || !Number.isFinite(createdAt) || !Number.isFinite(attendedAt)) return;

            const elapsedMinutes = Math.max(0, Math.floor((attendedAt - createdAt) / 60000));
            if (elapsedMinutes >= 1440) {
                const elapsedDays = Math.floor(elapsedMinutes / 1440);
                elapsedLabel.textContent = `${elapsedDays} ${elapsedDays === 1 ? 'día' : 'días'}`;
            } else if (elapsedMinutes >= 120) {
                elapsedLabel.textContent = `${Math.floor(elapsedMinutes / 60)} h`;
            } else {
                elapsedLabel.textContent = `${elapsedMinutes} min`;
            }
        }

        function refreshTicketElapsedMinutes() {
            document.querySelectorAll('.ticket-row').forEach(row => updateTicketElapsedMinutes(row));
        }

        refreshTicketElapsedMinutes();
        window.setInterval(refreshTicketElapsedMinutes, 60000);

        // Actualizar visualmente la fila de la tabla
        function updateRowDisplay(ticketCode, operatorName, isAssigned, operatorId, area, prioridad, attendedAt = null) {
            const row = document.getElementById(`row-${ticketCode}`);
            if (!row) return;

            // Actualizar estado de asignación en la fila y checkbox
            row.setAttribute('data-assigned', isAssigned ? 'true' : 'false');
            row.dataset.attendedAt = isAssigned ? (attendedAt || new Date().toISOString()) : '';
            updateTicketElapsedMinutes(row);
            const cb = row.querySelector('.row-checkbox');
            if (cb) {
                if (isAssigned) {
                    cb.checked = false;
                    cb.disabled = true;
                    cb.setAttribute('disabled', 'true');
                    cb.setAttribute('data-assigned', 'true');
                    cb.title = 'Ticket ya en asignación';
                    cb.classList.add('opacity-30', 'cursor-not-allowed', 'pointer-events-none', 'bg-[#E5E5EA]');
                    cb.classList.remove('cursor-pointer');
                    row.classList.remove('bg-[#007AFF]/[0.08]', 'font-medium');
                    if (typeof TableSelectionManager !== 'undefined') {
                        TableSelectionManager.selectedCodes.delete(ticketCode);
                        TableSelectionManager.sync();
                    }
                } else {
                    cb.disabled = false;
                    cb.removeAttribute('disabled');
                    cb.setAttribute('data-assigned', 'false');
                    cb.removeAttribute('title');
                    cb.classList.remove('opacity-30', 'cursor-not-allowed', 'pointer-events-none', 'bg-[#E5E5EA]');
                    cb.classList.add('cursor-pointer');
                }
            }

            const opCol = row.querySelector('.op-col .operator-label');
            const stateCol = row.querySelector('.state-col .status-text');
            const actionBtn = row.querySelector('.action-col button');
            const ticketLink = row.querySelector('a');

            if (opCol) {
                if (isAssigned) {
                    opCol.textContent = operatorName;
                    opCol.classList.remove('italic', 'text-[#8E8E93]');
                    opCol.classList.add('font-semibold', 'text-[#007AFF]');
                } else {
                    opCol.textContent = '— Sin asignar';
                    opCol.classList.add('italic', 'text-[#8E8E93]');
                    opCol.classList.remove('font-semibold', 'text-[#007AFF]');
                }
            }

            if (stateCol) {
                stateCol.textContent = isAssigned ? 'En Progreso' : 'Nuevo';
            }

            if (prioridad) {
                row.setAttribute('data-priority', prioridad);
                const prioBadge = row.querySelector('td:nth-child(3) span');
                if (prioBadge) {
                    if (prioridad === 'P1') {
                        prioBadge.style.backgroundColor = '#FFE5E5';
                        prioBadge.style.color = '#D70015';
                        prioBadge.style.borderColor = '#FFD0D0';
                        prioBadge.title = 'Prioridad P1 - Crítica';
                        prioBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full" style="background-color: #FF3B30;"></span> P1';
                    } else if (prioridad === 'P2') {
                        prioBadge.style.backgroundColor = '#FFF4D6';
                        prioBadge.style.color = '#B25E02';
                        prioBadge.style.borderColor = '#FFE6A6';
                        prioBadge.title = 'Prioridad P2 - Media';
                        prioBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full" style="background-color: #FFBD2E;"></span> P2';
                    } else if (prioridad === 'P3') {
                        prioBadge.style.backgroundColor = '#F2F2F7';
                        prioBadge.style.color = '#1C1C1E';
                        prioBadge.style.borderColor = '#D1D1D6';
                        prioBadge.title = 'Prioridad P3 - Normal';
                        prioBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full" style="background-color: #8E8E93;"></span> P3';
                    } else {
                        prioBadge.style.backgroundColor = '#F2F2F7';
                        prioBadge.style.color = '#8E8E93';
                        prioBadge.style.borderColor = '#E5E5EA';
                        prioBadge.title = 'Sin Prioridad (S/P)';
                        prioBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full" style="background-color: #C7C7CC;"></span> S/P';
                    }
                }
            }

            if (area) {
                row.setAttribute('data-area', area);
            }
            row.setAttribute('data-operator-id', operatorId || '');
            row.setAttribute('data-operator-name', operatorName || '');

            const currentPrio = (prioridad && prioridad !== 'NONE') ? prioridad : 'P1';
            const cleanSubj = (row.querySelector('.truncate')?.getAttribute('title') || row.querySelector('.truncate')?.textContent || '').replace(/'/g, "\\'");

            if (actionBtn) {
                actionBtn.textContent = isAssigned ? 'Desasignar' : 'Asignar';
                actionBtn.setAttribute('onclick', `handleTicketAction('${ticketCode}', '${cleanSubj}', '${area || 'GENERAL'}', '${operatorId || ''}', '${operatorName || ''}', '${currentPrio}')`);
            }

            if (ticketLink) {
                ticketLink.setAttribute('onclick', `openAssignModal('${ticketCode}', '${cleanSubj}', '${area || 'GENERAL'}', '${operatorId || ''}', '${operatorName || ''}', '${currentPrio}')`);
            }

            if (typeof TableSelectionManager !== 'undefined') {
                TableSelectionManager.sync();
            }
        }

        // Mostrar Notificación Liquid-Glass
