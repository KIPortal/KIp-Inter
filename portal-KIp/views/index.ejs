                    <div class="rounded-[8px] bg-white border border-[#E5E5EA] px-3 py-2">
                        <div class="text-[10px] font-semibold uppercase text-[#8E8E93]">Área dirigida</div>
                        <div data-detail-area-copy class="mt-1 text-[12px] text-[#1C1C1E]"></div>
                    </div>
