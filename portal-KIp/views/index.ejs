            style="width: 344px; height: 77px; display: flex; flex-direction: row; align-items: flex-start; padding: 12px 14px 12px 10px; gap: 8px; isolation: isolate; position: absolute; top: 20px; right: 20px; z-index: 9999; border-radius: 20px; background: linear-gradient(0deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.5)), rgba(240, 240, 245, 0.7); box-shadow: rgb(219, 219, 219) 1.25px 0px 0px -0.75px, rgb(219, 219, 219) -1.25px 0px 0px -0.75px, rgb(219, 219, 219) 0px 0px 0px 0.5px, rgba(0, 0, 0, 0.18) 0px 8px 48px, rgba(40, 40, 40, 0.08) 0px 40px 5px -40px inset, rgba(40, 40, 40, 0.08) 0px -40px 5px -40px inset; backdrop-filter: blur(28px); transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s;"
            class="select-none cursor-pointer opacity-0 pointer-events-none translate-y-[-10px]"
