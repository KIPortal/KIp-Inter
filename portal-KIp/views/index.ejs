                            <details id="modalPriorityDropdown" class="relative group select-none z-30">
                                <summary
                                    class="list-none flex items-center justify-between w-full h-[36px] pl-3.5 pr-2 bg-white hover:bg-[#FAFAFC] active:bg-[#F2F2F7] rounded-[10px] border border-[#D1D1D6] shadow-xs cursor-pointer text-[13px] font-medium text-[#1C1C1E] transition focus:outline-none">
                                    <div class="flex items-center gap-2">
                                        <span id="modalPriorityDot" class="w-2 h-2 rounded-full bg-[#FF3B30]"></span>
                                        <span id="modalPriorityText" class="text-[13px] font-medium text-[#1C1C1E]">P1 - Crítico</span>
                                    </div>
                                    <span
                                        class="flex items-center justify-center w-[20px] h-[20px] rounded-[6px] bg-[#F2F2F7] text-[#8E8E93]">
                                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                            <path d="M6 9l6 6 6-6"></path>
                                        </svg>
                                    </span>
                                </summary>
                                <div
                                    class="absolute left-0 top-[40px] w-full bg-white rounded-[12px] border border-[#D1D1D6] shadow-[0_10px_25px_rgba(0,0,0,0.12)] p-1 z-50 space-y-0.5 text-[12px]">
                                    <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                        onclick="event.preventDefault();setModalPriority('P1', 'P1 - Crítico', '#FF3B30');">
                                        <div class="flex items-center gap-2">
                                            <span class="w-2 h-2 rounded-full bg-[#FF3B30]"></span>
                                            <span>P1 - Crítico</span>
                                        </div>
                                    </a>
                                    <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                        onclick="event.preventDefault();setModalPriority('P2', 'P2 - Media', '#FFBD2E');">
                                        <div class="flex items-center gap-2">
                                            <span class="w-2 h-2 rounded-full bg-[#FFBD2E]"></span>
                                            <span>P2 - Media</span>
                                        </div>
                                    </a>
                                    <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                        onclick="event.preventDefault();setModalPriority('P3', 'P3 - Normal', '#8E8E93');">
                                        <div class="flex items-center gap-2">
                                            <span class="w-2 h-2 rounded-full bg-[#8E8E93]"></span>
                                            <span>P3 - Normal</span>
                                        </div>
                                    </a>
                                </div>
                            </details>
                        </div>
                    </div>

                    <!-- Operador Dropdown -->
                    <div class="flex items-center relative z-20">
                        <label class="w-[82px] text-right text-[13px] font-medium text-[#636366] pr-3 select-none">Operador:</label>
                        <div class="flex-1 relative">
                            <input type="hidden" id="selectedOperatorId" value="">
                            <input type="hidden" id="selectedOperatorEmail" value="">
                            <details id="modalOperatorDropdown" class="relative group select-none z-20">
                                <summary
                                    class="list-none flex items-center justify-between w-full h-[36px] pl-3.5 pr-2 bg-white hover:bg-[#FAFAFC] active:bg-[#F2F2F7] rounded-[10px] border border-[#D1D1D6] shadow-xs cursor-pointer text-[13px] font-medium text-[#1C1C1E] transition focus:outline-none">
                                    <span class="truncate text-[13px] leading-none font-medium text-[#1C1C1E]"
                                        id="modalOperatorText">Seleccionar operador...</span>
                                    <span
                                        class="flex items-center justify-center w-[20px] h-[20px] rounded-[6px] bg-[#F2F2F7] text-[#8E8E93]">
                                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                            <path d="M6 9l6 6 6-6"></path>
                                        </svg>
                                    </span>
                                </summary>
                                <div
                                    class="absolute left-0 top-[40px] w-full bg-white rounded-[12px] border border-[#D1D1D6] shadow-[0_10px_25px_rgba(0,0,0,0.12)] p-1 z-40 space-y-0.5 text-[12px] max-h-[170px] overflow-y-auto">
                                    <% if (typeof operadores !== 'undefined' && Array.isArray(operadores) && operadores.length > 0) { %>
                                        <% operadores.forEach(function(op) { 
                                            if (!op) return;
                                            let opName = (op.nombre && typeof op.nombre === 'string') ? op.nombre.trim() : 'Operador';
                                            let parts = opName.split(/\s+/);
                                            let inits = parts.length > 1 ? (parts[0][0] + parts[1][0]).toUpperCase() : opName.slice(0, 2).toUpperCase();
                                        %>
                                            <a data-operator-id="<%= op.id %>" data-operator-email="<%= op.email %>" class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer" onclick="event.preventDefault();setModalOperator('<%= op.id %>', '<%= op.nombre %>', '<%= inits %>', this.dataset.operatorEmail);">
                                                <span class="truncate"><%= op.nombre %></span>
                                                <span class="font-mono text-[10px] text-[#8E8E93] group-hover:text-white"><%= inits %></span>
                                            </a>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="px-2.5 py-1.5 text-[11px] text-[#8E8E93] italic">No hay operadores registrados</div>
                                    <% } %>
                                </div>
                            </details>
                        </div>
                    </div>
                </div>

                <!-- Bottom Actions Toolbar -->
                <div class="flex items-center justify-between pt-3 mt-1">
                    <button id="modalUnassignBtn"
