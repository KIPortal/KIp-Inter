            onclick="handleBackdropClick(event)">
            <!-- Modal Window Card View (410px width, rounded-[22px], white background) -->
            <div id="assignModalCard"
                class="w-[410px] bg-white rounded-[22px] border border-[#E5E5EA] shadow-[0_24px_60px_rgba(0,0,0,0.18)] p-7 flex flex-col gap-5 transform transition-all duration-200 select-none scale-95 opacity-0">
                <!-- Title and Subtitle -->
                <div class="text-center pt-0.5">
                    <h3 class="text-[15px] font-bold text-[#1C1C1E] tracking-normal uppercase leading-tight font-sans">
                        CONFIGURACION DE ASIGNACION
                    </h3>
                    <p class="text-[12px] text-[#8E8E93] leading-snug mt-1.5 px-3 font-normal">
                        describe las indicaciones
                    </p>
                </div>

                <!-- Form Fields Container -->
                <div class="space-y-3 pt-1">
                    <!-- Ticket Code -->
                    <div class="flex items-center">
                        <label class="w-[82px] text-right text-[13px] font-medium text-[#636366] pr-3 select-none">Ticket:</label>
                        <div class="flex-1">
                            <input id="modalTicketInput"
                                class="w-full h-[36px] px-3.5 bg-[#EDEDF0] rounded-[10px] text-[13px] font-mono font-medium text-[#1C1C1E] border border-black/5 focus:outline-none select-none transition cursor-default"
                                readonly tabindex="-1" type="text" value="#INC-00000">
                        </div>
                    </div>

                    <!-- Asunto -->
