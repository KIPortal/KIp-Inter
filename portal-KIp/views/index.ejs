                            <input type="hidden" id="selectedAreaValue" value="REDES_FTTH">
                            <details id="modalAreaDropdown" class="relative group select-none z-40">
                                <summary
                                    class="list-none flex items-center justify-between w-full h-[36px] pl-3.5 pr-2 bg-white hover:bg-[#FAFAFC] active:bg-[#F2F2F7] rounded-[10px] border border-[#D1D1D6] shadow-xs cursor-pointer text-[13px] font-medium text-[#1C1C1E] transition focus:outline-none">
                                    <span class="truncate text-[13px] leading-none font-medium text-[#1C1C1E]"
                                        id="modalAreaText">Redes FTTH</span>
                                    <span
                                        class="flex items-center justify-center w-[20px] h-[20px] rounded-[6px] bg-[#F2F2F7] text-[#8E8E93]">
                                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                            <path d="M6 9l6 6 6-6"></path>
                                        </svg>
                                    </span>
                                </summary>
                                <div
                                    class="absolute left-0 top-[40px] w-full bg-white rounded-[12px] border border-[#D1D1D6] shadow-[0_10px_25px_rgba(0,0,0,0.12)] p-1 z-50 space-y-0.5 text-[12px]">
                                    <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                        onclick="event.preventDefault();setModalArea('REDES_FTTH', 'Redes FTTH');">
                                        <span class="truncate">Redes FTTH</span>
                                    </a>
                                    <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                        onclick="event.preventDefault();setModalArea('GENERAL', 'Operaciones IP (General)');">
                                        <span class="truncate">Operaciones IP (General)</span>
                                    </a>
                                    <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                        onclick="event.preventDefault();setModalArea('WAN', 'WAN');">
                                        <span class="truncate">WAN</span>
                                    </a>
                                    <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                        onclick="event.preventDefault();setModalArea('GRANDES_CLIENTES', 'Grandes Clientes');">
                                        <span class="truncate">Grandes Clientes</span>
                                    </a>
                                    <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                        onclick="event.preventDefault();setModalArea('TELEFONIA', 'Telefonía');">
                                        <span class="truncate">Telefonía</span>
                                    </a>
                                    <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                        onclick="event.preventDefault();setModalArea('SEGURIDAD', 'Seguridad');">
                                        <span class="truncate">Seguridad</span>
                                    </a>
                                    <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                        onclick="event.preventDefault();setModalArea('TRAFICO_INALAMBRICO', 'Tráfico');">
                                        <span class="truncate">Tráfico</span>
                                    </a>
                                </div>
                            </details>
                        </div>
                    </div>

                    <!-- Prioridad Dropdown -->
                    <div class="flex items-center relative z-30">
                        <label class="w-[82px] text-right text-[13px] font-medium text-[#636366] pr-3 select-none">Prioridad:</label>
