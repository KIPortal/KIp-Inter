        <template id="ticketDetailsTemplate">
            <article class="rounded-[12px] border border-[#E5E5EA] bg-[#FAFAFC] p-4 space-y-4">
                <div>
                    <div class="flex items-center justify-between gap-3">
                        <span data-detail-code class="font-mono text-[12px] font-semibold text-[#007AFF]"></span>
                        <span data-detail-area class="text-[11px] font-medium text-[#48484A] bg-white border border-[#E5E5EA] rounded-[6px] px-2 py-1"></span>
                    </div>
                    <h4 data-detail-subject class="mt-2 text-[14px] font-semibold text-[#1C1C1E] break-words"></h4>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="rounded-[8px] bg-white border border-[#E5E5EA] px-3 py-2">
                        <div class="text-[10px] font-semibold uppercase text-[#8E8E93]">Fecha de creación</div>
                        <div data-detail-created-at class="mt-1 text-[12px] text-[#1C1C1E] tabular-nums"></div>
