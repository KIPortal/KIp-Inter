                    <div class="flex items-center gap-2.5">
                        <button
                            class="h-[34px] px-4 bg-[#E5E5EA] hover:bg-[#DCDCE0] active:bg-[#D1D1D6] text-[#3A3A3C] text-[13px] font-medium rounded-[10px] flex items-center justify-center transition cursor-pointer select-none"
                            onclick="closeAssignModal()" type="button">
                            Cancelar
                        </button>
                        <button id="saveAssignButton"
                            class="h-[34px] px-5 bg-[#007AFF] hover:bg-[#006DE6] active:bg-[#0062CC] text-white text-[13px] font-medium rounded-[10px] flex items-center justify-center shadow-xs transition cursor-pointer select-none"
                            onclick="openAssignmentConfirmation()" type="button">
                            Asignar
                        </button>
                    </div>
                </div>
            </div>
        </div>
