        async function handlePrioritySelectChange(selectElem) {
            const val = selectElem.value;
            const code = selectElem.getAttribute('data-ticket-code') || selectElem.closest('tr')?.getAttribute('data-ticket-code') || '';
            const row = selectElem.closest('tr');
            if (row) {
                row.setAttribute('data-priority', val);
            }
            selectElem.classList.remove(
                'bg-red-50', 'text-red-700', 'border-red-200',
                'bg-amber-50', 'text-amber-700', 'border-amber-200',
                'bg-emerald-50', 'text-emerald-700', 'border-emerald-200'
            );
            if (val === 'P1') {
                selectElem.classList.add('bg-red-50', 'text-red-700', 'border-red-200');
            } else if (val === 'P2') {
                selectElem.classList.add('bg-amber-50', 'text-amber-700', 'border-amber-200');
            } else {
                selectElem.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-200');
            }
            updateKPIStats();
            applyTableFilters();

            if (code) {
                try {
                    const res = await fetch(`/api/tickets/${encodeURIComponent(code)}`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ prioridad: val })
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        console.warn('Error al actualizar prioridad:', data.error || res.statusText);
                    } else if (typeof showNotification === 'function') {
                        showNotification('Prioridad actualizada', `Ticket ${code} actualizado a ${val}`);
                    }
                } catch (err) {
                    console.error('Error de red al actualizar prioridad:', err);
                }
            }
        }

        async function closeTicketDirectly(btn, code, confirmar = false) {
            if (!confirmar && !confirm(`¿Estás seguro de cerrar la incidencia ${code}?`)) return;
            try {
                const payload = confirmar ? { confirmar: true } : {};
                let res = await fetch(`/api/tickets/${encodeURIComponent(code)}/close`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (res.status === 404 || res.status === 405) {
                    res = await fetch(`/api/tickets/${encodeURIComponent(code)}`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ estado: 'CERRADO', ...payload })
                    });
                }
                const data = await res.json().catch(() => ({}));
                if (data.requiereConfirmacion && !confirmar) {
                    if (confirm(data.mensaje || `El ticket ${code} requiere confirmación adicional. ¿Confirmar cierre?`)) {
                        return closeTicketDirectly(btn, code, true);
                    }
                    return;
                }
                if (!res.ok && res.status !== 404 && res.status !== 501) {
                    alert(data.error || 'No se pudo cerrar el ticket en el servidor');
                    return;
                }
            } catch (err) {
                console.warn('Endpoint closeTicket:', err);
            }

            const row = document.getElementById('row-' + code) || btn?.closest('tr');
            if (row) {
                row.classList.add('opacity-70', 'grayscale-[20%]');
                row.setAttribute('data-state', 'CERRADO');
                const stateCol = row.querySelector('.state-col');
                if (stateCol) {
                    stateCol.innerHTML = `
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[4px] text-[11px] font-medium" style="background-color: rgba(34, 197, 94, 0.1); color: rgb(20, 83, 45); border: 1px solid rgba(34, 197, 94, 0.2);">
                            <span class="w-1.5 h-1.5 rounded-full" style="background-color: #22c55e;"></span>
                            <span class="status-text">Cerrado</span>
                        </span>
                    `;
                }
                const actionCol = row.querySelector('.action-col');
                if (actionCol) {
                    actionCol.innerHTML = `
                        <button type="button" onclick="openTicketDetailsForCode('${code}')" class="bg-white hover:bg-[#F2F2F7] active:bg-[#E5E5EA] border border-[#D1D1D6] text-[#8E8E93] text-[11px] font-medium px-2 py-0.5 rounded-[6px] shadow-xs transition cursor-pointer">
                            Detalles
                        </button>
                    `;
                }
                const chk = row.querySelector('.row-checkbox');
                if (chk) {
                    chk.checked = false;
                    chk.disabled = true;
                    chk.classList.add('opacity-30', 'cursor-not-allowed', 'pointer-events-none');
                }
                if (typeof TableSelectionManager !== 'undefined') {
                    TableSelectionManager.selectedCodes.delete(code);
                    TableSelectionManager.updateRowStyle(chk || row);
                    TableSelectionManager.sync();
                }
                if (typeof showNotification === 'function') {
                    showNotification('Ticket cerrado', `La incidencia ${code} fue cerrada correctamente.`);
                }
                updateKPIStats();
                applyTableFilters();
            }
        }

        // ==========================================
        // Modal Traspasar a Guardia - R2
        // ==========================================
        function openGuardShiftModal() {
            const overlay = document.getElementById('guardShiftOverlay');
            const note = document.getElementById('guardShiftNote');
            const err = document.getElementById('guardShiftError');
            if (note) note.value = '';
            if (err) err.classList.add('hidden');
            if (overlay) {
                overlay.classList.remove('hidden');
                overlay.classList.add('flex');
                setTimeout(() => note && note.focus(), 50);
            }
        }

        function closeGuardShiftModal() {
            const overlay = document.getElementById('guardShiftOverlay');
            if (overlay) {
                overlay.classList.add('hidden');
                overlay.classList.remove('flex');
            }
        }

        function handleGuardShiftBackdrop(event) {
            if (event.target === document.getElementById('guardShiftOverlay')) {
                closeGuardShiftModal();
            }
        }

        async function confirmGuardShift() {
            const note = document.getElementById('guardShiftNote');
            const err = document.getElementById('guardShiftError');
            const opSelect = document.getElementById('guardShiftOperatorId');
            const operatorId = opSelect ? opSelect.value : '';
            const noteVal = note ? note.value.trim() : '';
            if (!noteVal) {
                if (err) err.classList.remove('hidden');
                if (note) note.focus();
                return;
            }
            if (err) err.classList.add('hidden');
            const ticketCodes = Array.from((typeof TableSelectionManager !== 'undefined') ? TableSelectionManager.selectedCodes : []);
            
            try {
                const res = await fetch('/api/tickets/handoff', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketCodes, operatorId, nota: noteVal })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok && res.status !== 404 && res.status !== 501) {
                    console.warn('Respuesta handoff:', data);
                }
            } catch (err) {
                console.error('Error al traspasar guardia:', err);
            }

            closeGuardShiftModal();
            if (typeof showNotification === 'function') {
                const selectedCount = ticketCodes.length;
                const msg = selectedCount > 0
                    ? `Se registraron ${selectedCount} ${selectedCount === 1 ? 'ticket' : 'tickets'} para traspaso de guardia.`
                    : 'Se registró el traspaso de guardia correctamente.';
                showNotification('Guardia traspasada', msg);
            }
            if (typeof TableSelectionManager !== 'undefined') {
                TableSelectionManager.clear();
            }
        }

        // ==========================================
        // Endpoints Auxiliares: Editar, Eliminar, Restaurar y Papelera
        // ==========================================
        async function editTicket(code, updateData, confirmarCambioArea = false) {
            const payload = { ...updateData };
            if (confirmarCambioArea) payload.confirmarCambioArea = true;
            try {
                const res = await fetch(`/api/tickets/${encodeURIComponent(code)}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json().catch(() => ({}));
                if (data.requiereConfirmacion && !confirmarCambioArea) {
                    if (confirm(data.mensaje || `El cambio en el ticket ${code} requiere confirmación de área. ¿Deseas confirmar?`)) {
                        return editTicket(code, updateData, true);
                    }
                    return false;
                }
                return res.ok;
            } catch (err) {
                console.error('Error al editar ticket:', err);
                return false;
            }
        }

        async function deleteTicket(code) {
            const motivo = prompt(`Motivo de eliminación para ${code} (mínimo 3 caracteres):`);
            if (motivo === null) return false; // canceló
            if (!motivo || motivo.trim().length < 3) {
                alert('El motivo es obligatorio y debe tener al menos 3 caracteres.');
                return false;
            }
            return _sendDeleteTicket(code, motivo.trim(), false);
        }

        async function _sendDeleteTicket(code, motivo, confirmar) {
            try {
                const body = { motivo };
                if (confirmar) body.confirmar = true;
                const res = await fetch(`/api/tickets/${encodeURIComponent(code)}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                const data = await res.json().catch(() => ({}));
                if (data.requiereConfirmacion) {
                    if (confirm(data.error || `El ticket ${code} requiere confirmación para su eliminación. ¿Deseas confirmar?`)) {
                        return _sendDeleteTicket(code, motivo, true);
                    }
                    return false;
                }
                if (!res.ok) {
                    alert(data.error || 'No se pudo eliminar el ticket.');
                    return false;
                }
                return true;
            } catch (err) {
                console.error('Error al eliminar ticket:', err);
                alert('Error de red al eliminar el ticket.');
                return false;
            }
        }


        async function openTrashModal() {
            const overlay = document.getElementById('trashModalOverlay');
            const card = document.getElementById('trashModalCard');
            if (!overlay || !card) return;
            overlay.classList.remove('opacity-0', 'pointer-events-none');
            overlay.classList.add('opacity-100');
            card.classList.remove('scale-95', 'opacity-0');
            card.classList.add('scale-100', 'opacity-100');
            await renderTrashTickets();
        }

        function closeTrashModal() {
            const overlay = document.getElementById('trashModalOverlay');
            const card = document.getElementById('trashModalCard');
            if (!overlay || !card) return;
            card.classList.remove('scale-100', 'opacity-100');
            card.classList.add('scale-95', 'opacity-0');
            overlay.classList.remove('opacity-100');
            overlay.classList.add('opacity-0', 'pointer-events-none');
        }

        async function fetchTrashTickets() {
            try {
                const res = await fetch('/api/tickets/trash');
                const data = await res.json().catch(() => ({}));
                return Array.isArray(data) ? data : (data.tickets || []);
            } catch (err) {
                console.error('Error al consultar papelera:', err);
                return [];
            }
        }

        async function renderTrashTickets() {
            const tbody = document.getElementById('trashTableBody');
            const countLabel = document.getElementById('trashCountLabel');
            if (!tbody) return;
            tbody.innerHTML = '<tr><td colspan="5" class="py-8 text-center text-[#8E8E93] italic">Cargando papelera...</td></tr>';
            
            const tickets = await fetchTrashTickets();
            if (countLabel) {
                countLabel.textContent = `${tickets.length} ticket${tickets.length === 1 ? '' : 's'} en papelera`;
            }
            if (!tickets || tickets.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="py-8 text-center text-[#8E8E93]">La papelera está vacía.</td></tr>';
                return;
            }
            tbody.innerHTML = tickets.map(t => {
                const dateStr = t.eliminado_en ? new Date(t.eliminado_en).toLocaleString('es-VE', { dateStyle: 'short', timeStyle: 'short' }) : '—';
                const safeCode = (t.codigo_incidencia || '').replace(/"/g, '&quot;');
                const safeSubject = (t.asunto || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                const safeMotivo = (t.motivo_eliminacion || 'Sin motivo').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                return `<tr class="hover:bg-[#F9F9FB] transition">
                    <td class="py-2.5 px-3 font-mono font-semibold text-[#007AFF] whitespace-nowrap">${safeCode}</td>
                    <td class="py-2.5 px-3 max-w-[220px] truncate text-[#1C1C1E]" title="${safeSubject}">${safeSubject}</td>
                    <td class="py-2.5 px-3 text-[#636366] whitespace-nowrap text-[11px]">${dateStr}</td>
                    <td class="py-2.5 px-3 max-w-[180px] truncate text-[#636366] text-[11px]" title="${safeMotivo}">${safeMotivo}</td>
                    <td class="py-2.5 px-3 text-right whitespace-nowrap">
                        <button type="button" onclick="handleRestoreTicket('${safeCode}')"
                            class="px-2.5 py-1 bg-white hover:bg-emerald-50 text-emerald-700 hover:text-emerald-800 border border-emerald-300 rounded-[6px] font-medium text-[11px] shadow-2xs transition cursor-pointer">
                            Restaurar
                        </button>
                    </td>
                </tr>`;
            }).join('');
        }

        async function restoreTicket(code) {
            try {
                const res = await fetch(`/api/tickets/${encodeURIComponent(code)}/restore`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                return res.ok;
            } catch (err) {
                console.error('Error al restaurar ticket:', err);
                return false;
            }
        }

        async function handleRestoreTicket(code) {
            const ok = await restoreTicket(code);
            if (ok) {
                await renderTrashTickets();
                if (typeof applyTableFilters === 'function') applyTableFilters();
                window.location.reload();
            } else {
                alert('No se pudo restaurar el ticket.');
            }
        }

        function updateKPIStats() {
            const rows = document.querySelectorAll('.ticket-row');
            let criticalUnassigned = 0;
            rows.forEach(row => {
                const state = (row.getAttribute('data-state') || '').toUpperCase();
                const isClosed = state === 'CERRADO' || state === 'RESUELTO';
                if (!isClosed) {
                    const prio = row.getAttribute('data-priority');
                    const op = row.querySelector('.op-col .operator-label')?.textContent || '';
                    const isUnassigned = op.includes('— Sin asignar') || !op.trim() || row.getAttribute('data-assigned') === 'false';
                    if (prio === 'P1' && isUnassigned) {
                        criticalUnassigned++;
                    }
                }
            });
            const critEl = document.getElementById('kpi-critical');
            if (critEl) critEl.textContent = criticalUnassigned;
        }

        function applyTableFilters() {
            const rows = document.querySelectorAll('#ticketTableBody .ticket-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const rowArea = row.getAttribute('data-area') || '';
                const rowPrio = row.getAttribute('data-priority') || '';
                const rowState = (row.getAttribute('data-state') || row.querySelector('.status-text')?.textContent || '').toUpperCase();
                const rowOpName = (row.getAttribute('data-operator-name') || row.querySelector('.operator-label')?.textContent || '').toLowerCase();
                const rowOpId = row.getAttribute('data-operator-id') || '';
                const rowText = row.textContent.toLowerCase();

                const isUnassigned = (row.getAttribute('data-assigned') === 'false') || (!rowOpId && (!rowOpName || rowOpName.includes('sin asignar')));

                const matchesArea = (currentAreaFilter === 'ALL' || rowArea === currentAreaFilter);
                const matchesPrio = (currentPriorityFilter === 'ALL' || rowPrio === currentPriorityFilter);
                const matchesState = (currentStateFilter === 'ALL' || rowState.includes(currentStateFilter));
                const matchesOperator = (currentOperatorFilter === 'ALL' ||
                    (currentOperatorFilter === 'UNASSIGNED' && isUnassigned) ||
                    (!isUnassigned && (
                        (rowOpId && String(rowOpId) === String(currentOperatorFilter)) ||
                        rowOpName.includes(currentOperatorFilter.toLowerCase())
                    ))
                );
                const matchesSearch = !currentSearchQuery || rowText.includes(currentSearchQuery);

                if (matchesArea && matchesPrio && matchesState && matchesOperator && matchesSearch) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const noMatch = document.getElementById('noFilterMatchRow');
            if (noMatch) {
                noMatch.classList.toggle('hidden', rows.length === 0 || visibleCount > 0);
            }

            const counter = document.getElementById('activeTicketsCounter');
            if (counter) counter.textContent = visibleCount;
            if (typeof TableSelectionManager !== 'undefined') TableSelectionManager.sync();
        }

        function filterByArea(areaCode, label, elem) {
            currentAreaFilter = areaCode;
            const labelEl = document.getElementById('filterAreaText');
            if (labelEl) labelEl.textContent = label;

            document.querySelectorAll('.filter-area-item').forEach(item => {
                item.classList.remove('bg-[#007AFF]', 'text-white');
                item.classList.add('text-[#1C1C1E]');
                const check = item.querySelector('.check-icon');
                if (check) check.classList.add('hidden');
            });
            if (elem) {
                elem.classList.add('bg-[#007AFF]', 'text-white');
                elem.classList.remove('text-[#1C1C1E]');
                const check = elem.querySelector('.check-icon');
                if (check) check.classList.remove('hidden');
            }

            const details = document.getElementById('filterAreaDropdown');
            if (details) details.removeAttribute('open');

            applyTableFilters();
        }

        function filterByPriority(prioCode, label, elem) {
            currentPriorityFilter = prioCode;
            const labelEl = document.getElementById('filterPriorityText');
            if (labelEl) labelEl.textContent = label;

            document.querySelectorAll('.filter-prio-item').forEach(item => {
                item.classList.remove('bg-[#007AFF]', 'text-white');
                item.classList.add('text-[#1C1C1E]');
                const check = item.querySelector('.check-icon');
                if (check) check.classList.add('hidden');
            });
            if (elem) {
                elem.classList.add('bg-[#007AFF]', 'text-white');
                elem.classList.remove('text-[#1C1C1E]');
                const check = elem.querySelector('.check-icon');
                if (check) check.classList.remove('hidden');
            }

            const details = document.getElementById('filterPriorityDropdown');
            if (details) details.removeAttribute('open');

            applyTableFilters();
        }

        function toggleSortDate() {
            dateSortAsc = !dateSortAsc;
            const indicator = document.getElementById('dateSortIndicator');
            if (indicator) indicator.textContent = dateSortAsc ? '▲' : '▼';

            const tbody = document.getElementById('ticketTableBody');
            const rows = Array.from(tbody.querySelectorAll('.ticket-row'));

            rows.sort((a, b) => {
                const timeA = parseInt(a.getAttribute('data-date') || '0', 10);
                const timeB = parseInt(b.getAttribute('data-date') || '0', 10);
                return dateSortAsc ? timeA - timeB : timeB - timeA;
            });

            const noMatch = document.getElementById('noFilterMatchRow');
            rows.forEach(r => tbody.appendChild(r));
            if (noMatch) tbody.appendChild(noMatch);
        }

        // Cerrar dropdowns si se hace click fuera
        document.addEventListener('click', function(e) {
            const areaDd = document.getElementById('filterAreaDropdown');
            const prioDd = document.getElementById('filterPriorityDropdown');
            if (areaDd && !areaDd.contains(e.target)) areaDd.removeAttribute('open');
            if (prioDd && !prioDd.contains(e.target)) prioDd.removeAttribute('open');
        });

        // ==========================================
        // GESTIÓN DE ESTADO EN EL FRONTEND (DOM)
        // Selección de Tickets, Conteo en Tiempo Real y Control de Botón Asignar
        // ==========================================
        const TableSelectionManager = {
            selectedCodes: new Set(),
            initialized: false,

            init() {
                if (this.initialized) return;
                this.initialized = true;
                const tableBody = document.getElementById('ticketTableBody');
                const masterCheckbox = document.getElementById('selectAllCheckbox');

                // 1. Escuchar eventos de cambio en cada checkbox de fila
                if (tableBody) {
                    tableBody.addEventListener('change', (e) => {
                        const cb = e.target.closest('.row-checkbox');
                        if (cb) {
                            this.handleCheckboxChange(cb);
                        }
                    });

                    // Permitir seleccionar haciendo clic en cualquier parte de la fila (excepto enlaces o botones interactivos)
                    tableBody.addEventListener('click', (e) => {
                        if (e.target.closest('a, button, input[type="checkbox"], select, details')) return;
                        const row = e.target.closest('.ticket-row');
                        if (row) {
                            const cb = row.querySelector('.row-checkbox');
                            if (cb && !cb.disabled) {
                                cb.checked = !cb.checked;
                                this.handleCheckboxChange(cb);
                            }
                        }
                    });
                }

                // 2. Escuchar el checkbox maestro
                if (masterCheckbox) {
                    masterCheckbox.addEventListener('change', () => {
                        this.toggleAll(masterCheckbox.checked);
                    });
                }

                // Sincronizar estado inicial
                this.sync();
            },

            handleCheckboxChange(cb) {
                if (cb.disabled) {
                    cb.checked = false;
                    return;
                }

                const code = cb.getAttribute('data-code');
                if (!code) return;

                if (cb.checked) {
                    this.selectedCodes.add(code);
                } else {
                    this.selectedCodes.delete(code);
                }

                this.updateRowStyle(cb);
                this.sync();
            },

            updateRowStyle(cb) {
                const row = cb.closest('.ticket-row');
                if (!row) return;
                if (cb.checked) {
                    row.classList.add('bg-[#007AFF]/[0.08]', 'font-medium');
                    row.classList.remove('hover:bg-[#F9F9FA]');
                } else {
                    row.classList.remove('bg-[#007AFF]/[0.08]', 'font-medium');
                    row.classList.add('hover:bg-[#F9F9FA]');
                }
            },

            toggleAll(selectAll) {
                const selectableRows = Array.from(document.querySelectorAll('.ticket-row')).filter(r => {
                    if (r.style.display === 'none') return false;
                    const cb = r.querySelector('.row-checkbox');
                    return cb && !cb.disabled;
                });
                
                selectableRows.forEach(row => {
                    const cb = row.querySelector('.row-checkbox');
                    if (cb) {
                        cb.checked = selectAll;
                        const code = cb.getAttribute('data-code');
                        if (code) {
                            if (selectAll) {
                                this.selectedCodes.add(code);
                            } else {
                                this.selectedCodes.delete(code);
                            }
                        }
                        this.updateRowStyle(cb);
                    }
                });

                this.sync();
            },

            clear() {
                this.selectedCodes.clear();
                document.querySelectorAll('.row-checkbox').forEach(cb => {
                    cb.checked = false;
                    this.updateRowStyle(cb);
                });
                const masterCheckbox = document.getElementById('selectAllCheckbox');
                if (masterCheckbox) {
                    masterCheckbox.checked = false;
                    masterCheckbox.indeterminate = false;
                }
                this.sync();
            },

            sync() {
                const count = this.selectedCodes.size;
                const badge = document.getElementById('selectionBadgeCount');
                const batchBtn = document.getElementById('batchAssignBtn');
                const batchText = document.getElementById('batchAssignBtnText');
                const masterCheckbox = document.getElementById('selectAllCheckbox');

                // 1. Conteo en tiempo real
                if (badge) {
                    badge.textContent = count;
                }

                // 2. Habilitar o deshabilitar el botón superior "Asignar Ticket"
                if (batchBtn && batchText) {
                    if (count > 0) {
                        batchBtn.disabled = false;
                        batchBtn.removeAttribute('disabled');
                        batchBtn.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                        batchBtn.classList.add('cursor-pointer', 'shadow-sm', 'hover:brightness-105', 'active:scale-95');
                        
                        // Formato de texto según singular o plural
                        batchText.textContent = count === 1 ? 'Asignar 1 ticket' : `Asignar ${count} tickets`;
                    } else {
                        batchBtn.disabled = true;
                        batchBtn.setAttribute('disabled', 'true');
                        batchBtn.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                        batchBtn.classList.remove('cursor-pointer', 'shadow-sm', 'hover:brightness-105', 'active:scale-95');
                        batchText.textContent = 'Asignar tickets';
                    }
                }

                // 3. Sincronizar estado del checkbox maestro (checked / indeterminate) sobre tickets seleccionables
                if (masterCheckbox) {
                    const selectableCheckboxes = Array.from(document.querySelectorAll('.ticket-row'))
                        .filter(r => r.style.display !== 'none')
                        .map(r => r.querySelector('.row-checkbox'))
                        .filter(cb => cb && !cb.disabled);

                    const totalCount = selectableCheckboxes.length;
                    const checkedCount = selectableCheckboxes.filter(cb => cb.checked).length;

                    if (totalCount === 0 || checkedCount === 0) {
                        masterCheckbox.checked = false;
                        masterCheckbox.indeterminate = false;
                    } else if (checkedCount === totalCount) {
                        masterCheckbox.checked = true;
                        masterCheckbox.indeterminate = false;
                    } else {
                        masterCheckbox.checked = false;
                        masterCheckbox.indeterminate = true;
                    }
                }
            }
        };

        // Retrocompatibilidad con llamadas inline existentes
        function updateSelectionCount() {
            TableSelectionManager.selectedCodes.clear();
            document.querySelectorAll('.row-checkbox:checked').forEach(cb => {
                if (!cb.disabled) {
                    const code = cb.getAttribute('data-code');
                    if (code) TableSelectionManager.selectedCodes.add(code);
                    TableSelectionManager.updateRowStyle(cb);
                } else {
                    cb.checked = false;
                }
            });
            TableSelectionManager.sync();
        }

        function toggleSelectAll(masterCheckbox) {
            TableSelectionManager.toggleAll(masterCheckbox.checked);
        }

        // Enrutamiento del Modal según cantidad de tickets seleccionados
        function openBatchAssignModal() {
            const codes = Array.from(TableSelectionManager.selectedCodes);
            if (codes.length === 0) return;

            if (codes.length === 1) {
                // Si el contador es igual a 1, inyectar los datos de esa fila específica en los campos del modal
                const code = codes[0];
                const row = document.getElementById('row-' + code);
                if (row) {
                    const subject = row.getAttribute('data-subject') 
                        || row.querySelector('.truncate')?.getAttribute('title') 
                        || row.querySelector('.truncate')?.textContent?.trim() 
                        || '';
                    const area = row.getAttribute('data-area') || 'GENERAL';
                    const operatorId = row.getAttribute('data-operator-id') || '';
                    const operatorName = row.getAttribute('data-operator-name') || '';
                    const priority = row.getAttribute('data-priority') || 'P1';

                    openAssignModal(code, subject, area, operatorId, operatorName, priority);
                } else {
                    openAssignModal(code, `Incidencia ${code}`, 'GENERAL', '', '', 'P1');
                }
            } else {
                // Si el contador es mayor a 1, agrupar los IDs separados por comas y cambiar el texto del asunto al formato de lote
                const groupedCodes = codes.join(', ');
                const batchSubject = `Lote de ${codes.length} incidencias seleccionadas`;

                // Obtener el área común o de la primera fila seleccionada
                const firstRow = document.getElementById('row-' + codes[0]);
                const area = firstRow ? (firstRow.getAttribute('data-area') || 'REDES_FTTH') : 'REDES_FTTH';

                openAssignModal(groupedCodes, batchSubject, area, '', '', 'P1');
            }
        }

        // Auto-inicialización y Fix Contador Dinámico (R1.4)
        let dashboardTableInitialized = false;
        function initDashboardTable() {
            if (dashboardTableInitialized) return;
            dashboardTableInitialized = true;
            if (typeof TableSelectionManager !== 'undefined') {
                TableSelectionManager.init();
            }
            if (typeof applyTableFilters === 'function') {
                applyTableFilters();
            }
        }

        document.addEventListener('DOMContentLoaded', initDashboardTable);
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            initDashboardTable();
        }

        function handleBackdropClick(event) {
            if (event.target === document.getElementById('assignModalOverlay')) {
                closeAssignModal();
            }
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeAssignModal();
                closeGuardShiftModal();
                hideNotification();
            }
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                const searchInput = document.getElementById('globalSearchInput');
                if (searchInput) {
                    searchInput.focus();
                    searchInput.select();
                }
            }
        });
    </script>
</body>

</html>