                        <div class="inline-flex items-center gap-1.5 rounded-[8px] border border-[#D1D1D6] bg-[#F5F5F7] px-2 py-1 shadow-sm">
     <svg class="w-3.5 h-3.5 text-[#636366]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <path d="M3.5 8.5A2.5 2.5 0 0 1 6 6h3l1.5 2H18a2.5 2.5 0 0 1 2.5 2.5v6A2.5 2.5 0 0 1 18 19H6A2.5 2.5 0 0 1 3.5 16.5v-8Z"></path>
     </svg>
         <span class="font-mono text-[10px] font-bold text-[#636366]">#</span> 
         <span class="font-mono text-[11px] font-semibold text-[#1C1C1E]"><%= typeof nextTicketCode !== 'undefined' ? nextTicketCode : 'INC-004' %></span> 
</div>
                       <!-- <h3 id="newTicketTitle" class="text-[15px] font-bold text-[#1C1C1E] uppercase">Nuevo Ticket</h3> -->
                        
                        <p class="text-[12px] text-[#8E8E93] mt-1">Nuevo Ticket</p>
