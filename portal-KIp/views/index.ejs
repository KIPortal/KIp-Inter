<!DOCTYPE html>
<html class="h-full bg-[#E8E8ED]" lang="es">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>
        <%= titulo %>
    </title>
    <!-- Tailwind CSS v3 with Plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
        rel="stylesheet">
    <link href="/css/figma-assets.css" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', 'Inter', 'SF Pro Text', 'SF Pro Display', 'Helvetica Neue', 'sans-serif'],
                        mono: ['SF Mono', 'JetBrains Mono', 'Menlo', 'Monaco', 'Courier New', 'monospace']
                    },
                    colors: {
                        mac: {
                            bg: '#F5F5F7', window: '#FFFFFF', sidebar: '#EBEBF0', accent: '#007AFF', accentHover: '#0062CC',
                            subtle: '#8E8E93', border: '#E5E5EA', borderLight: '#F2F2F7', headerBorder: '#D1D1D6',
                            selected: '#DCEBFE', selectedText: '#0062CC', dangerLight: '#FFE5E5', dangerText: '#D70015',
                            successLight: '#E3F9E5', successText: '#1B873F', warningLight: '#FFF4D6', warningText: '#B25E02'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            user-select: none;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.15);
            border-radius: 9999px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 0, 0, 0.28);
        }

        .num-tabular {
            font-variant-numeric: tabular-nums;
        }

        .finder-th+.finder-th {
            border-left: 1px solid #E5E5EA;
        }

        .priority-badge {
            background-color: var(--prio-bg, #F2F2F7);
            color: var(--prio-txt, #8E8E93);
            border-color: var(--prio-border, #E5E5EA);
        }

        .macos-focus-ring {
            box-shadow: 0 0 0 3px rgba(0, 136, 255, 0.35);
            border-color: #389BFF !important;
        }
    </style>
</head>

<body class="h-dvh w-full min-w-0 bg-[#F5F5F7] overflow-hidden flex flex-col font-sans text-[13px] text-[#1C1C1E] m-0 p-0">

    <!-- macOS Full Application Viewport -->
    <div class="relative w-full h-full flex flex-col overflow-hidden bg-white select-none">

        <!-- BEGIN: macOS Unified Titlebar & Toolbar -->
        <header
            class="h-[56px] bg-white border-b border-[#E5E5EA] px-2 sm:px-4 flex items-center justify-between gap-2 select-none z-20 flex-shrink-0">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-3">
                    <img alt="Logo Inter" class="h-[28px] w-auto object-contain"
                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuAtCf1kyA5Xv3ji8h2EifMIzU5ZiU3r5XlzhgnLFSjZns31wuEmyWwyxb7Ibp30TQgk1BU7IO9qFU5Ri9xtP1U6XPsTT3Ew2iMHnDiOmn4Y-IT_Fy4lZdLyfTzEBMnrxeUJ-S7GYU870d6-54QeqaoelnE_92ZTd36r0rRy5wwIyJJcT881mYSiNC15GTzaM5v_ZLKyzhMIEo-MMFCaNtJqZCR6YOc7FYA8AUcQvEfl_R03WH_n6yHU3a8zKevr3gppvw">
                    <div class="h-5 w-[1px] bg-[#D1D1D6]"></div>
                    <span class="text-[14px] font-semibold text-[#1C1C1E] tracking-tight">Operaciones IP</span>
                </div>
                <div
                    class="ml-2 hidden md:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#F2F2F7] border border-[#D1D1D6] text-[11px] text-[#48484A] font-medium">
                    <span class="w-2 h-2 rounded-full bg-[#34C759]"></span>
                    <span>Turno A (07:00 - 15:00)</span>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div
                    class="relative hidden sm:flex items-center w-[130px] h-[32px] px-2 gap-1 bg-[#F5F5F7] border border-[#D1D1D6] rounded-[7px] transition focus-within:bg-white focus-within:border-[#007AFF]">
                    <svg class="w-3.5 h-3.5 text-[#8E8E93] flex-shrink-0 pointer-events-none" fill="none"
                        stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
                    </svg>
                    <input
                        id="globalSearchInput"
                        oninput="onSearchInput(this.value)"
                        class="w-full min-w-0 bg-transparent text-[11px] text-[#1C1C1E] placeholder-[#8E8E93] focus:outline-none border-none p-0"
                        placeholder="Buscar..." type="text">
                    <span
                        class="flex-shrink-0 px-1 py-0.5 text-[9px] font-mono text-[#8E8E93] bg-white border border-[#D1D1D6] rounded pointer-events-none font-medium">⌘K</span>
                </div>
                <div class="flex items-center gap-2">
                    <button id="newTicketButton" type="button"
                        class="flex items-center gap-1.5 px-3 py-1.5 bg-[#007AFF] hover:bg-[#0062CC] text-white rounded-[7px] font-medium text-[12px] shadow-sm transition">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <line x1="12" x2="12" y1="5" y2="19"></line>
                            <line x1="5" x2="19" y1="12" y2="12"></line>
                        </svg>
                        <span class="hidden sm:inline">Nuevo Ticket</span>
                    </button>
                </div>
                <div class="h-5 w-[1px] bg-[#D1D1D6] mx-0.5"></div>
                <div
                    class="flex items-center gap-2 px-2 py-1 rounded-[8px] hover:bg-[#F2F2F7] transition cursor-pointer border border-transparent hover:border-[#D1D1D6]">
                    <div
                        class="w-7 h-7 rounded-full bg-[#007AFF] text-white flex items-center justify-center font-mono font-semibold text-[11px]">
                        <%= typeof currentUser !== 'undefined' && currentUser && currentUser.nombre ? (currentUser.nombre.trim().split(/\s+/).slice(0, 2).map(part => part.charAt(0)).join('').toUpperCase() || 'CP') : 'CP' %></div>
                    <div class="hidden sm:flex flex-col text-left">
                        <span class="text-[11px] font-medium text-[#1C1C1E] leading-tight"><%= typeof currentUser !== 'undefined' && currentUser && currentUser.nombre ? currentUser.nombre : 'Coord. NOC' %></span>
                        <span class="text-[9px] font-mono font-bold text-[#34C759] tracking-wider leading-tight"><%= typeof currentUser !== 'undefined' && currentUser && currentUser.email ? currentUser.email : '● LÍDER ACTIVO' %></span>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Body Workspace -->
        <div class="flex-1 flex overflow-hidden min-h-0 bg-[#F5F5F7]">

            <!-- BEGIN: Finder-style macOS Sidebar -->
            <aside
                class="w-[52px] md:w-[200px] flex-shrink-0 bg-[#EBEBF0]/95 border-r border-[#D8D8DC] flex flex-col justify-between select-none py-3 px-1 md:px-2">
                <div class="space-y-4">
                    <div>
                        <div class="hidden md:block px-2.5 pb-1.5 text-[10px] font-bold text-[#8E8E93] uppercase tracking-wider">
                            Navegación</div>
                        <nav class="space-y-0.5">
                            <a id="dashboardNavLink" class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] bg-black/5 text-[#007AFF] font-medium text-[12px] transition"
                                href="#dashboard" onclick="event.preventDefault(); showDashboardSection('dashboard')">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-[#007AFF]" fill="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M19.5 21a3 3 0 0 0 3-3v-4.5a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3V18a3 3 0 0 0 3 3h15ZM1.5 10.5V6a3 3 0 0 1 3-3h15a3 3 0 0 1 3 3v4.5">
                                        </path>
                                    </svg>
                                    <span class="hidden md:inline">Dashboard General</span>
                                </div>
                                <span
                                    class="hidden md:inline font-mono text-[9px] bg-[#007AFF]/15 text-[#0062CC] px-1.5 py-0.5 rounded font-bold">
                                    <%= ticketsActivos %>
                                </span>
                            </a>
                            <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#3A3A3C] hover:bg-black/5 text-[12px] font-medium transition"
                                href="#">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-[#8E8E93]" fill="none" stroke="currentColor"
                                        stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <span class="hidden md:inline">Auditoría</span>
                                </div>
                            </a>
                            <a id="shiftManagementNavLink" class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#3A3A3C] hover:bg-black/5 text-[12px] font-medium transition"
                                href="#gestion-turno" onclick="event.preventDefault(); showDashboardSection('shift')">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-[#8E8E93]" fill="none" stroke="currentColor"
                                        stroke-width="2" viewBox="0 0 24 24">
                                        <path
                                            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                                        </path>
                                    </svg>
                                    <span class="hidden md:inline">Gestión de Turno</span>
                                </div>
                                <span
                                    class="hidden md:inline font-mono text-[9px] bg-[#34C759]/15 text-[#34C759] px-1.5 py-0.5 rounded font-bold">
                                    <%= operadoresDisponibles %>/<%= totalOperadores %>
                                </span>
                            </a>
                            <a class="flex items-center justify-between px-2.5 py-1.5 rounded-[6px] text-[#3A3A3C] hover:bg-black/5 text-[12px] font-medium transition"
                                href="#">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-[#8E8E93]" fill="none" stroke="currentColor"
                                        stroke-width="2" viewBox="0 0 24 24">
                                        <path
                                            d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
                                        </path>
                                    </svg>
                                    <span class="hidden md:inline">Reportes</span>
                                </div>
                            </a>
                        </nav>
                    </div>
                </div>

                <!-- Sidebar Bottom Footer -->
                <div class="p-1.5 md:p-2.5 rounded-[8px] bg-white/70 border border-black/5 shadow-xs space-y-1">
                    <div class="flex items-center justify-between text-[11px]">
                        <span class="flex items-center gap-1.5 font-medium text-[#1C1C1E]"><span
                                class="w-2 h-2 rounded-full bg-[#34C759]"></span><span class="hidden md:inline">Servidor NOC</span></span>
                        <span class="hidden md:inline font-mono text-[10px] text-[#34C759] font-bold">18ms</span>
                    </div>
                    <div class="hidden md:flex items-center justify-between text-[10px] text-[#8E8E93] font-mono">
                        <span>Sincronía OLT</span>
                        <span class="text-[#3A3A3C]">Activo (0s)</span>
                    </div>
                </div>
            </aside>
            <!-- END: Sidebar -->

            <!-- BEGIN: Content Main Area -->
            <main class="flex-1 flex flex-col min-w-0 bg-white overflow-hidden p-2 sm:p-4 gap-3">
                <div id="dashboardOverview" class="flex min-h-0 flex-1 flex-col gap-3 overflow-hidden">

                <!-- BEGIN: KPI Cards / macOS Widget Panels -->
                <section class="grid grid-cols-2 xl:grid-cols-4 gap-2 sm:gap-3 flex-shrink-0" data-purpose="kpi-cards">
                    <!-- Card 1: Tickets Activos -->
                    <div
                        class="bg-white border border-[#E5E5EA] rounded-[12px] p-4 flex flex-col justify-between shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-[0_2px_6px_rgba(0,0,0,0.06)] transition">
                        <div class="flex items-start justify-between">
                            <span
                                class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider leading-tight">TICKETS
                                ACTIVOS</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[#8E8E93] mt-0.5"></span>
                        </div>
                        <div class="mt-2 text-[32px] font-semibold font-mono text-[#1C1C1E] tracking-tight num-tabular leading-none"
                            id="kpi-active">
                            <%= ticketsActivos %>
                        </div>
                    </div>

                    <!-- Card 2: Tickets Realizados -->
                    <div
                        class="bg-white border border-[#E5E5EA] rounded-[12px] p-4 flex flex-col justify-between shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-[0_2px_6px_rgba(0,0,0,0.06)] transition">
                        <div class="flex items-start justify-between">
                            <span
                                class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider leading-tight">TICKETS<br>REALIZADOS</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[#8E8E93] mt-0.5"></span>
                        </div>
                        <div class="mt-2 text-[32px] font-semibold font-mono text-[#1C1C1E] tracking-tight num-tabular leading-none"
                            id="kpi-done">
                            <%= ticketsRealizados %>
                        </div>
                    </div>

                    <!-- Card 3: Críticos Sin Asignar -->
                    <div
                        class="bg-white border border-[#E5E5EA] rounded-[12px] p-4 flex flex-col justify-between shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-[0_2px_6px_rgba(0,0,0,0.06)] transition">
                        <div class="flex items-start justify-between">
                            <span
                                class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider leading-tight">CRÍTICOS
                                SIN<br>ASIGNAR</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[#FF3B30] mt-0.5"></span>
                        </div>
                        <div class="mt-2 text-[32px] font-semibold font-mono text-[#1C1C1E] tracking-tight num-tabular leading-none"
                            id="kpi-critical">
                            <%= criticosSinAsignar %>
                        </div>
                    </div>

                    <!-- Card 4: Operadores Disponibles -->
                    <div id="operatorsKpiCard"
                        class="relative bg-white border border-[#E5E5EA] rounded-[12px] p-4 flex flex-col justify-between shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-[0_2px_6px_rgba(0,0,0,0.06)] transition">
                        <div class="flex items-start justify-between">
                            <span
                                class="text-[11px] font-semibold text-[#8E8E93] uppercase tracking-wider leading-tight">OPERADORES
                                DISPONIBLES</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[#34C759] mt-0.5"></span>
                        </div>
                        <div class="mt-2 flex items-center justify-between">
                            <div class="flex items-baseline gap-1.5">
                                <span id="kpi-operators"
                                    class="text-[32px] font-semibold font-mono text-[#1C1C1E] tracking-tight num-tabular leading-none">
                                    <%= operadoresDisponibles %>
                                </span>
                                <span class="text-xs font-mono text-[#8E8E93] font-medium leading-none">/ <%= totalOperadores %> activos</span>
                            </div>
                            <button id="operatorsPopoverButton" type="button" aria-label="Ver operadores de turno"
                                aria-controls="operatorsPopover" aria-expanded="false" title="Ver operadores de turno"
                                class="w-9 h-9 rounded-[10px] bg-[#F7F9FC] border border-[#E4EAF2] flex items-center justify-center text-[#64748B] hover:bg-[#EAF2FF] hover:text-[#2563EB] hover:border-[#C8DBFF] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#007AFF]/30 transition cursor-pointer">
                                <svg class="w-4 h-4 text-[#636366]" fill="none" stroke="currentColor" stroke-width="1.8"
                                    viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </button>
                        </div>
                        <section id="operatorsPopover" role="dialog" aria-labelledby="operatorsPopoverTitle" aria-hidden="true"
                            class="hidden operator-popover-window">
                            <header class="flex items-start justify-between gap-3 px-4 py-3 border-b border-[#E5EAF0] bg-white">
                                <div class="flex items-start gap-2.5 min-w-0">
                                    <span class="mt-1.5 w-2 h-2 shrink-0 rounded-full bg-[#34C759]"></span>
                                    <div class="min-w-0">
                                        <h2 id="operatorsPopoverTitle" class="text-[13px] leading-4 font-semibold text-[#1C1C1E]">Operadores de turno</h2>
                                        <p class="mt-1 text-[11px] text-[#8E8E93]">Estado y carga de trabajo</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <span class="px-2 py-1 rounded-full bg-[#E5F9ED] text-[#16834A] text-[10px] font-semibold"><%= operadoresConectados %> conectados</span>
                                    <button id="operatorsPopoverClose" type="button" aria-label="Cerrar operadores"
                                        class="w-7 h-7 flex items-center justify-center rounded-[7px] text-[#8E8E93] hover:bg-[#F2F2F7] hover:text-[#48484A] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#007AFF]/30 transition">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg>
                                    </button>
                                </div>
                            </header>
                            <div class="operator-popover-list">
                                <% if (operadoresTurno.length) { %>
                                    <% operadoresTurno.forEach(function(operador) {
                                        const activeTickets = operador.tickets_asignados || [];
                                        const isBusy = activeTickets.length > 0;
                                        const operatorParts = operador.nombre.trim().split(/\s+/);
                                        const operatorInitials = operatorParts.length > 1
                                            ? `${operatorParts[0][0]}${operatorParts[operatorParts.length - 1][0]}`.toUpperCase()
                                            : operador.nombre.slice(0, 2).toUpperCase();
                                        const operatorAreaLabels = {
                                            GENERAL: 'Operaciones IP',
                                            REDES_FTTH: 'Redes FTTH / OLT',
                                            TRAFICO_INALAMBRICO: 'Tráfico inalámbrico',
                                            WAN: 'WAN',
                                            GRANDES_CLIENTES: 'Grandes clientes',
                                            SEGURIDAD: 'Seguridad',
                                            TELEFONIA: 'Telefonía'
                                        };
                                        const operatorStatus = isBusy
                                            ? { label: 'Ocupado', classes: 'bg-[#FFF4D6] text-[#A86100]' }
                                            : operador.estado_operativo === 'DISPONIBLE'
                                                ? { label: 'Disponible', classes: 'bg-[#E5F9ED] text-[#16834A]' }
                                                : operador.estado_operativo === 'EN_TERRENO'
                                                    ? { label: 'En terreno', classes: 'bg-[#EAF2FF] text-[#2563EB]' }
                                                    : { label: 'Ausente', classes: 'bg-[#F2F2F7] text-[#636366]' };
                                    %>
                                        <article class="flex gap-3 px-4 py-3.5">
                                            <div class="relative shrink-0">
                                                <span class="w-10 h-10 flex items-center justify-center rounded-full border border-[#D8E8FF] bg-[#EFF6FF] text-[#3974C6] text-[12px] font-semibold"><%= operatorInitials %></span>
                                                <span class="absolute right-0 bottom-0 w-3 h-3 rounded-full border-2 border-white <%= operador.estado_operativo === 'AUSENTE' ? 'bg-[#A1A1AA]' : 'bg-[#34C759]' %>"></span>
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-start justify-between gap-2">
                                                    <h3 class="min-w-0 text-[12px] leading-4 font-semibold text-[#1C1C1E] break-words"><%= operador.nombre %></h3>
                                                    <span class="shrink-0 px-2 py-1 rounded-[6px] text-[10px] font-semibold <%= operatorStatus.classes %>"><%= operatorStatus.label %></span>
                                                </div>
                                                <p class="mt-1 text-[11px] text-[#8E8E93] truncate"><%= operatorAreaLabels[operador.area_designada] || operador.area_designada %></p>
                                                <% if (activeTickets.length) { %>
                                                    <div class="mt-2 flex items-start gap-2 text-[11px] text-[#3974C6]">
                                                        <span class="mt-1 w-1.5 h-1.5 rounded-full bg-[#3974C6] shrink-0"></span>
                                                        <span><%= activeTickets.length %> <%= activeTickets.length === 1 ? 'ticket activo' : 'tickets activos' %> · <%= activeTickets.slice(0, 2).map(ticket => ticket.codigo_incidencia).join(', ') %><%= activeTickets.length > 2 ? ` +${activeTickets.length - 2}` : '' %></span>
                                                    </div>
                                                <% } else if (operador.estado_operativo === 'DISPONIBLE') { %>
                                                    <div class="mt-2 flex items-center gap-2 text-[11px] text-[#16834A]">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-[#34C759] shrink-0"></span>
                                                        <span>Sin carga actual (0 tickets)</span>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <a href="mailto:<%= operador.email %>" aria-label="Contactar a <%= operador.nombre %>"
                                                class="self-start shrink-0 px-2.5 py-1.5 rounded-[7px] border border-[#DCE4EF] bg-white text-[10px] font-semibold text-[#52647D] hover:border-[#BDD3F4] hover:bg-[#F3F7FD] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#007AFF]/30 transition">Contactar</a>
                                        </article>
                                    <% }); %>
                                <% } else { %>
                                    <p class="px-4 py-8 text-center text-[12px] text-[#8E8E93]">No hay operadores registrados en el turno.</p>
                                <% } %>
                            </div>
                            <footer class="flex justify-end border-t border-[#E5EAF0] bg-[#F8FAFC] px-4 py-2.5">
                                <a href="#gestion-turno" onclick="event.preventDefault(); showDashboardSection('shift')" class="inline-flex items-center gap-1.5 rounded text-[11px] font-semibold text-[#3974C6] hover:text-[#245AA5] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#007AFF]/30 transition">
                                    Gestionar turno
                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                                </a>
                            </footer>
                        </section>
                    </div>
                </section>
                <!-- END: KPI Cards -->

                <!-- BEGIN: macOS Finder List View Table Container -->
                <section
                    class="flex-1 bg-white border border-[#E5E5EA] rounded-[12px] flex flex-col min-h-0 overflow-hidden shadow-[0_1px_4px_rgba(0,0,0,0.04)]"
                    data-purpose="incident-queue">
                    <!-- Table Header Filter Bar -->
                    <div
                        class="px-3 py-2 bg-[#F6F6F8] border-b border-[#E5E5EA] flex items-center justify-between flex-shrink-0 relative z-20 overflow-visible">
                        <div class="flex items-center gap-2">
                            <div class="flex items-center gap-1.5 text-xs font-semibold text-[#1C1C1E] pr-2">
                                <span>Resumen Operativo</span>
                            </div>
                            <div class="h-4 w-[1px] bg-[#D1D1D6]"></div>
                            
                            <!-- Área Dropdown -->
                            <div class="flex items-center gap-1.5">
                                <span class="text-[11px] text-[#8E8E93] font-medium">Área:</span>
                                <details id="filterAreaDropdown" class="relative group select-none z-30">
                                    <summary
                                        class="list-none flex items-center justify-between gap-2 h-[24px] pl-2 pr-1 bg-white hover:bg-[#F9F9FA] active:bg-[#F2F2F7] rounded-[6px] border border-black/10 shadow-[0_1px_2px_rgba(0,0,0,0.04)] cursor-pointer text-[12px] font-medium text-[#1C1C1E] transition focus:outline-none">
                                        <span id="filterAreaText"
                                            class="truncate text-[12px] leading-none font-medium text-[#1C1C1E]/90">General</span>
                                        <span
                                            class="flex items-center justify-center w-[16px] h-[16px] rounded-[4px] bg-black/5 text-[#636366]"><svg
                                                class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2"
                                                viewBox="0 0 24 24">
                                                <path d="M6 9l6 6 6-6"></path>
                                            </svg></span>
                                    </summary>
                                    <div
                                        class="absolute left-0 top-[28px] w-[160px] bg-white rounded-[8px] border border-[#D1D1D6] shadow-[0_8px_20px_rgba(0,0,0,0.12)] p-1 z-30 space-y-0.5 text-[12px]">
                                        <a class="filter-area-item flex items-center justify-between px-2 py-1 rounded-[5px] bg-[#007AFF] text-white font-medium cursor-pointer"
                                            onclick="event.preventDefault();filterByArea('ALL', 'General', this)">
                                            <span class="truncate">General</span>
                                            <svg class="check-icon w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                                        </a>
                                        <a class="filter-area-item flex items-center justify-between px-2 py-1 rounded-[5px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                            onclick="event.preventDefault();filterByArea('REDES_FTTH', 'Redes FTTH', this)">
                                            <span class="truncate">Redes FTTH</span>
                                            <svg class="check-icon w-3 h-3 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                                        </a>
                                        <a class="filter-area-item flex items-center justify-between px-2 py-1 rounded-[5px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                            onclick="event.preventDefault();filterByArea('WAN', 'WAN', this)">
                                            <span class="truncate">WAN</span>
                                            <svg class="check-icon w-3 h-3 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                                        </a>
                                        <a class="filter-area-item flex items-center justify-between px-2 py-1 rounded-[5px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                            onclick="event.preventDefault();filterByArea('GRANDES_CLIENTES', 'Grandes Clientes', this)">
                                            <span class="truncate">Grandes Clientes</span>
                                            <svg class="check-icon w-3 h-3 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                                        </a>
                                        <a class="filter-area-item flex items-center justify-between px-2 py-1 rounded-[5px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                            onclick="event.preventDefault();filterByArea('TELEFONIA', 'Telefonía', this)">
                                            <span class="truncate">Telefonía</span>
                                            <svg class="check-icon w-3 h-3 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                                        </a>
                                        <a class="filter-area-item flex items-center justify-between px-2 py-1 rounded-[5px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                            onclick="event.preventDefault();filterByArea('SEGURIDAD', 'Seguridad', this)">
                                            <span class="truncate">Seguridad</span>
                                            <svg class="check-icon w-3 h-3 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                                        </a>
                                        <a class="filter-area-item flex items-center justify-between px-2 py-1 rounded-[5px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                            onclick="event.preventDefault();filterByArea('TRAFICO_INALAMBRICO', 'Tráfico', this)">
                                            <span class="truncate">Tráfico</span>
                                            <svg class="check-icon w-3 h-3 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                                        </a>
                                    </div>
                                </details>
                            </div>

                            <!-- Filtrar por: Fecha y Prioridad -->
                            <div class="flex items-center gap-1.5 ml-1">
                                <span class="text-[11px] text-[#8E8E93] font-medium leading-none">Filtrar por:</span>
                                <button id="filterDateBtn" onclick="toggleSortDate()"
                                    class="flex items-center gap-1 h-[24px] px-2 bg-white hover:bg-[#F9F9FA] active:bg-[#F2F2F7] rounded-[6px] border border-black/10 shadow-[0_1px_2px_rgba(0,0,0,0.04)] text-[12px] font-medium text-[#1C1C1E] transition focus:outline-none cursor-pointer"
                                    title="Ordenar por Fecha">
                                    <svg class="w-3 h-3 text-[#636366] flex-shrink-0" fill="none" stroke="currentColor"
                                        stroke-width="1.8" viewBox="0 0 24 24">
                                        <rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect>
                                        <line x1="16" x2="16" y1="2" y2="6"></line>
                                        <line x1="8" x2="8" y1="2" y2="6"></line>
                                        <line x1="3" x2="21" y1="10" y2="10"></line>
                                    </svg>
                                    <span class="leading-none">Fecha</span>
                                    <span id="dateSortIndicator" class="text-[9px] text-[#8E8E93] leading-none">▼</span>
                                </button>
                                <details id="filterPriorityDropdown" class="relative group select-none z-30">
                                    <summary
                                        class="list-none flex items-center h-[24px] pl-2 pr-1 bg-white hover:bg-[#F9F9FA] active:bg-[#F2F2F7] rounded-[6px] border border-black/10 shadow-[0_1px_2px_rgba(0,0,0,0.04)] gap-1.5 cursor-pointer transition select-none">
                                        <span id="filterPriorityText"
                                            class="text-[12px] font-medium text-[#1C1C1E] leading-none">Prioridad</span>
                                        <span
                                            class="flex items-center justify-center w-[16px] h-[16px] rounded-[4px] bg-black/5 text-[#636366]"><svg
                                                class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2"
                                                viewBox="0 0 24 24">
                                                <path d="M7 15l5 5 5-5M7 9l5-5 5 5"></path>
                                            </svg></span>
                                    </summary>
                                    <div
                                        class="absolute left-0 top-[28px] w-[140px] bg-white rounded-[8px] border border-[#D1D1D6] shadow-[0_8px_20px_rgba(0,0,0,0.12)] p-1 z-30 space-y-0.5 text-[12px]">
                                        <a class="filter-prio-item flex items-center justify-between px-2 py-1 rounded-[5px] bg-[#007AFF] text-white font-medium cursor-pointer"
                                            onclick="event.preventDefault();filterByPriority('ALL', 'Prioridad', this)">
                                            <span>Todas</span>
                                            <svg class="check-icon w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                                        </a>
                                        <a class="filter-prio-item flex items-center justify-between px-2 py-1 rounded-[5px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                            onclick="event.preventDefault();filterByPriority('P1', 'P1 (Crítica)', this)">
                                            <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[#FF3B30]"></span>P1 (Crítica)</span>
                                            <svg class="check-icon w-3 h-3 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                                        </a>
                                        <a class="filter-prio-item flex items-center justify-between px-2 py-1 rounded-[5px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                            onclick="event.preventDefault();filterByPriority('P2', 'P2 (Media)', this)">
                                            <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[#FFBD2E]"></span>P2 (Media)</span>
                                            <svg class="check-icon w-3 h-3 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                                        </a>
                                        <a class="filter-prio-item flex items-center justify-between px-2 py-1 rounded-[5px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                            onclick="event.preventDefault();filterByPriority('P3', 'P3 (Baja)', this)">
                                            <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[#8E8E93]"></span>P3 (Baja)</span>
                                            <svg class="check-icon w-3 h-3 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                                        </a>
                                        <a class="filter-prio-item flex items-center justify-between px-2 py-1 rounded-[5px] text-[#1C1C1E] hover:bg-[#007AFF] hover:text-white font-medium transition cursor-pointer"
                                            onclick="event.preventDefault();filterByPriority('NONE', 'S/P', this)">
                                            <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[#C7C7CC]"></span>S/P (Sin Prioridad)</span>
                                            <svg class="check-icon w-3 h-3 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                                        </a>
                                    </div>
                                </details>
                            </div>
                        </div>

                        <!-- Right: Bulk Selection & Action Button -->
                        <div class="flex items-center gap-3 text-xs text-[#8E8E93]">
                            <div class="flex items-center gap-2">
                                <span class="text-[11px]">Seleccionados: <strong id="selectionBadgeCount"
                                        class="text-[#007AFF] font-mono font-semibold">0</strong></span>
                                <button id="batchAssignBtn" onclick="openBatchAssignModal()"
                                    class="flex items-center gap-1.5 h-[24px] px-2.5 bg-[#007AFF] hover:bg-[#0062CC] text-white rounded-[6px] text-[11px] font-medium shadow-xs transition select-none disabled:opacity-40 disabled:pointer-events-none disabled:cursor-not-allowed"
                                    disabled>
                                    <span id="batchAssignBtnText" class="leading-none">Asignar Ticket</span>
                                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2.5"
                                        viewBox="0 0 24 24">
                                        <path d="M6 9l6 6 6-6"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Finder Native List Table -->
                    <div class="flex-1 overflow-y-auto overflow-x-auto min-h-0 bg-white">
                        <table class="w-full text-left border-collapse table-fixed min-w-[950px]">
                            <thead
                                class="sticky top-0 bg-[#F9F9FA] text-[11px] font-medium text-[#8E8E93] border-b border-[#E5E5EA] z-10 shadow-xs">
                                <tr>
                                    <th class="finder-th py-2 px-3 w-[40px] text-center">
                                        <div class="flex items-center justify-center"><input id="selectAllCheckbox"
                                                onchange="TableSelectionManager.toggleAll(this.checked)" type="checkbox"
                                                class="w-3.5 h-3.5 rounded text-[#007AFF] border-[#D1D1D6] focus:ring-0 focus:outline-none cursor-pointer">
                                        </div>
                                    </th>
                                    <th class="finder-th py-2 px-3 w-[115px] font-semibold text-[#48484A]">Ticket</th>
                                    <th class="finder-th py-2 px-2.5 w-[85px] font-semibold text-[#48484A]">Prioridad
                                    </th>
                                    <th class="finder-th py-2 px-2.5 w-[110px] font-semibold text-[#48484A]">Estado</th>
                                    <th class="finder-th py-2 px-3 font-semibold text-[#48484A]">Asunto</th>
                                    <th class="finder-th py-2 px-2.5 w-[150px] font-semibold text-[#48484A]">OP /
                                        Asignado</th>
                                    <th
                                        class="finder-th py-2 px-2.5 w-[110px] text-center font-semibold text-[#48484A]">
                                        Tiempo</th>
                                    <th class="finder-th py-2 px-3 w-[95px] text-right font-semibold text-[#48484A]">
                                        Acción</th>
                                </tr>
                            </thead>
                            <tbody id="ticketTableBody" class="divide-y divide-[#EBEBF0] text-[12px] font-normal">
                                <% if (tickets && tickets.length > 0) { %>
                                    <% tickets.forEach(function(ticket) { 
                                        let prio = 'NONE';
                                        let prioLabel = 'S/P';
                                        let prioDot = '#C7C7CC';
                                        let prioBg = '#F2F2F7';
                                        let prioTxt = '#8E8E93';
                                        let prioBorder = '#E5E5EA';

                                        if (ticket.puntos_complejidad >= 8) {
                                            prio = 'P1'; prioLabel = 'P1'; prioDot = '#FF3B30'; prioBg = '#FFE5E5'; prioTxt = '#D70015'; prioBorder = '#FFD0D0';
                                        } else if (ticket.puntos_complejidad >= 5) {
                                            prio = 'P2'; prioLabel = 'P2'; prioDot = '#FFBD2E'; prioBg = '#FFF4D6'; prioTxt = '#B25E02'; prioBorder = '#FFE6A6';
                                        } else if (ticket.puntos_complejidad >= 1) {
                                            prio = 'P3'; prioLabel = 'P3'; prioDot = '#8E8E93'; prioBg = '#F2F2F7'; prioTxt = '#1C1C1E'; prioBorder = '#D1D1D6';
                                        }

                                        let estado = ticket.estado_actual || 'NUEVO';
                                        let stateBg = 'rgba(100, 116, 139, 0.1)'; let stateColor = 'rgb(30, 41, 59)';
                                        let stateBorder = 'rgba(100, 116, 139, 0.2)'; let stateDot = '#64748b';
                                        let estadoLabel = 'Nuevo';

                                        if (estado === 'EN_PROGRESO') {
                                            stateBg = 'rgba(2, 132, 199, 0.1)'; stateColor = 'rgb(12, 74, 110)'; stateBorder = 'rgba(2, 132, 199, 0.2)'; stateDot = '#0284c7'; estadoLabel = 'En Progreso';
                                        } else if (estado === 'EN_ESPERA_TERCEROS') {
                                            stateBg = 'rgba(245, 158, 11, 0.1)'; stateColor = 'rgb(146, 64, 14)'; stateBorder = 'rgba(245, 158, 11, 0.2)'; stateDot = '#f59e0b'; estadoLabel = 'En Espera';
                                        } else if (estado === 'CERRADO') {
                                            stateBg = 'rgba(34, 197, 94, 0.1)'; stateColor = 'rgb(20, 83, 45)'; stateBorder = 'rgba(34, 197, 94, 0.2)'; stateDot = '#22c55e'; estadoLabel = 'Cerrado';
                                        }

                                        let opAsignado = ticket.asignado_a ? ticket.asignado_a.nombre : null;
                                        let opId = ticket.asignado_a_id || '';
                                        let isAssigned = Boolean(opId) || estado === 'EN_PROGRESO' || estado === 'CERRADO' || estado === 'EN_ESPERA_TERCEROS';
                                        let area = ticket.area_designada || 'GENERAL';
                                        let ticketCreatedAtTime = ticket.createdAt ? new Date(ticket.createdAt).getTime() : 0;
                                        let ticketAttendedAtTime = ticket.fecha_asignacion ? new Date(ticket.fecha_asignacion).getTime() : Date.now();
                                        let ticketElapsedMinutes = ticketCreatedAtTime ? Math.max(0, Math.floor((ticketAttendedAtTime - ticketCreatedAtTime) / 60000)) : 0;
                                        let ticketElapsedLabel = ticketElapsedMinutes >= 1440
                                            ? Math.floor(ticketElapsedMinutes / 1440) + (Math.floor(ticketElapsedMinutes / 1440) === 1 ? ' día' : ' días')
                                            : ticketElapsedMinutes >= 120
                                                ? Math.floor(ticketElapsedMinutes / 60) + ' h'
                                                : ticketElapsedMinutes + ' min';
                                        let ticketSender = ticket.remitente || (ticket.creado_por
                                            ? `${ticket.creado_por.nombre} <${ticket.creado_por.email}>`
                                            : '');
                                        let safeSubject = (ticket.asunto || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                                        let safeOperator = (opAsignado || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                                    %>
                                    <tr id="row-<%= ticket.codigo_incidencia %>" class="ticket-row hover:bg-[#F9F9FA] group transition-colors" data-area="<%= area %>" data-priority="<%= prio %>" data-assigned="<%= isAssigned %>" data-date="<%= ticketCreatedAtTime %>" data-subject="<%= safeSubject %>" data-detail-subject="<%= ticket.asunto || '' %>" data-description="<%= ticket.descripcion || '' %>" data-origin="<%= ticket.origen_ingesta %>" data-sender="<%= ticketSender %>" data-created-at="<%= ticket.createdAt ? new Date(ticket.createdAt).toISOString() : '' %>" data-attended-at="<%= ticket.fecha_asignacion ? new Date(ticket.fecha_asignacion).toISOString() : '' %>" data-operator-id="<%= opId %>" data-operator-name="<%= safeOperator %>">
                                        <td class="py-2 px-3 align-middle text-center w-[40px]">
                                            <div class="flex items-center justify-center">
                                                <input type="checkbox" data-code="<%= ticket.codigo_incidencia %>" data-assigned="<%= isAssigned %>" <%= isAssigned ? 'disabled title="Ticket ya en asignación"' : '' %> class="row-checkbox w-3.5 h-3.5 rounded text-[#007AFF] border-[#D1D1D6] focus:ring-0 focus:outline-none <%= isAssigned ? 'opacity-30 cursor-not-allowed pointer-events-none bg-[#E5E5EA]' : 'cursor-pointer' %>">
                                            </div>
                                        </td>
                                        <td class="py-2 px-3 align-middle whitespace-nowrap">
                                            <div class="flex items-center gap-1.5">
                                                <svg class="w-3.5 h-3.5 text-[#8E8E93] flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                                                <button type="button" class="font-mono font-medium text-[#1C1C1E] hover:underline cursor-pointer" onclick="openTicketDetailsForCode('<%= ticket.codigo_incidencia %>')"><%= ticket.codigo_incidencia %></button>
                                            </div>
                                        </td>
                                        <td class="py-2 px-2.5 align-middle whitespace-nowrap">
                                            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-[4px] text-[10px] font-mono font-medium border" style="background-color: <%= prioBg %>; color: <%= prioTxt %>; border-color: <%= prioBorder %>;" title="<%= prio === 'NONE' ? 'Sin Prioridad (S/P)' : ('Prioridad ' + prioLabel) %>">
                                                <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= prioDot %>;"></span>
                                                <%= prioLabel %>
                                            </span>
                                        </td>
                                        <td class="state-col py-2 px-2.5 align-middle whitespace-nowrap">
                                            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[4px] text-[11px] font-medium" style="background-color: <%= stateBg %>; color: <%= stateColor %>; border: 1px solid <%= stateBorder %>;">
                                                <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= stateDot %>;"></span>
                                                <span class="status-text"><%= estadoLabel %></span>
                                            </span>
                                        </td>
                                        <td class="py-2 px-3 align-middle truncate font-normal text-[#1C1C1E]" title="<%= ticket.asunto %>"><%= ticket.asunto %></td>
                                        <td class="op-col py-2 px-2.5 align-middle whitespace-nowrap text-[#1C1C1E] font-medium text-[11px]">
                                            <span class="operator-label <%= !opAsignado ? 'italic text-[#8E8E93]' : 'font-semibold text-[#007AFF]' %>"><%= opAsignado || '— Sin asignar' %></span>
                                        </td>
                                        <td class="time-col py-2 px-2.5 align-middle text-center">
                                            <span data-ticket-elapsed class="inline-block font-sans text-[12px] font-semibold tabular-nums text-[#1C1C1E] bg-[#F2F2F7] border border-[#E5E5EA] px-2 py-0.5 rounded-[4px]" title="Tiempo transcurrido desde la creación hasta la asignación"><%= ticketElapsedLabel %></span>
                                        </td>
                                        <td class="action-col py-2 px-3 align-middle text-right">
                                            <button type="button" onclick="handleTicketAction('<%= ticket.codigo_incidencia %>', '<%= safeSubject %>', '<%= area %>', '<%= opId %>', '<%= safeOperator %>', '<%= prio %>')" class="bg-white hover:bg-[#F2F2F7] active:bg-[#E5E5EA] border border-[#D1D1D6] text-[#1C1C1E] text-[11px] font-medium px-2.5 py-1 rounded-[6px] shadow-xs transition cursor-pointer">
                                                <%= isAssigned ? 'Desasignar' : 'Asignar' %>
                                            </button>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
