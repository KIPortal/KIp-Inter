                                    <div role="listbox" aria-labelledby="newTicketOriginLabel" class="absolute left-0 top-[42px] w-full bg-white rounded-[10px] border border-[#D1D1D6] shadow-[0_10px_25px_rgba(0,0,0,0.12)] p-1 z-50 space-y-0.5 text-[12px]">
