        <div id="newTicketOverlay"
            class="fixed inset-0 bg-black/35 backdrop-blur-[3px] z-[70] items-center justify-center p-4 hidden"
            onclick="handleNewTicketBackdrop(event)">
            <section role="dialog" aria-modal="true" aria-labelledby="newTicketTitle"
                class="w-[580px] max-w-[calc(100vw-2rem)] max-h-[calc(100vh-2rem)] bg-white rounded-[22px] border border-[#E5E5EA] shadow-[0_24px_60px_rgba(0,0,0,0.18)] flex flex-col overflow-hidden">
