# Copia este archivo como .env (en esta misma carpeta portal-KIp/) y llena tus valores.
# El .env real NUNCA se sube a git (está en .gitignore).

# --- Base de datos (Supabase / PostgreSQL), la usa Prisma ---
# Conexión por el pooler en modo transacción (la usa la app)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa en modo sesión (la usan las migraciones)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Servidor ---
PORT=3000
# development | production. En production es obligatorio SESSION_SECRET.
NODE_ENV=development
# Cadena larga y aleatoria para firmar la sesión
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# --- Ingesta de correos con Microsoft Graph (opcional; ver docs/GRAPH_API_SETUP.md) ---
# Modo: "aplicacion" (secreto de la app, lo da TI) o "delegado" (prueba: inicias sesión una vez
# con node scripts/graph-login.js; no lleva secreto y GRAPH_TENANT_ID puede quedar en "common").
GRAPH_MODO="aplicacion"
# "si": solo lee correos (permiso Mail.Read); no los marca como leídos ni envía respuestas.
GRAPH_SOLO_LECTURA="no"
GRAPH_TENANT_ID="tu-tenant-id"
GRAPH_CLIENT_ID="tu-client-id"
GRAPH_CLIENT_SECRET="tu-secret-value"
GRAPH_NOC_MAILBOX="buzon@empresa.com"
GRAPH_TARGET_FOLDER="inbox"
# Cada cuántos segundos se revisa el buzón (mínimo 10)
GRAPH_INTERVALO_SEGUNDOS="30"
