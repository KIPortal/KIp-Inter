# Dependencias
node_modules/
*/node_modules/

# Variables de entorno y credenciales sensibles
.env
.env.*
!.env.example
*.env

# Archivos de configuración local y agentes con API keys
.agents/
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Archivos del sistema
.DS_Store
Thumbs.db

# Cache local
stitch_cache/

# Uploads de prueba (no versionar)
public/uploads/*
